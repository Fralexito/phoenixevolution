---
// «Social»: la portada social de la comunidad (historias · publicar · feed de todos). Es una sección de la zona principal, casi un segundo inicio.
// Los datos salen de las mismas publicaciones del muro que ya alimentan /comunidad/ (que se mantiene intacta). Lógica en js/pages/social.js.
// 19-oct-2026 (Fralex: «clona el apartado inicial de Reddit»): distribución de foro en TRES columnas, con la identidad de Phoenix (no la de Reddit):
//   izquierda = feeds (Inicio · Destacado · Siguiendo), juegos y accesos · centro = historias, publicar, orden y feed en hilo · derecha = la comunidad.
// Las reacciones y las historias siguen como estaban (decisión de Fralex). En celular queda una sola columna, como antes.
import Layout from '../layouts/Layout.astro';
// CSS propio de esta página (no va en global.css). DESPUÉS de Layout: así gana a global.css.
import '../styles/socialHilo.css';
import '../styles/publicar.css';   // la ventana «Crear publicación» (features/muro/compositor.js)
import Plegable from '../components/Plegable.astro';
const base = import.meta.env.BASE_URL;
const enlaces = [['comunidad/', 'fa-users', 'Comunidad'], ['amigos/', 'fa-user-group', 'Amigos'], ['mensajes/', 'fa-comments', 'Mensajes'], ['guardados/', 'fa-bookmark', 'Guardados'], ['buscar/', 'fa-magnifying-glass', 'Buscar']];
---
<Layout title="Social" active="social" description="Lo que publican los jugadores de Phoenix Evolution Series: historias, fotos, videos y resultados de toda la comunidad.">
  <div class="sxr w-full">
    <h1 class="sr-only">Social</h1>
    <aside class="sxr-izq" aria-label="Navegación de Social">
      <nav class="sxr-nav">
        <div data-sxr-feeds></div>
        <details class="sxr-grupo" open><summary>Juegos</summary><div data-sxr-juegos></div></details>
        <details class="sxr-grupo" open><summary>Tu espacio</summary>
          <div>{enlaces.map(([ruta, icono, texto]) => <a class="sxr-item" href={`${base}${ruta}`}><span class="sxr-ic"><i class={`fa-solid ${icono}`} aria-hidden="true"></i></span><span>{texto}</span></a>)}</div>
        </details>
      </nav>
    </aside>

    <div class="sxr-centro">
      <section id="sx-hist" hidden aria-label="Historias" class="sxr-hist"></section>
      <section id="sx-compositor" aria-label="Publicar"></section>
      <div class="sxr-orden">
        <p class="sxr-titulo" data-sxr-titulo></p>
        <div id="sx-vistas" role="tablist" aria-label="Qué ver en el feed" class="sxr-vistas"></div>
        <div class="sxr-ordenar" role="group" aria-label="Ordenar lo que ves" data-sxr-ordenes></div>
        <div class="sxr-vista" role="group" aria-label="Cómo ver las publicaciones">
          <button type="button" data-sxr-modo="tarjeta" aria-pressed="true" title="Tarjetas" aria-label="Ver en tarjetas"><i class="fa-solid fa-table-cells-large" aria-hidden="true"></i></button>
          <button type="button" data-sxr-modo="compacta" aria-pressed="false" title="Compacta" aria-label="Ver compacta"><i class="fa-solid fa-list" aria-hidden="true"></i></button>
        </div>
      </div>
      <div class="sxr-filtro-movil">
        <Plegable titulo="Filtrar por juego" icono="fa-tag" resumen="Solo en «Recientes»" id="sx-filtro-wrap">
          <div id="sx-filtro" class="flex flex-wrap items-center gap-1.5 text-[12px]" role="group" aria-label="Filtrar por juego"></div>
        </Plegable>
      </div>
      <button type="button" class="sxr-nuevas" data-sxr-nuevas hidden><i class="fa-solid fa-arrow-up" aria-hidden="true"></i> <span></span></button>
      <div id="sx-feed" class="sxr-feed" data-modo="tarjeta" aria-live="polite"></div>
      <div id="sx-fin" hidden class="py-3 text-center"><button type="button" id="sx-mas" class="btn btn-ghost !text-xs">Cargar más</button></div>
    </div>

    <aside class="sxr-der" aria-label="Sobre la comunidad">
      <section class="sxr-caja sxr-sobre">
        <div class="sxr-sobre-cab"><span class="sxr-sobre-logo" aria-hidden="true"><i class="fa-solid fa-fire"></i></span><div><h2>Phoenix Social</h2><p>La comunidad de Phoenix Evolution Series</p></div></div>
        <p class="sxr-sobre-tx">Fotos, videos, resultados y debates de los jugadores de la liga. Publica lo tuyo, reacciona y sigue a quien quieras.</p>
        <div class="sxr-cifras" data-sxr-cifras></div>
        <button type="button" class="sxr-crear" data-sxr-crear><i class="fa-solid fa-plus" aria-hidden="true"></i> Crear publicación</button>
      </section>
      <section class="sxr-caja"><h2 class="sxr-caja-t">Juegos con más movimiento</h2><div data-sxr-activos></div></section>
      <section class="sxr-caja" data-sxr-seguir-caja hidden><h2 class="sxr-caja-t">A quién seguir</h2><div data-sxr-seguir></div></section>
      <section class="sxr-caja"><h2 class="sxr-caja-t">Lo más reaccionado</h2><div data-sxr-top></div></section>
      <section class="sxr-caja sxr-atajos"><h2 class="sxr-caja-t">Atajos de teclado</h2>
        <ul><li><kbd>J</kbd> <kbd>K</kbd><span>Siguiente / anterior publicación</span></li><li><kbd>R</kbd><span>Reaccionar a la elegida</span></li><li><kbd>C</kbd><span>Abrir sus respuestas</span></li><li><kbd>N</kbd><span>Crear publicación</span></li></ul>
      </section>
    </aside>
  </div>
  <button type="button" class="sxr-arriba" data-sxr-arriba hidden aria-label="Volver arriba"><i class="fa-solid fa-arrow-up" aria-hidden="true"></i></button>
</Layout>
<script>
  import '../js/pages/social.js';
</script>

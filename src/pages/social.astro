---
// «Social»: la portada social de la comunidad (historias · publicar · feed de todos). Es una sección de la zona principal, casi un segundo inicio.
// Los datos salen de las mismas publicaciones del muro que ya alimentan /comunidad/ (que se mantiene intacta). Lógica en js/pages/social.js.
// 19-oct-2026 (Fralex: «clona el apartado inicial de Reddit»): distribución de foro en TRES columnas, con la identidad de Phoenix (no la de Reddit):
//   izquierda = feeds (Recientes · Siguiendo · Destacado), juegos y accesos · centro = historias, publicar, orden y feed en hilo · derecha = la comunidad.
// Las reacciones y las historias siguen como estaban (decisión de Fralex). En celular queda una sola columna, como antes.
import Layout from '../layouts/Layout.astro';
// CSS propio de esta página (no va en global.css). DESPUÉS de Layout: así gana a global.css.
import '../styles/socialHilo.css';
import '../styles/deslizar.css';
import '../styles/stickers.css';   // stickers en los comentarios (migración 137)
import '../styles/publicar.css';   // la ventana «Crear publicación» (features/muro/compositor.js)
const base = import.meta.env.BASE_URL;
// «Tu espacio» (auditoría 19-oct): sin repetir lo que ya está en el menú de cuenta (Amigos, Mensajes…); solo se muestra con sesión.
const enlaces = [['perfil/', 'fa-user', 'Mi muro'], ['guardados/', 'fa-bookmark', 'Guardados'], ['buscar/', 'fa-magnifying-glass', 'Buscar jugadores']];
---
<Layout title="Social" active="social" description="Lo que publican los jugadores de Phoenix Evolution Series: historias, fotos, videos y resultados de toda la comunidad.">
  <script is:inline>addEventListener('pagereveal', (e) => { try { const d = sessionStorage.getItem('px-desliza'); sessionStorage.removeItem('px-desliza'); if (d && e.viewTransition) e.viewTransition.types.add('desliza-' + d); } catch {} });</script>
  <div class="sxr w-full">
    <h1 class="sr-only">Social</h1>
    <aside class="sxr-izq" aria-label="Navegación de Social">
      <nav class="sxr-nav">
        <div data-sxr-feeds></div>
        <details class="sxr-grupo" open><summary>Juegos</summary><div data-sxr-juegos></div></details>
        <details class="sxr-grupo" open data-sxr-espacio hidden><summary>Tu espacio</summary>
          <div>{enlaces.map(([ruta, icono, texto]) => <a class="sxr-item" href={`${base}${ruta}`}><span class="sxr-ic"><i class={`fa-solid ${icono}`} aria-hidden="true"></i></span><span>{texto}</span></a>)}</div>
        </details>
      </nav>
    </aside>

    <div class="sxr-centro">
      <header class="sxr-saludo" data-sxr-saludo hidden></header>
      <section id="sx-hist" hidden aria-label="Historias" class="sxr-hist"></section>
      <section id="sx-compositor" aria-label="Crear publicación"></section>
      <!-- 19-oct-2026 (Fralex: «que el muro no se vea tan cargado… minimalista pero completo»): UNA barra pegada arriba —
           pestañas con pastilla que se desliza + un botón «Ordenar y filtrar» que abre orden, juego y vista (antes eran tres filas). -->
      <div class="sxr-orden">
        <p class="sxr-titulo" data-sxr-titulo></p>
        <div id="sx-vistas" role="tablist" aria-label="Qué ver en el feed" class="sxr-vistas"></div>
        <button type="button" class="sxr-recargar" data-sxr-recargar aria-label="Recargar las publicaciones" title="Recargar"><i class="fa-solid fa-rotate-right" aria-hidden="true"></i></button>
        <a class="sxr-reels" href={`${base}jugadas/`} data-sxr-reels title="Jugadas: videos en vertical (o desliza a la izquierda)" aria-label="Jugadas: videos de la comunidad en vertical"><i class="fa-solid fa-clapperboard" aria-hidden="true"></i><span>Jugadas</span></a>
        <div class="sxr-filtros">
          <button type="button" class="sxr-filtros-btn" data-sxr-filtros aria-expanded="false" aria-controls="sx-pop" aria-label="Ordenar y filtrar" title="Ordenar y filtrar"><i class="fa-solid fa-sliders" aria-hidden="true"></i><span class="sxr-filtros-punto" data-sxr-punto hidden></span></button>
          <div id="sx-pop" class="sxr-pop" hidden>
            <p class="sxr-pop-t">Ordenar</p>
            <div class="sxr-ordenar" role="group" aria-label="Ordenar lo que ves" data-sxr-ordenes></div>
            <div id="sx-filtro-wrap" class="sxr-pop-juego"><p class="sxr-pop-t">Juego</p><div id="sx-filtro" class="sxr-chips" role="group" aria-label="Filtrar por juego"></div></div>
            <p class="sxr-pop-t">Vista</p>
            <div class="sxr-vista" role="group" aria-label="Cómo ver las publicaciones">
              <button type="button" data-sxr-modo="tarjeta" aria-pressed="true"><i class="fa-solid fa-table-cells-large" aria-hidden="true"></i><span>Amplia</span></button>
              <button type="button" data-sxr-modo="compacta" aria-pressed="false"><i class="fa-solid fa-list" aria-hidden="true"></i><span>Compacta</span></button>
            </div>
          </div>
        </div>
      </div>
      <button type="button" class="sxr-nuevas" data-sxr-nuevas hidden><i class="fa-solid fa-arrow-up" aria-hidden="true"></i> <span></span></button>
      <div id="sx-feed" class="sxr-feed" data-modo="tarjeta"></div>
      <div id="sx-fin" hidden class="py-3 text-center"><button type="button" id="sx-mas" class="btn btn-ghost !text-xs">Cargar más</button></div>
    </div>

    <aside class="sxr-der" aria-label="Sobre la comunidad">
      <section class="sxr-caja sxr-sobre">
        <div class="sxr-sobre-cab"><span class="sxr-sobre-logo" aria-hidden="true"><img src={`${base}logo.webp`} alt="" width="44" height="44" loading="lazy" decoding="async" /></span><div><h2>Phoenix Social</h2><p>La comunidad de Phoenix Evolution Series</p></div></div>
        <p class="sxr-sobre-tx">Fotos, videos, resultados y debates de los jugadores de la liga. Publica lo tuyo, reacciona y sigue a quien quieras.</p>
      </section>
      <section class="sxr-caja" data-sxr-tend hidden><h2 class="sxr-caja-t"><i class="fa-solid fa-arrow-trend-up" aria-hidden="true"></i> Tendencias</h2><div data-sxr-tend-lista></div></section>
      <section class="sxr-caja" data-sxr-seguir-caja hidden><h2 class="sxr-caja-t">A quién seguir</h2><div data-sxr-seguir></div></section>
      <section class="sxr-caja"><h2 class="sxr-caja-t">Lo más reaccionado</h2><div data-sxr-top></div></section>
      <details class="sxr-caja sxr-atajos"><summary class="sxr-caja-t">Atajos de teclado</summary>
        <ul><li><kbd>J</kbd> <kbd>K</kbd><span>Siguiente / anterior publicación</span></li><li><kbd>R</kbd><span>Reaccionar a la elegida</span></li><li><kbd>C</kbd><span>Abrir sus respuestas</span></li><li><kbd>N</kbd><span>Crear publicación</span></li></ul>
      </details>
    </aside>
  </div>
  <button type="button" class="sxr-arriba" data-sxr-arriba hidden aria-label="Subir y recargar las publicaciones" title="Subir y recargar"><i class="fa-solid fa-arrow-up" aria-hidden="true"></i><i class="fa-solid fa-rotate-right sxr-arriba-giro" aria-hidden="true"></i></button>
</Layout>
<script>
  import '../js/pages/social.js';
</script>

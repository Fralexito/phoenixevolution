---
import Layout from '../layouts/Layout.astro';
// CSS propio de esta página (antes iba en global.css para todas; 19-oct-2026). DESPUÉS de Layout: así gana a global.css como antes.
import '../styles/noticiasV2.css';
import { FX } from '../data/experimento.js';
// Precarga de la letra del titular de El Fénix (Anton): si llega tarde, el titular cambia de tamaño y la página salta (medido 19-oct-2026).
import fAnton from '@fontsource/anton/files/anton-latin-400-normal.woff2?url';
import '@fontsource/anton/400.css';
import '@fontsource/oswald/500.css';
import '@fontsource/oswald/700.css';
import '@fontsource/permanent-marker/400.css';
import '@fontsource/press-start-2p/400.css';
const cats = [['TODOS', 'Todos'], ['OFICIAL', 'Oficial'], ['JORNADA', 'Jornadas'], ['TRIBUNAL', 'Tribunal'], ['TRIBUNA', '😂 Tribuna']];
import 'gridstack/dist/gridstack.min.css';
---
<Layout title="Noticias" active="noticias" description="Noticias y comunicados de Phoenix Evolution Series.">
  <!-- NOTICIAS v2 (ronda 351, FX.noticiasV2): El Fénix arriba + zona seria abajo + lector de página completa. -->
  <!-- 19-oct-2026: la vista sale ya elegida desde el servidor (antes se mostraba con JS después de pintar y la página «saltaba», CLS 0,14).
       ?clasica=1 (staff) se decide con un guion en línea ANTES de pintar: marca <html data-nv-clasica> y el CSS oculta la nueva. -->
  <script is:inline>if (/[?&]clasica(=|&|$)/.test(location.search)) document.documentElement.setAttribute('data-nv-clasica', '');</script>
<style is:global>
  /* ?clasica=1: la vista nueva no llega a pintarse (el guion en línea marca <html> antes de que se vea). */
  html[data-nv-clasica] #nv-root { display: none; }
</style>
  <link rel="preload" as="font" type="font/woff2" href={fAnton} crossorigin />
  <div id="nv-root" hidden={!FX.noticiasV2} class="nv w-full">
    <div id="nv-portada">
      <div class="nv-ancho">
        <header class="nv-cab">
          <div class="nv-cab-tit"><span>Phoenix Evolution Series</span><h1>Noticias</h1></div>
          <div class="nv-cab-acc">
            <div id="nv-ligas" class="nv-ligas" role="group" aria-label="Liga"></div>
            <button type="button" id="nv-buscar-btn" class="nv-icono" aria-label="Buscar noticias"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg></button>
            <a id="nv-clasica" hidden href="?clasica=1" class="nv-staff">Vista clásica · acomodar</a>
            <button type="button" id="nv-nueva" hidden class="btn btn-primary">+ Nueva noticia</button>
          </div>
        </header>
        <div id="nv-buscar" hidden class="nv-buscar"><label for="nv-buscar-in" class="sr-only">Buscar noticias</label><input id="nv-buscar-in" type="search" placeholder="Busca por jugador, fecha o tema…" class="field" /></div>
      </div>
      <section id="nv-fenix" aria-label="El Fénix, la portada de la semana"></section>
      <div class="nv-ancho"><div id="nv-seria" class="nv-seria" aria-live="polite"></div></div>
    </div>
    <div id="nv-lector" hidden class="nv-ancho"></div>
  </div>

  <!-- Vista CLÁSICA (antes de la ronda 351): queda guardada. El staff la abre con ?clasica=1 para «Acomodar» y el catálogo de diseños. -->
  <div id="news-root" hidden={FX.noticiasV2} class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full space-y-8">
    <header class="glass-panel px-4 py-3 rounded-2xl flex flex-col md:flex-row justify-between items-start md:items-end gap-4">
      <div>
        <span class="text-xs font-display font-bold text-galaxy-400 uppercase tracking-widest bg-galaxy-600/20 px-2 py-0.5 rounded border border-galaxy-400/30 inline-block">Cobertura oficial</span>
        <h1 class="text-xl sm:text-2xl font-display font-extrabold text-white uppercase tracking-wider text-shadow-glow mt-1"><i class="fa-solid fa-newspaper text-galaxy-400 mr-2"></i>Noticias y comunicados</h1>
        <p class="text-gray-300 text-xs mt-0.5">Mantente al tanto de las reglas, parches, mercado y crónicas de los partidos de la Galaxy League.</p>
      </div>
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 w-full md:w-auto">
        <div class="relative w-full sm:w-56">
          <input id="news-search" type="search" placeholder="Buscar en comunicados..." aria-label="Buscar en comunicados" class="field !pl-8" />
          <i class="fa-solid fa-search absolute left-3 top-3 text-gray-500 text-xs"></i>
        </div>
        <div id="news-filters" class="flex flex-wrap gap-1.5 text-xs font-display font-bold uppercase tracking-wider bg-black/40 p-1 rounded-lg border border-galaxy-border/60">
          {cats.map(([k, l], i) => (<button type="button" data-cat={k} aria-pressed={String(i === 0)} class="toggle-btn px-3 py-1.5 rounded text-gray-400 hover:text-white transition-colors">{l}</button>))}
        </div>
      </div>
    </header>
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div id="news-ligas" hidden class="flex flex-wrap gap-1.5 text-xs font-display font-bold uppercase tracking-wider bg-black/40 p-1 rounded-lg border border-galaxy-border/60"></div>
      <button type="button" id="news-acomodar" hidden class="btn btn-ghost ml-auto" title="Agarra y suelta las noticias para ordenarlas"><i class="fa-solid fa-up-down-left-right"></i> Acomodar</button>
      <span id="news-acomodar-barra" hidden class="ml-auto flex gap-2"><span class="text-xs text-gray-400 self-center">Arrastra a cualquier lugar · estira desde bordes y esquinas</span><button type="button" id="news-acomodar-ok" class="btn btn-primary"><i class="fa-solid fa-check"></i> Guardar orden</button><button type="button" id="news-acomodar-no" class="btn btn-ghost">Cancelar</button></span>
      <button type="button" id="news-disenos" hidden class="btn btn-ghost"><i class="fa-solid fa-palette"></i> Catálogo de diseños</button>
      <button type="button" id="news-nueva" hidden class="btn btn-primary"><i class="fa-solid fa-plus"></i> Nueva noticia</button>
    </div>
    <div id="news-featured"></div>
    <div class="nt-zona-acomodo"><div id="news-grid"></div><aside id="news-asistente" class="nt-asistente" hidden aria-label="Asistente de acomodo"></aside></div>
  </div>
</Layout>
<script>
  import { FX } from '../data/experimento.js';
  // Una sola vista por visita: la nueva (por defecto) o la clásica con ?clasica=1. Si la nueva falla al cargar, cae a la clásica.
  const clasica = !FX.noticiasV2 || new URLSearchParams(location.search).has('clasica');
  const mostrar = (id) => { const el = document.getElementById(id); if (el) el.hidden = false; };
  if (clasica) { document.getElementById('nv-root').hidden = true; mostrar('news-root'); import('../js/pages/noticias.js'); }
  else {
    import('../js/pages/noticiasV2.js').catch((e) => {
      console.error('[noticias] la vista nueva falló, se muestra la clásica:', e);
      document.getElementById('nv-root').hidden = true; mostrar('news-root'); import('../js/pages/noticias.js');
    });
  }
</script>

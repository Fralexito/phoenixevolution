---
import Layout from '../layouts/Layout.astro';
const cats = [['TODOS', 'Todos'], ['OFICIAL', 'Oficial'], ['JORNADA', 'Jornadas'], ['TRIBUNAL', 'Tribunal']];
---
<Layout title="Noticias" active="noticias">
  <div id="news-root" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full space-y-8">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end border-b border-galaxy-line pb-6 gap-6">
      <div>
        <span class="text-xs font-display font-bold text-galaxy-400 uppercase tracking-widest bg-galaxy-600/20 px-2.5 py-1 rounded border border-galaxy-400/30 inline-block mb-2">COBERTURA OFICIAL</span>
        <h1 class="text-3xl font-display font-bold text-white uppercase tracking-widest text-shadow-glow">NOTICIAS Y COMUNICADOS</h1>
        <p class="text-gray-400 text-sm mt-1">Mantente al tanto de las reglas, parches, mercado y crónicas de los partidos de la Galaxy League.</p>
      </div>
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 w-full md:w-auto">
        <div class="relative w-full sm:w-56">
          <input id="news-search" type="search" placeholder="Buscar en comunicados..." aria-label="Buscar en comunicados" class="field !pl-8" />
          <i class="fa-solid fa-search absolute left-3 top-3 text-gray-500 text-xs"></i>
        </div>
        <div id="news-filters" class="flex flex-wrap gap-1.5 text-xs font-display font-bold uppercase tracking-wider bg-black/40 p-1 rounded-lg border border-galaxy-border/60">
          {cats.map(([k, l], i) => (<button type="button" data-cat={k} aria-pressed={String(i === 0)} class="toggle-btn px-3 py-1.5 rounded text-gray-400 hover:text-white transition-colors">{l}</button>))}
        </div>
      </div>
    </div>
    <div id="news-featured"></div>
    <div id="news-grid" class="grid grid-cols-1 md:grid-cols-3 gap-6"></div>
  </div>
</Layout>
<script>
  import '../js/pages/noticias.js';
</script>

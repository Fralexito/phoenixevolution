---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Buscar" active="buscar">
  <div class="max-w-2xl mx-auto px-4 sm:px-8 py-4 sm:py-6 w-full space-y-4">
    <header class="glass-panel px-4 py-3 rounded-2xl">
      <span class="text-[10px] font-display font-bold text-galaxy-400 uppercase tracking-widest bg-galaxy-600/20 px-2 py-0.5 rounded border border-galaxy-400/30">Comunidad</span>
      <h1 class="text-xl sm:text-2xl font-display font-extrabold text-white uppercase tracking-wider text-shadow-glow mt-1"><i class="fa-solid fa-magnifying-glass text-galaxy-400 mr-2"></i>Buscar</h1>
      <p class="text-gray-300 text-xs mt-0.5">Encuentra jugadores por su nombre o @usuario, o publicaciones por lo que dicen. Lo oculto, bloqueado o privado nunca aparece.</p>
    </header>
    <div id="bu-sinsesion" hidden class="glass-panel rounded-2xl p-8 text-center text-gray-400 text-sm">Inicia sesión para buscar en la comunidad.</div>
    <div id="bu-app" hidden class="space-y-3">
      <div class="relative">
        <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-500 pointer-events-none"></i>
        <input id="bu-q" type="search" inputmode="search" autocomplete="off" maxlength="80" class="field w-full !pl-10" placeholder="Nombre, @usuario o palabras de una publicación" aria-label="Buscar en la comunidad">
      </div>
      <div id="bu-tabs" class="flex gap-1.5" role="group" aria-label="Qué buscar"></div>
      <p id="bu-aviso" hidden role="alert" class="rounded-xl border border-rose-400/40 bg-rose-500/10 px-4 py-2.5 text-xs text-rose-200"></p>
      <section id="bu-res" class="space-y-3" aria-live="polite"></section>
      <div class="text-center"><button type="button" id="bu-mas" hidden class="btn btn-ghost">Cargar más</button></div>
    </div>
  </div>
</Layout>
<script>
  import '../js/pages/buscar.js';
</script>

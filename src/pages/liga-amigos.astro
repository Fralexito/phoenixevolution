---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---
<Layout title="Liga oficial" active="ligaamigos" description="Liga oficial de Phoenix Evolution Series: los resultados los sube Phoenix Link solo.">
  <div class="max-w-6xl mx-auto px-4 sm:px-8 py-4 sm:py-6 w-full space-y-6">
    <header class="glass-panel px-4 py-3 rounded-2xl flex flex-wrap items-center justify-between gap-3">
      <div class="min-w-0">
        <span class="text-[12px] font-display font-bold text-galaxy-400 uppercase tracking-widest bg-galaxy-600/20 px-2 py-0.5 rounded border border-galaxy-400/30">Liga oficial</span>
        <h1 class="text-xl sm:text-2xl font-display font-extrabold text-white uppercase tracking-wider text-shadow-glow mt-1"><i class="fa-solid fa-people-group text-galaxy-400 mr-2"></i>Liga oficial</h1>
        <p class="text-gray-300 text-xs mt-0.5">Te inscribes con tu cuenta, juegas por Parsec en la sala del anfitrión y Phoenix Link manda el resultado solo. El staff lo valida y la tabla se actualiza.</p>
      </div>
      <a href={`${base}unirme/`} class="btn !min-h-10"><i class="fa-solid fa-circle-question"></i> Cómo jugar</a>
    </header>

    <!-- Solo staff (editarLiga): crear una liga nueva en inscripción. -->
    <section id="la-crear" hidden class="glass-panel rounded-2xl p-4 space-y-3">
      <h2 class="text-base font-display font-bold text-white uppercase tracking-wider"><i class="fa-solid fa-circle-plus text-galaxy-400 mr-2"></i>Crear una liga</h2>
      <form class="flex flex-wrap items-end gap-3">
        <label class="flex-1 min-w-[14rem]"><span class="label">Nombre</span><input name="nombre" class="field" required minlength="3" maxlength="60" placeholder="Liga de los jueves"></label>
        <label class="flex items-center gap-2 text-sm text-gray-300 min-h-10"><input type="checkbox" name="idaVuelta"> Ida y vuelta</label>
        <button type="submit" class="btn btn-primary !min-h-10">Crear y abrir inscripción</button>
      </form>
    </section>

    <div id="la-ligas" class="space-y-6"><div class="text-center py-8 text-gray-400 text-xs">Cargando...</div></div>
  </div>
</Layout>
<script>
  import '../js/pages/ligaAmigos.js';
</script>

---
// Página «Organizadores»: propósito, motivación, visión, historia e impulsores. El contenido sale de data/organizadores.js.
import Layout from '../layouts/Layout.astro';
import { ORG } from '../data/organizadores.js';
import { SOCIALS } from '../data/site.js';
const base = import.meta.env.BASE_URL;
const discord = SOCIALS.find((s) => s.label === 'Discord');
const pilares = [['fa-bullseye', 'Propósito', ORG.proposito], ['fa-fire', 'Motivación', ORG.motivacion], ['fa-binoculars', 'Visión', ORG.vision]].filter((x) => x[2]);
const inicial = (n) => String(n ?? '?').trim().charAt(0).toUpperCase() || '?';
---
<Layout title="Organizadores" active="organizadores">
  <header class="relative overflow-hidden border-b border-galaxy-border/40">
    <div class="absolute inset-0 bg-gradient-to-b from-galaxy-900/70 to-transparent"></div>
    <div class="relative z-10 max-w-6xl mx-auto px-5 sm:px-8 py-12 sm:py-20 text-center space-y-4">
      <span class="liga-sello">Phoenix Evolution Series</span>
      <h1 class="text-5xl sm:text-7xl font-display font-extrabold text-white uppercase leading-none text-shadow-glow">{ORG.titulo[0]} <span class="text-transparent bg-clip-text bg-gradient-to-r from-galaxy-400 to-galaxy-600">{ORG.titulo[1]}</span></h1>
      {ORG.lema && <p class="text-base sm:text-xl text-gray-300 font-display tracking-wide max-w-2xl mx-auto">{ORG.lema}</p>}
    </div>
  </header>

  <div class="max-w-6xl mx-auto px-5 sm:px-8 py-10 sm:py-14 space-y-14 pb-20">
    <!-- PROPÓSITO · MOTIVACIÓN · VISIÓN -->
    <section class="grid gap-4 md:grid-cols-3" aria-label="Propósito, motivación y visión">
      {pilares.map(([icono, t, d]) => (
        <article class="glass-panel rounded-2xl p-6 space-y-3">
          <span class="w-11 h-11 rounded-xl grid place-items-center bg-galaxy-600/25 border border-galaxy-400/40 text-galaxy-400"><i class={`fa-solid ${icono}`}></i></span>
          <h2 class="font-display font-bold text-lg text-white uppercase tracking-widest">{t}</h2>
          <p class="text-sm text-gray-300 leading-relaxed">{d}</p>
        </article>
      ))}
    </section>

    <!-- CÓMO SURGIÓ -->
    <section class="grid gap-8 lg:grid-cols-[1.2fr_1fr] items-start" aria-label="Cómo surgió la idea">
      <div class="space-y-4">
        <h2 class="font-display font-bold text-2xl text-white uppercase tracking-widest"><i class="fa-solid fa-seedling text-galaxy-400 mr-3"></i>Cómo surgió la idea</h2>
        {ORG.historia.map((p) => <p class="text-gray-300 leading-relaxed">{p}</p>)}
      </div>
      <ol class="relative border-l border-galaxy-border/70 ml-3 space-y-6" aria-label="Evolución del proyecto">
        {ORG.hitos.map((h, i) => (
          <li class="pl-6 relative">
            <span class="absolute -left-[9px] top-1 w-4 h-4 rounded-full bg-galaxy-dark border-2 border-galaxy-400 shadow-[0_0_10px_rgba(0,229,255,.6)]"></span>
            <b class="block font-display text-white uppercase tracking-wide">{h.t}</b><span class="text-sm text-gray-400">{h.d}</span>
            {i === ORG.hitos.length - 1 && <span class="liga-sello liga-sello-prox ml-2 !text-[.6rem]">hoy</span>}
          </li>
        ))}
      </ol>
    </section>

    <!-- IMPULSORES -->
    <section class="space-y-5" aria-label="Los impulsores">
      <h2 class="font-display font-bold text-2xl text-white uppercase tracking-widest"><i class="fa-solid fa-star text-galaxy-400 mr-3"></i>Los impulsores</h2>
      {ORG.impulsoresIntro && <p class="max-w-3xl text-gray-300 leading-relaxed">{ORG.impulsoresIntro}</p>}
      <div class="grid gap-4 md:grid-cols-3">
        {ORG.impulsores.map((o) => (
          <article class:list={['glass-panel rounded-2xl px-6 py-8 text-center flex flex-col items-center gap-3', o.principal ? 'border-galaxy-400/50 shadow-[0_0_32px_rgba(0,229,255,.16)]' : '']} data-org-nombre={o.nombre}>
            <div class="rounded-full grid place-items-center w-24 h-24 text-4xl font-display font-extrabold text-white bg-gradient-to-br from-galaxy-600 to-galaxy-400 shadow-[0_0_25px_rgba(0,229,255,.35)]" aria-hidden="true">{inicial(o.nombre)}</div>
            <h3 class="font-display font-extrabold text-white uppercase tracking-[.18em] text-2xl mt-1">{o.nombre}</h3>
            <span class="text-[11px] font-display font-bold uppercase tracking-[.28em] text-galaxy-400">{o.rol}</span>
            <span class="block h-px w-10 bg-galaxy-400/50" aria-hidden="true"></span>
            {o.bio && <p class="max-w-xs text-[15px] leading-relaxed font-light text-gray-300">{o.bio}</p>}
            {o.frase && <blockquote class="max-w-xs text-sm text-galaxy-400 italic">“{o.frase}”</blockquote>}
            <div data-org-jugador class="flex flex-wrap gap-2 justify-center pt-1"></div>
          </article>
        ))}
      </div>
    </section>

    <!-- VALORES -->
    <section class="space-y-5" aria-label="Valores">
      <h2 class="font-display font-bold text-2xl text-white uppercase tracking-widest"><i class="fa-solid fa-gem text-galaxy-400 mr-3"></i>Lo que nos mueve</h2>
      <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {ORG.valores.map((v) => <li class="rounded-xl border border-galaxy-border/60 bg-black/25 p-4"><i class={`fa-solid ${v.icono} text-galaxy-400`}></i><b class="block mt-2 font-display text-white uppercase tracking-wider text-sm">{v.t}</b><span class="text-xs text-gray-400 leading-relaxed">{v.d}</span></li>)}
      </ul>
    </section>

    <section class="glass-panel rounded-2xl p-6 sm:p-8 text-center space-y-3">
      <h2 class="font-display font-bold text-xl text-white uppercase tracking-widest">¿Quieres ser parte?</h2>
      <p class="text-sm text-gray-300">Entra a la comunidad, juega la liga y escribe tu propia historia en la plataforma.</p>
      <div class="flex flex-wrap justify-center gap-3">
        {discord && <a href={discord.href} target="_blank" rel="noopener noreferrer" class="hero-cta hero-cta-p"><i class="fa-brands fa-discord"></i> Unirme al Discord</a>}
        <a href={`${base}liga/`} class="hero-cta hero-cta-s"><i class="fa-solid fa-crown"></i> Ver la Liga</a>
      </div>
    </section>
  </div>
</Layout>
<script>
  import '../js/pages/organizadores.js';
</script>

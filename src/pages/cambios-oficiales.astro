---
// CAMBIOS OFICIALES (migración 125): UN SOLO FORMULARIO para cambiar el PES de todos desde la web.
// Cada cambio va a Base normal (amistosos), Liga Máster o Las dos. Contrato: docs/CONTRATO-WEB-PES.md · Lógica: js/pages/cambiosOficiales.js
// Diseño: compositor con vista previa en vivo + historial en línea de tiempo (estilos cfx- en styles/cambiosOficiales.css).
import Layout from '../layouts/Layout.astro';
import { href } from '../js/core/config.js';
---
<Layout title="Cambios oficiales" active="mercado" description="Cambios hechos en la web que llegan al PES de todos.">
  <div class="cfx max-w-6xl mx-auto px-4 sm:px-6 pt-8 pb-24">
    <header class="cfx-cabecera">
      <div>
        <h1 class="cfx-titulo">Cambios oficiales</h1>
        <p class="cfx-sub">Lo que cambies aquí llega al PES de todos los que usan Phoenix Link.</p>
      </div>
      <a class="cfx-enlace" href={href('usuarios-pes/')}>Ver quién lo recibió <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
    </header>

    <p id="cf-sin-permiso" class="sy-aviso" hidden>Solo el staff ve esta página. Inicia sesión con la cuenta de admin.</p>

    <section id="cf-formulario" class="cfx-compositor" aria-label="Nuevo cambio" hidden>
      <form id="cf-form" class="cfx-flujo" autocomplete="off" novalidate>
        <fieldset class="cfx-bloque">
          <legend>Qué cambias</legend>
          <div id="cf-tipos" class="cfx-seg" role="radiogroup" aria-label="Tipo de cambio"></div>
        </fieldset>
        <fieldset class="cfx-bloque">
          <legend>Dónde se aplica</legend>
          <div id="cf-destinos" class="cfx-seg" role="radiogroup" aria-label="Dónde se aplica"></div>
          <p id="cf-destino-ayuda" class="cfx-pista" aria-live="polite"></p>
        </fieldset>
        <fieldset class="cfx-bloque">
          <legend>Datos</legend>
          <div id="cf-campos" class="cfx-campos"></div>
        </fieldset>
        <label class="cf-campo" for="cf-nota"><span>Nota <small>(opcional, solo la ve el staff)</small></span><input id="cf-nota" class="field" maxlength="300" placeholder="Ej.: fichaje real de enero"></label>
        <p id="cf-error" class="sy-aviso" role="alert" hidden></p>
        <div class="cfx-accion"><button type="submit" class="cfx-enviar" id="cf-enviar"><span>Mandar al PES</span><i class="fa-solid fa-paper-plane" aria-hidden="true"></i></button></div>
      </form>

      <aside class="cfx-vista" aria-label="Vista previa del cambio">
        <p class="cfx-vista-t">Así llegará</p>
        <div id="cf-vista" aria-live="polite"></div>
      </aside>
    </section>

    <section id="cf-historial-sec" class="cfx-historial" aria-labelledby="cf-h-hist" hidden>
      <div class="cfx-hist-cab">
        <h2 id="cf-h-hist">Historial</h2>
        <button type="button" id="cf-recargar" class="cfx-fantasma"><i class="fa-solid fa-rotate" aria-hidden="true"></i> Actualizar</button>
      </div>
      <p class="cfx-pista">Cada cambio es un registro. Si fue a «Las dos», verás dos resultados. Los números dicen cuántos PCs lo aplicaron, lo saltaron o esperan.</p>
      <div id="cf-historial" aria-live="polite"><div class="esqueleto h-20"></div></div>
      <button type="button" id="cf-mas" class="cfx-fantasma" hidden>Ver más</button>
      <div id="cf-historial-fichas"></div>
    </section>
  </div>
  <script>import '../js/pages/cambiosOficiales.js';</script>
</Layout>

---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---
<Layout title="Mis partidos" active="partidos">
  <div class="max-w-6xl mx-auto px-4 sm:px-8 py-4 sm:py-6 w-full space-y-4">
    <header class="glass-panel px-4 py-3 rounded-2xl flex flex-wrap items-center justify-between gap-3">
      <div class="min-w-0">
        <span class="text-[10px] font-display font-bold text-galaxy-400 uppercase tracking-widest bg-galaxy-600/20 px-2 py-0.5 rounded border border-galaxy-400/30">Mi cuenta</span>
        <h1 class="text-xl sm:text-2xl font-display font-extrabold text-white uppercase tracking-wider text-shadow-glow mt-1"><i class="fa-solid fa-gamepad text-galaxy-400 mr-2"></i>Mis partidos</h1>
        <p class="text-gray-300 text-xs mt-0.5">Tus partidos agendados, tu historial y cómo te va contra cada rival.</p>
      </div>
      <a href={`${base}duelos/`} class="btn btn-primary !min-h-10"><i class="fa-solid fa-satellite-dish"></i> Lanzar un reto</a>
    </header>

    <div class="grid lg:grid-cols-2 gap-4 sm:gap-5 items-start">
      <div class="min-w-0 space-y-4">
        <section class="space-y-3" aria-labelledby="h-agendados">
          <h2 id="h-agendados" class="text-base font-display font-bold text-white uppercase tracking-wider border-b border-galaxy-border pb-2"><i class="fa-regular fa-calendar text-galaxy-400 mr-2"></i>Agendados <b id="cnt-agendados" class="text-galaxy-400"></b></h2>
          <div id="lista-agendados" class="grid grid-cols-1 gap-3"><div class="text-center py-8 text-gray-400 text-xs">Cargando...</div></div>
        </section>
        <section class="space-y-3" aria-labelledby="h-historial">
          <h2 id="h-historial" class="text-base font-display font-bold text-white uppercase tracking-wider border-b border-galaxy-border pb-2"><i class="fa-solid fa-clock-rotate-left text-galaxy-400 mr-2"></i>Historial <b id="cnt-historial" class="text-galaxy-400"></b></h2>
          <div id="lista-historial" class="grid grid-cols-1 gap-2"></div>
        </section>
      </div>

      <section class="min-w-0 space-y-3" aria-labelledby="h-rivales">
        <h2 id="h-rivales" class="text-base font-display font-bold text-white uppercase tracking-wider border-b border-galaxy-border pb-2"><i class="fa-solid fa-users-viewfinder text-galaxy-400 mr-2"></i>Historial con cada rival</h2>
        <div id="bloque-duelos" class="space-y-2">
          <h3 class="text-[11px] text-gray-400 tracking-[0.2em] uppercase">En duelos</h3>
          <div id="lista-rivales-duelos" class="grid grid-cols-1 gap-2"></div>
        </div>
        <div id="bloque-liga" class="space-y-2">
          <h3 class="text-[11px] text-gray-400 tracking-[0.2em] uppercase">En la liga <span id="liga-ed" class="normal-case tracking-normal text-gray-500"></span></h3>
          <div id="lista-rivales-liga" class="grid grid-cols-1 gap-2"></div>
        </div>
      </section>
    </div>
  </div>
</Layout>
<script>
  import '../js/pages/misPartidos.js';
</script>

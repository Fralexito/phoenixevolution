---
import Layout from '../layouts/Layout.astro';
import Plegable from '../components/Plegable.astro';
const base = import.meta.env.BASE_URL;
---
<Layout title="Mis partidos" active="partidos" description="Tus partidos agendados, el historial y el récord contra cada rival.">
  <div class="max-w-6xl mx-auto px-4 sm:px-8 py-4 sm:py-6 w-full space-y-8">
    <header class="glass-panel px-4 py-3 rounded-2xl flex flex-wrap items-center justify-between gap-3">
      <div class="min-w-0">
        <span class="text-[12px] font-display font-bold text-galaxy-400 uppercase tracking-widest bg-galaxy-600/20 px-2 py-0.5 rounded border border-galaxy-400/30">Mi cuenta</span>
        <h1 class="text-xl sm:text-2xl font-display font-extrabold text-white uppercase tracking-wider text-shadow-glow mt-1"><i class="fa-solid fa-gamepad text-galaxy-400 mr-2"></i>Mis partidos</h1>
        <p class="text-gray-300 text-xs mt-0.5">Tus partidos agendados, tu historial y cómo te va contra cada rival.</p>
      </div>
      <a href={`${base}duelos/`} class="btn btn-primary !min-h-10"><i class="fa-solid fa-satellite-dish"></i> Lanzar un reto</a>
    </header>

    <!-- Ronda 226: cuatro grupos, del más urgente al menos: 1) Pendientes de ti (solo si hay algo) · 2) Próximos · 3) Resultados · 4) Contra cada rival (plegado). -->

    <!-- 1. PENDIENTES DE TI: valorar, confirmar marcadores y arbitrar. El grupo entero se oculta si sus tres bloques están vacíos (regla .mp-pendientes en pages.css). -->
    <div class="mp-pendientes space-y-5" aria-label="Pendientes de ti">
      <section id="bloque-valoraciones" hidden class="space-y-2" aria-labelledby="h-valoraciones">
        <h2 id="h-valoraciones" class="text-base font-display font-bold text-white uppercase tracking-wider border-b border-galaxy-border pb-2"><i class="fa-solid fa-star text-galaxy-400 mr-2"></i>Valora a tus rivales</h2>
        <p class="text-[12px] text-gray-400">Tu valoración es ciega: solo cuenta cuando tu rival también valora, o pasados 3 días. Nadie ve tus estrellas sueltas, solo el resumen en el perfil.</p>
        <div data-lista class="grid md:grid-cols-2 gap-2"></div>
      </section>
      <section id="bloque-mvp" hidden class="space-y-2" aria-labelledby="h-mvp">
        <h2 id="h-mvp" class="text-base font-display font-bold text-white uppercase tracking-wider border-b border-galaxy-border pb-2"><i class="fa-solid fa-star text-amber-300 mr-2"></i>MVP del partido</h2>
        <p class="text-[12px] text-gray-400">Vota al mejor jugador de tus duelos con marcador confirmado. La votación dura 48 horas y los votos se muestran al cerrar.</p>
        <div data-lista class="grid md:grid-cols-2 gap-2"></div>
      </section>
      <section id="bloque-marcadores" hidden class="space-y-2" aria-labelledby="h-marcadores">
        <h2 id="h-marcadores" class="text-base font-display font-bold text-white uppercase tracking-wider border-b border-galaxy-border pb-2"><i class="fa-solid fa-clipboard-check text-galaxy-400 mr-2"></i>Marcadores por confirmar</h2>
        <p class="text-[12px] text-gray-400">Un resultado cuenta en tus estadísticas y logros solo cuando los dos líderes están de acuerdo.</p>
        <div data-lista class="grid md:grid-cols-2 gap-2"></div>
      </section>
      <section id="bloque-arbitro" hidden class="space-y-2" aria-labelledby="h-arbitro">
        <h2 id="h-arbitro" class="text-base font-display font-bold text-white uppercase tracking-wider border-b border-galaxy-border pb-2"><i class="fa-solid fa-user-tie text-galaxy-400 mr-2"></i>Partidos que arbitras <b data-cuenta class="text-galaxy-400"></b></h2>
        <p class="text-[12px] text-gray-400">El staff te designó como árbitro. Tú validas el resultado que llega de Phoenix Link, aunque el host sea otro.</p>
        <div data-lista class="grid md:grid-cols-2 gap-2"></div>
      </section>
    </div>

    <div class="grid lg:grid-cols-2 gap-8 lg:gap-6 items-start">
      <!-- 2. PRÓXIMOS (lo principal) -->
      <div class="min-w-0">
        <section class="space-y-3" aria-labelledby="h-agendados">
          <h2 id="h-agendados" class="text-lg sm:text-xl font-display font-bold text-white uppercase tracking-wider border-b border-galaxy-border pb-2"><i class="fa-regular fa-calendar text-galaxy-400 mr-2"></i>Agendados <b id="cnt-agendados" class="text-galaxy-400"></b></h2>
          <button type="button" id="mp-calendario" hidden class="btn btn-ghost !min-h-9 !text-xs"><i class="fa-solid fa-calendar-plus"></i> Añadir mis partidos a mi calendario</button>
          <div id="lista-agendados" class="grid grid-cols-1 gap-3"><div class="text-center py-8 text-gray-400 text-xs">Cargando...</div></div>
        </section>
      </div>
      <!-- 3. RESULTADOS: oficiales de liga + historial de duelos, juntos -->
      <div class="min-w-0 space-y-5">
        <section id="bloque-oficiales" hidden class="space-y-2" aria-labelledby="h-oficiales">
          <h2 id="h-oficiales" class="text-base font-display font-bold text-white uppercase tracking-wider border-b border-galaxy-border pb-2"><i class="fa-solid fa-trophy text-galaxy-400 mr-2"></i>Mis partidos oficiales <b data-cuenta class="text-galaxy-400"></b></h2>
          <p class="text-[12px] text-gray-400">Resultados de liga que mandó Phoenix Link. Si algo está mal, usa «Reclamar» y el staff lo revisa.</p>
          <div data-lista class="grid grid-cols-1 gap-2"></div>
        </section>
        <section class="space-y-3" aria-labelledby="h-historial">
          <h2 id="h-historial" class="text-base font-display font-bold text-white uppercase tracking-wider border-b border-galaxy-border pb-2"><i class="fa-solid fa-clock-rotate-left text-galaxy-400 mr-2"></i>Historial <b id="cnt-historial" class="text-galaxy-400"></b></h2>
          <div id="lista-historial" class="grid grid-cols-1 gap-2"></div>
        </section>
      </div>
    </div>

    <!-- 4. CONTRA CADA RIVAL (plegado para no alargar la página) -->
    <Plegable titulo="Contra cada rival" icono="fa-users-viewfinder" resumen="Tu historial frente a cada jugador, en duelos y en la liga · toca para ver" id="mp-rivales">
      <div class="space-y-4">
        <div id="bloque-duelos" class="space-y-2">
          <h3 class="text-[12px] text-gray-400 tracking-[0.2em] uppercase">En duelos</h3>
          <div id="lista-rivales-duelos" class="grid grid-cols-1 gap-2"></div>
        </div>
        <div id="bloque-liga" class="space-y-2">
          <h3 class="text-[12px] text-gray-400 tracking-[0.2em] uppercase">En la liga <span id="liga-ed" class="normal-case tracking-normal text-gray-500"></span></h3>
          <div id="lista-rivales-liga" class="grid grid-cols-1 gap-2"></div>
        </div>
      </div>
    </Plegable>
  </div>
</Layout>
<script>
  import '../js/pages/misPartidos.js';
  import '../js/pages/misPartidosLiga.js';
</script>

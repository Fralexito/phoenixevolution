---
import Layout from '../layouts/Layout.astro';
import { FX } from '../data/experimento.js';
---
<Layout title="Creadores" active="creadores" description="Streamers y creadores de contenido de la comunidad Phoenix Evolution Series.">
  <div class="max-w-6xl mx-auto px-4 sm:px-8 py-4 sm:py-6 w-full space-y-4">
    <header class="glass-panel px-4 py-3 rounded-2xl flex flex-wrap items-center justify-between gap-3">
      <div><h1 class="text-xl sm:text-2xl font-display font-extrabold text-white uppercase tracking-wider text-shadow-glow"><i class="fa-solid fa-video text-galaxy-400 mr-2"></i>Creadores</h1>
        <p class="text-gray-300 text-xs mt-0.5">Streamers verificados de PES 2021, Football Life y más. Los que están en vivo aparecen primero.</p></div>
      <button type="button" id="cr-yo" hidden class="btn btn-primary !min-h-10"><i class="fa-solid fa-circle-check"></i> <span>Quiero ser creador</span></button>
    </header>
    <section id="cr-panel" hidden class="glass-panel rounded-2xl p-4"></section>
    <div id="cr-lista" class:list={[FX.carruseles ? "cr-carru" : "grid sm:grid-cols-2 lg:grid-cols-3 gap-3"]} data-carrusel={FX.carruseles ? "" : undefined} aria-label="Creadores"><p class="text-xs text-gray-400">Cargando…</p></div>
  </div>
</Layout>
<script>
  import '../js/pages/creadores.js';
</script>

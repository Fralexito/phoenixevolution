---
// /comunidad/ se fusionó con /social/ (mismo feed de muros). Se deja esta página para que los enlaces viejos no den 404.
// El «radar» que vivía aquí ya está en Jugar → En vivo (/ahora/). Lo viejo sigue en git (pages/comunidad.js) por si se quiere recuperar.
import Layout from '../layouts/Layout.astro';
const destino = `${import.meta.env.BASE_URL}social/`;
---
<Layout title="Comunidad" active="social">
  <meta http-equiv="refresh" content={`0; url=${destino}`} />
  <div class="max-w-xl mx-auto px-4 py-16 text-center text-gray-400 text-sm">La comunidad ahora vive en <a class="text-galaxy-400 underline" href={destino}>Social</a>…</div>
  <script is:inline define:vars={{ destino }}>location.replace(destino);</script>
</Layout>

---
// CONFIGURACIÓN (19-oct-2026, Fralex: «clona la sección de ajustes y opciones de Facebook / Meta y aplícala de la mejor manera»).
// La forma de «Configuración y privacidad» de Meta, con la identidad de Phoenix:
//   · arriba un buscador que encuentra cualquier opción; debajo la tarjeta de tu cuenta (como el «Centro de cuentas»);
//   · las secciones en grupos (Preferencias · Privacidad y datos), cada una como fila con ícono, para qué sirve y flecha;
//   · en PC, lista a la izquierda y la sección abierta a la derecha; en el celular, la lista y al tocar una fila se entra a su pantalla
//     con flecha para volver (la dirección guarda dónde estás: #apariencia, #cuenta…);
//   · las opciones se eligen tocando (botones), sin menús desplegables; los interruptores, como en el celular.
// Las opciones, sus valores y cómo se guardan NO cambian: salen de data/ajustes.js y las guarda js/pages/ajustes.js.
import Layout from '../layouts/Layout.astro';
import '../styles/configuracion.css';
import { SECCIONES, GRUPOS_AJUSTES, ESTILOS } from '../data/ajustes.js';
// Cada sección dice a qué grupo pertenece (data/ajustes.js): aquí solo se reparten.
const GRUPOS = GRUPOS_AJUSTES.map((g) => ({ ...g, secciones: SECCIONES.filter((s) => s.grupo === g.id) })).filter((g) => g.secciones.length);
const busca = (...t) => t.filter(Boolean).join(' ').toLowerCase();
---
<Layout title="Configuración" active="ajustes" description="Tu cuenta, cómo se ve la web, notificaciones, privacidad y tus datos.">
  <div class="cfg" data-cfg data-cfg-vista="indice">
    <aside class="cfg-lado" aria-label="Secciones de la configuración">
      <h1 class="cfg-h1">Configuración</h1>
      <label class="cfg-buscar"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input id="cfg-q" type="search" placeholder="Buscar en la configuración" autocomplete="off" aria-label="Buscar en la configuración"></label>

      <div class="cfg-indice" data-cfg-indice>
        <a class="cfg-cuenta" href="#cuenta" data-tab="cuenta">
          <span class="cfg-cuenta-av" id="cfg-av" aria-hidden="true"><i class="fa-solid fa-user"></i></span>
          <span class="cfg-txt"><b id="cfg-nombre">Tu cuenta</b><small id="cfg-usuario">Perfil, sesión y tus datos</small></span>
          <span class="cfg-flecha" aria-hidden="true"></span>
        </a>
        <!-- Estilos rápidos: con un toque cambian color, fondo, brillo, esquinas y letra a la vez (data/ajustes.js ESTILOS). -->
        <section class="cfg-grupo cfg-estilos-grupo" aria-labelledby="cfg-estilos-t">
          <h2 id="cfg-estilos-t">Estilos rápidos</h2><p>Un toque y la web cambia entera. Después puedes afinar cada detalle.</p>
          <div class="cfg-estilos" role="radiogroup" aria-label="Estilos rápidos">
            {ESTILOS.map((e) => (<button type="button" class="cfg-estilo" role="radio" aria-checked="false" data-estilo={e.id} style={`--muestra: ${e.muestra}`}><span class="cfg-estilo-m" aria-hidden="true"></span><b>{e.titulo}</b><small>{e.texto}</small></button>))}
          </div>
        </section>
        {GRUPOS.map((g) => (
          <section class="cfg-grupo">
            <h2>{g.titulo}</h2><p>{g.texto}</p>
            <nav class="cfg-filas">
              {g.secciones.map((s) => (
                <a class="cfg-fila" href={`#${s.id}`} data-tab={s.id}>
                  <span class="cfg-ic" aria-hidden="true"><i class={`fa-solid ${s.icono}`}></i></span>
                  <span class="cfg-txt"><b>{s.titulo}</b><small>{s.texto}</small></span>
                  <span class="cfg-cambios" data-cambios-de={s.id} hidden></span>
                  <span class="cfg-flecha" aria-hidden="true"></span>
                </a>
              ))}
            </nav>
          </section>
        ))}
      </div>
      <div class="cfg-resultados" id="cfg-resultados" hidden aria-live="polite"></div>
    </aside>

    <div class="cfg-panel">
      {SECCIONES.map((s) => (
        <section id={`panel-${s.id}`} data-panel data-seccion={s.id} hidden aria-labelledby={`cfg-t-${s.id}`}>
          <header class="cfg-panel-cab">
            <a class="cfg-volver" href="#" data-cfg-volver aria-label="Volver a la configuración"><span class="cfg-flecha cfg-flecha-atras" aria-hidden="true"></span></a>
            <span class="cfg-ic cfg-ic-grande" aria-hidden="true"><i class={`fa-solid ${s.icono}`}></i></span>
            <div class="min-w-0 flex-1"><h2 id={`cfg-t-${s.id}`}>{s.titulo}</h2><p>{s.texto}</p></div>
            {s.ajustes.length > 0 && <button type="button" class="cfg-reset" data-reset-seccion={s.id} hidden><i class="fa-solid fa-rotate-left" aria-hidden="true"></i><span>Restablecer</span></button>}
          </header>
          <div class:list={['cfg-cuerpo', s.vista && 'cfg-con-vista']}>
            <div class="cfg-ajustes">
              {s.ajustes.map((a) => a.tipo === 'switch' ? (
                <label class="cfg-aj cfg-aj-switch" for={`aj-${a.clave}`} data-busca={busca(a.etiqueta, a.ayuda, s.titulo)} data-busca-t={a.etiqueta} data-busca-s={s.id}>
                  <span class="cfg-txt"><b>{a.etiqueta}</b><small>{a.ayuda}</small></span>
                  <input id={`aj-${a.clave}`} type="checkbox" role="switch" class="cfg-switch" data-clave={a.clave} data-tipo="switch">
                </label>
              ) : (
                <fieldset class="cfg-aj" data-busca={busca(a.etiqueta, a.ayuda, s.titulo, ...a.opciones.map((o) => o.etiqueta))} data-busca-t={a.etiqueta} data-busca-s={s.id}>
                  <legend class="cfg-txt"><b>{a.etiqueta}</b><small>{a.ayuda}</small></legend>
                  <div class="cfg-ops">
                    {a.opciones.map((o) => (<label class:list={['cfg-op', o.muestra && 'cfg-op-con-muestra']}><input type="radio" name={`aj-${a.clave}`} value={String(o.valor)} data-clave={a.clave} data-tipo="radio"><span>{o.muestra && <i class="cfg-muestra" style={`background: ${o.muestra}`} aria-hidden="true"></i>}{o.etiqueta}</span></label>))}
                  </div>
                </fieldset>
              ))}
              {s.cuenta && <div id="aj-cuenta" class="cfg-aj cfg-cuenta-panel" data-busca={busca('cuenta perfil sesión cerrar sesión datos derechos descargar mis datos eliminar')} data-busca-t="Perfil, sesión y tus datos" data-busca-s={s.id}>Cargando tu sesión…</div>}
              {s.acciones && (
                <div class="cfg-acciones">
                  {s.acciones.map((x) => (
                    <button type="button" data-accion={x.id} class:list={['cfg-accion', x.peligro && 'cfg-peligro']} data-busca={busca(x.etiqueta, s.titulo)} data-busca-t={x.etiqueta} data-busca-s={s.id}>
                      <span class="cfg-ic" aria-hidden="true"><i class={`fa-solid ${x.icono}`}></i></span><span class="cfg-txt"><b>{x.etiqueta}</b></span><span class="cfg-flecha" aria-hidden="true"></span>
                    </button>
                  ))}
                  {s.id === 'datos' && <input id="aj-archivo" type="file" accept="application/json,.json" hidden />}
                </div>
              )}
            </div>
            {s.vista && (
              <aside class="cfg-vista" aria-label="Vista previa">
                <p class="cfg-vista-t"><i class="fa-regular fa-eye" aria-hidden="true"></i> Así se ve</p>
                <div id={`vp-${s.id}`} class="aj-vp"></div>
              </aside>
            )}
          </div>
        </section>
      ))}
      <p id="aj-estado" class="cfg-estado" role="status" aria-live="polite"></p>
      <div class="cfg-toast" id="cfg-toast" aria-hidden="true"><i class="fa-solid fa-circle-check"></i><span>Guardado</span></div>
    </div>
  </div>
</Layout>
<script>
  import '../js/pages/ajustes.js';
</script>

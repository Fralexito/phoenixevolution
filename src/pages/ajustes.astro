---
import Layout from '../layouts/Layout.astro';
import { SECCIONES } from '../data/ajustes.js';
const base = import.meta.env.BASE_URL;
---
<Layout title="Configuración" active="ajustes">
  <div class="max-w-5xl mx-auto px-4 py-6 sm:py-8 space-y-4">
    <header class="space-y-1">
      <h1 class="text-2xl md:text-3xl font-display font-extrabold text-white uppercase tracking-wider text-shadow-glow"><i class="fa-solid fa-gear text-galaxy-400 mr-2"></i>Configuración</h1>
      <p class="text-gray-400 text-xs sm:text-sm">Se guardan en este navegador y se aplican al instante. Si usas otro dispositivo, puedes llevarlos con «Exportar» / «Importar» en la sección Datos.</p>
    </header>

    <div role="tablist" aria-label="Secciones" class="flex gap-2 overflow-x-auto pb-1 -mx-4 px-4 sm:mx-0 sm:px-0 sm:flex-wrap">
      {SECCIONES.map((s) => <button type="button" role="tab" id={`tab-${s.id}`} aria-controls={`panel-${s.id}`} aria-selected="false" data-tab={s.id} class="aj-tab shrink-0"><i class={`fa-solid ${s.icono}`}></i><span>{s.titulo}</span></button>)}
    </div>

    {SECCIONES.map((s) => (
      <section id={`panel-${s.id}`} role="tabpanel" aria-labelledby={`tab-${s.id}`} data-panel class="rounded-xl border border-galaxy-border bg-galaxy-card/60">
        <header class="px-4 py-3 border-b border-galaxy-border/70 flex items-baseline gap-3 flex-wrap">
          <h2 class="font-display font-bold text-lg text-white uppercase tracking-wider"><i class={`fa-solid ${s.icono} text-galaxy-400 mr-2`}></i>{s.titulo}</h2>
          <p class="text-xs text-gray-400">{s.texto}</p>
        </header>
        <div class={`grid gap-0 ${s.vista ? 'lg:grid-cols-[minmax(0,1fr)_minmax(0,19rem)]' : ''}`}>
          <div class="divide-y divide-galaxy-border/60 min-w-0">
            {s.ajustes.map((a) => (
              <div class="px-4 py-3 flex items-center justify-between gap-3">
                <div class="min-w-0"><label class="text-white text-sm font-semibold" for={`aj-${a.clave}`}>{a.etiqueta}</label><div class="text-[11px] text-gray-400 leading-snug">{a.ayuda}</div></div>
                {a.tipo === 'switch'
                  ? <input id={`aj-${a.clave}`} data-clave={a.clave} data-tipo="switch" type="checkbox" class="w-5 h-5 shrink-0 accent-cyan-400" />
                  : <select id={`aj-${a.clave}`} data-clave={a.clave} data-tipo="opciones" class="field !w-auto !min-h-9 !py-1 max-w-[52%]">{a.opciones.map((o) => <option value={String(o.valor)}>{o.etiqueta}</option>)}</select>}
              </div>
            ))}
            {s.cuenta && <div id="aj-cuenta" class="px-4 py-3 text-sm text-gray-400">Cargando tu sesión…</div>}
            {s.acciones && (
              <div class="px-4 py-3 flex flex-wrap gap-2">
                {s.acciones.map((x) => <button type="button" data-accion={x.id} class={`btn ${x.peligro ? 'btn-ghost !text-bad !border-bad/50' : 'btn-ghost'} !min-h-9 !text-xs`}><i class={`fa-solid ${x.icono}`}></i> {x.etiqueta}</button>)}
                {s.id === 'datos' && <input id="aj-archivo" type="file" accept="application/json,.json" hidden />}
              </div>
            )}
          </div>
          {s.vista && (
            <aside aria-label="Vista previa" class="p-4 border-t lg:border-t-0 lg:border-l border-galaxy-border/70 bg-black/20 space-y-2">
              <div class="text-[10px] text-gray-500 tracking-[0.25em] uppercase"><i class="fa-regular fa-eye mr-1"></i>Vista previa en vivo</div>
              <div id={`vp-${s.id}`} class="aj-vp"></div>
            </aside>
          )}
        </div>
      </section>
    ))}
    <p id="aj-estado" class="text-xs text-gray-400 min-h-4" role="status" aria-live="polite"></p>
    <a href={base} class="btn btn-primary inline-flex"><i class="fa-solid fa-house"></i> Volver a Central</a>
  </div>
</Layout>
<script>
  import '../js/pages/ajustes.js';
</script>

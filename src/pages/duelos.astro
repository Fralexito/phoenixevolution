---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Sala de Duelos" active="duelos">
  <div class="max-w-7xl 2xl:max-w-[1360px] mx-auto px-5 sm:px-8 lg:px-12 py-5 sm:py-6 w-full space-y-4 sm:space-y-5">

    <!-- 1. Cabecera + estado unificado (Inactivo · Activo · Radar) -->
    <section class="glass-panel p-4 sm:p-5 rounded-2xl shadow-[0_0_24px_rgba(128,0,255,0.18)] flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div class="min-w-0">
        <span class="text-[10px] font-display font-bold text-galaxy-400 uppercase tracking-widest bg-galaxy-600/20 px-2 py-0.5 rounded border border-galaxy-400/30">Centro de Emparejamiento</span>
        <h1 class="text-xl sm:text-2xl md:text-3xl font-display font-extrabold text-white uppercase tracking-wider text-shadow-glow mt-1.5">SALA DE DUELOS &amp; HOSTING</h1>
        <p class="text-gray-300 text-xs mt-1 max-w-xl">Rétalos directo, abre un reto a toda la red o pacta una hora. Si no tienes host, se lo pedimos a quienes sí tienen.</p>
      </div>
      <div class="w-full md:w-80 shrink-0">
        <span class="label">Tu estado</span>
        <div class="seg seg-estado" id="seg-estado" role="group" aria-label="Tu estado en la liga">
          <button type="button" data-v="off" aria-pressed="false"><i class="fa-solid fa-moon mr-1"></i>Inactivo</button>
          <button type="button" data-v="on" aria-pressed="false"><i class="fa-solid fa-bolt mr-1"></i>Activo</button>
          <button type="button" data-v="radar" aria-pressed="false"><i class="fa-solid fa-tower-broadcast mr-1"></i>Radar</button>
        </div>
        <p id="estado-hint" class="text-[11px] text-gray-400 mt-1.5 min-h-8">Inicia sesión para elegir tu estado.</p>
      </div>
    </section>

    <!-- 2. Radar de jugadores (solo con el estado "Radar") -->
    <section id="radar-panel" hidden class="glass-panel p-4 rounded-2xl space-y-2" aria-live="polite">
      <h2 class="text-xs font-display font-bold text-white uppercase tracking-widest flex items-center gap-2"><i class="fa-solid fa-tower-broadcast text-galaxy-400"></i> Jugadores en el radar</h2>
      <div id="radar-list" class="flex flex-wrap gap-2"></div>
    </section>

    <!-- Solo en móvil: dos botones que abren/cierran «Lanzar reto» y «Mis partidos». «Retos en el radar» queda siempre visible abajo. En PC no existen. -->
    <div class="seg lg:!hidden" id="seg-vista" role="group" aria-label="Secciones">
      <button type="button" data-v="lanzar" aria-pressed="false" aria-controls="col-lanzar"><i class="fa-solid fa-satellite-dish mr-1"></i>Lanzar reto</button>
      <button type="button" data-v="partidos" aria-pressed="false" aria-controls="col-mis"><i class="fa-solid fa-gamepad mr-1"></i>Mis partidos <b id="cnt-movil" class="text-galaxy-400"></b></button>
    </div>

    <!-- 3. Dos columnas en PC: formulario a la izquierda · partidos y retos a la derecha -->
    <div id="duelos-grid" data-vista="ninguna" class="grid lg:grid-cols-[22rem_minmax(0,1fr)] xl:grid-cols-[24rem_minmax(0,1fr)] 2xl:grid-cols-[26rem_minmax(0,1fr)] gap-4 sm:gap-5 items-start">

      <section id="col-lanzar" class="glass-panel p-4 rounded-2xl space-y-3">
        <h2 class="text-base font-display font-bold text-white uppercase tracking-wider flex items-center gap-2"><i class="fa-solid fa-satellite-dish text-galaxy-400"></i> Lanzar Reto</h2>
        <form id="form-crear-reto" class="space-y-3.5" novalidate>

          <div>
            <span class="label">¿A quién retas?</span>
            <div class="seg" id="seg-destino" role="group" aria-label="Destino del reto">
              <button type="button" data-v="abierto" aria-pressed="true">A toda la red</button>
              <button type="button" data-v="directo" aria-pressed="false">A un jugador</button>
            </div>
          </div>

          <div id="bloque-directo" hidden class="space-y-3 bg-[#0c051a] p-3 rounded-xl border border-galaxy-600/40">
            <div>
              <label class="label" for="buscar-rival">Rival</label>
              <input id="buscar-rival" class="field mb-2" type="search" placeholder="Buscar jugador…" autocomplete="off" maxlength="40">
              <select id="select-rival" class="field" size="5" aria-label="Lista de jugadores"></select>
            </div>
            <div>
              <span class="label">¿Quién ve este reto?</span>
              <div class="seg" id="seg-vis" role="group" aria-label="Visibilidad">
                <button type="button" data-v="privado" aria-pressed="true"><i class="fa-solid fa-lock mr-1"></i>Solo el retado</button>
                <button type="button" data-v="publico" aria-pressed="false"><i class="fa-solid fa-eye mr-1"></i>Público</button>
              </div>
              <p id="hint-vis" class="text-[11px] text-gray-400 mt-1.5">Solo tu rival verá que lo retaste.</p>
            </div>
          </div>

          <div>
            <span class="label">Tamaño <span class="text-gray-500 normal-case">(máx. 8 en total)</span></span>
            <div id="tam-presets" class="grid grid-cols-4 gap-1.5 mb-2" role="group" aria-label="Formatos rápidos">
              <button type="button" class="chip" data-t="1-1" aria-pressed="true">1v1</button>
              <button type="button" class="chip" data-t="2-2" aria-pressed="false">2v2</button>
              <button type="button" class="chip" data-t="3-3" aria-pressed="false">3v3</button>
              <button type="button" class="chip" data-t="4-4" aria-pressed="false">4v4</button>
            </div>
            <div class="grid grid-cols-2 gap-2">
              <div class="bg-black/40 border border-galaxy-border rounded-lg px-2.5 py-1.5">
                <div class="text-[10px] font-display font-bold uppercase tracking-wider text-gray-400">Mi equipo (A)</div>
                <div class="flex items-center justify-between gap-1 mt-0.5">
                  <button type="button" id="tam-a-menos" aria-label="Quitar un jugador de mi equipo" class="chip !px-0 w-9 !min-h-9">−</button>
                  <span id="tam-a" class="font-display font-extrabold text-xl text-white">1</span>
                  <button type="button" id="tam-a-mas" aria-label="Añadir un jugador a mi equipo" class="chip !px-0 w-9 !min-h-9">+</button>
                </div>
              </div>
              <div class="bg-black/40 border border-galaxy-border rounded-lg px-2.5 py-1.5">
                <div class="text-[10px] font-display font-bold uppercase tracking-wider text-gray-400">Rival (B)</div>
                <div class="flex items-center justify-between gap-1 mt-0.5">
                  <button type="button" id="tam-b-menos" aria-label="Quitar un jugador del rival" class="chip !px-0 w-9 !min-h-9">−</button>
                  <span id="tam-b" class="font-display font-extrabold text-xl text-white">1</span>
                  <button type="button" id="tam-b-mas" aria-label="Añadir un jugador al rival" class="chip !px-0 w-9 !min-h-9">+</button>
                </div>
              </div>
            </div>
            <p class="text-[11px] text-gray-400 mt-1.5">Total: <b id="tam-total" class="text-galaxy-400">2/8</b> · <span id="hint-equipos"></span></p>
          </div>

          <div id="bloque-amigos" hidden class="space-y-2 bg-[#0c051a] p-3 rounded-xl border border-galaxy-600/40">
            <span class="label">Invita a tu equipo (opcional)</span>
            <input id="buscar-amigo" class="field" type="search" placeholder="Buscar jugador…" autocomplete="off" maxlength="40">
            <ul id="lista-amigos" class="grid grid-cols-1 gap-2 max-h-48 overflow-y-auto"></ul>
            <p id="hint-amigos" class="text-[11px] text-gray-400"></p>
          </div>

          <div>
            <span class="label">¿Quién hostea?</span>
            <div class="seg" id="seg-host" role="group" aria-label="Host">
              <button type="button" data-v="yo" aria-pressed="true">Yo tengo host</button>
              <button type="button" data-v="otro" aria-pressed="false">Necesito host</button>
            </div>
            <p id="hint-host" class="text-[11px] text-gray-400 mt-1.5"></p>
          </div>

          <div>
            <label class="label" for="select-plataforma">Plataforma</label>
            <select id="select-plataforma" class="field"><option value="Parsec">Parsec</option><option value="Smash Soda">Smash Soda</option><option value="Steam Remote Play">Steam Remote Play</option></select>
          </div>

          <div>
            <span class="label">¿Cuándo?</span>
            <div id="presets" class="grid grid-cols-5 gap-1.5" role="group" aria-label="Cuándo jugar">
              <button type="button" class="chip !px-1" data-p="ya" aria-pressed="true">Ya</button>
              <button type="button" class="chip !px-1" data-p="15" aria-pressed="false">15 min</button>
              <button type="button" class="chip !px-1" data-p="30" aria-pressed="false">30 min</button>
              <button type="button" class="chip !px-1" data-p="60" aria-pressed="false">1 hora</button>
              <button type="button" class="chip !px-1" data-p="manual" aria-pressed="false" aria-label="Elegir hora"><i class="fa-regular fa-calendar"></i></button>
            </div>
            <p id="hint-when" class="text-[11px] text-gray-400 mt-1.5"></p>
          </div>

          <div id="campo-fecha" hidden class="bg-[#0c051a] p-3 rounded-xl border border-galaxy-600/40 space-y-3">
            <div class="seg" role="group" aria-label="Modo de horario">
              <button type="button" id="tab-modo-rapido" aria-pressed="true">Acceso rápido</button>
              <button type="button" id="tab-modo-manual" aria-pressed="false">Fecha específica</button>
            </div>
            <div id="panel-horario-rapido" class="space-y-3">
              <div class="seg" role="group" aria-label="Día">
                <button type="button" id="btn-dia-hoy" aria-pressed="true">Hoy</button>
                <button type="button" id="btn-dia-manana" aria-pressed="false">Mañana</button>
              </div>
              <span class="text-[10px] text-gray-400 uppercase tracking-wider font-semibold block">Hora (00:00 y 01:00 son de madrugada). Mínimo 30 min de antelación.</span>
              <div id="grid-horas" class="grid grid-cols-4 gap-1.5"></div>
            </div>
            <div id="panel-horario-manual" hidden class="grid grid-cols-3 gap-2">
              <div><label class="label" for="manual-dia">Día</label><select id="manual-dia" class="field !px-2"></select></div>
              <div><label class="label" for="manual-mes">Mes</label><select id="manual-mes" class="field !px-2"></select></div>
              <div><label class="label" for="manual-hora">Hora</label><select id="manual-hora" class="field !px-2"></select></div>
            </div>
          </div>

          <div class="pt-3 border-t border-galaxy-border/60 space-y-2.5">
            <div class="text-xs"><span class="text-gray-400">Resumen: </span><span id="resumen" class="font-display font-bold text-galaxy-400 uppercase tracking-wide">—</span></div>
            <button type="submit" id="btn-emitir-reto" disabled class="btn btn-primary !min-h-10 w-full"><i class="fa-solid fa-bullhorn"></i> Emitir Reto</button>
          </div>
        </form>
      </section>

      <!-- Derecha: Mis partidos y Retos en el radar, SIEMPRE visibles (en PC lado a lado; en pantallas medianas, uno bajo otro) -->
      <div id="col-partidos" class="min-w-0 grid gap-4 sm:gap-5 xl:grid-cols-2 items-start">
        <section id="col-mis" class="min-w-0 space-y-3 scroll-mt-28" aria-labelledby="h-mis">
          <div class="flex items-center justify-between gap-3 border-b border-galaxy-border pb-2">
            <h2 id="h-mis" class="text-base font-display font-bold text-white uppercase tracking-wider flex items-center gap-2"><i class="fa-solid fa-gamepad text-galaxy-400"></i> Mis partidos <b id="cnt-mis" class="text-galaxy-400"></b></h2>
          </div>
          <div id="lista-mis" class="grid grid-cols-1 gap-3"></div>
        </section>
        <section id="col-radar" class="min-w-0 space-y-3" aria-labelledby="h-radar">
          <div class="flex items-center justify-between gap-3 border-b border-galaxy-border pb-2">
            <h2 id="h-radar" class="text-base font-display font-bold text-white uppercase tracking-wider flex items-center gap-2"><i class="fa-solid fa-tower-broadcast text-galaxy-400"></i> Retos en el radar <b id="cnt-radar" class="text-galaxy-400"></b></h2>
            <button id="btn-refrescar" type="button" class="text-xs text-galaxy-400 hover:text-white uppercase font-bold flex items-center gap-1 min-h-10 px-2 shrink-0" aria-label="Actualizar"><i class="fa-solid fa-arrows-rotate"></i><span class="hidden sm:inline"> Actualizar</span></button>
          </div>
          <div id="lista-retos" class="grid grid-cols-1 gap-3"><div class="col-span-full text-center py-10 text-gray-400 text-xs">Cargando retos activos...</div></div>
        </section>
      </div>
    </div>
  </div>
</Layout>
<script>
  import '../js/pages/duelos.js';
</script>

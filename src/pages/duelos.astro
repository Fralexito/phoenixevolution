---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Sala de Duelos" active="duelos">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8 w-full space-y-6 sm:space-y-8">

    <!-- 1. Cabecera + interruptor del Radar -->
    <section class="glass-panel p-5 sm:p-6 rounded-2xl shadow-[0_0_30px_rgba(128,0,255,0.2)] flex flex-col md:flex-row md:items-center justify-between gap-5">
      <div>
        <span class="text-xs font-display font-bold text-galaxy-400 uppercase tracking-widest bg-galaxy-600/20 px-2.5 py-1 rounded border border-galaxy-400/30">Centro de Emparejamiento</span>
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-display font-extrabold text-white uppercase tracking-wider text-shadow-glow mt-2">SALA DE DUELOS &amp; HOSTING</h1>
        <p class="text-gray-300 text-xs md:text-sm mt-1">Rétalos directo, abre un reto a toda la red o pacta una hora. Si no tienes host, se lo pedimos a quienes sí tienen.</p>
      </div>
      <div class="flex flex-col gap-2">
      <div class="flex items-center justify-between md:justify-start gap-4 bg-black/60 border border-galaxy-border px-4 sm:px-5 py-3 rounded-xl">
        <div class="flex flex-col">
          <span id="azar-text" class="text-xs font-display font-bold text-white uppercase tracking-wider">Retos al azar: Inicia sesión</span>
          <span class="text-[10px] text-gray-400">Inactivo = no recibes ni aceptas retos abiertos</span>
        </div>
        <button id="azar-toggle" type="button" role="switch" aria-checked="true" aria-label="Aceptar retos al azar" disabled
          class="shrink-0 w-12 h-6 bg-gray-800 aria-checked:bg-emerald-600 rounded-full p-1 transition-colors border border-gray-600 aria-checked:border-emerald-400 group disabled:opacity-40">
          <span class="block w-4 h-4 bg-gray-400 group-aria-checked:bg-white group-aria-checked:translate-x-6 rounded-full transition-transform"></span>
        </button>
      </div>
      <div class="flex items-center justify-between md:justify-start gap-4 bg-black/60 border border-galaxy-border px-4 sm:px-5 py-3 rounded-xl">
        <div class="flex flex-col">
          <span id="radar-status-text" class="text-xs font-display font-bold text-white uppercase tracking-wider">Radar Desactivado</span>
          <span class="text-[10px] text-gray-400">Verás quién está libre y recibirás alertas</span>
        </div>
        <button id="radar-toggle" type="button" role="switch" aria-checked="false" aria-label="Activar radar"
          class="shrink-0 w-12 h-6 bg-gray-800 aria-checked:bg-galaxy-600 rounded-full p-1 transition-colors border border-gray-600 aria-checked:border-galaxy-400 group">
          <span class="block w-4 h-4 bg-gray-400 group-aria-checked:bg-white group-aria-checked:translate-x-6 rounded-full transition-transform"></span>
        </button>
      </div>
      </div>
    </section>

    <!-- 2. Radar de jugadores (solo con el radar activo) -->
    <section id="radar-panel" hidden class="glass-panel p-5 rounded-2xl space-y-3" aria-live="polite">
      <h2 class="text-sm font-display font-bold text-white uppercase tracking-widest flex items-center gap-2"><i class="fa-solid fa-tower-broadcast text-galaxy-400"></i> Jugadores en el radar</h2>
      <div id="radar-list" class="flex flex-wrap gap-2"></div>
    </section>

    <!-- 3. Lanzar reto -->
    <section class="glass-panel p-5 sm:p-6 rounded-2xl space-y-5">
      <h2 class="text-lg sm:text-xl font-display font-bold text-white uppercase tracking-wider flex items-center gap-2"><i class="fa-solid fa-satellite-dish text-galaxy-400"></i> Lanzar Reto</h2>
      <form id="form-crear-reto" class="space-y-5" novalidate>

        <div>
          <span class="label">¿A quién retas?</span>
          <div class="seg" id="seg-destino" role="group" aria-label="Destino del reto">
            <button type="button" data-v="abierto" aria-pressed="true">A toda la red</button>
            <button type="button" data-v="directo" aria-pressed="false">A un jugador</button>
          </div>
        </div>

        <div id="bloque-directo" hidden class="space-y-4 bg-[#0c051a] p-4 rounded-xl border border-galaxy-600/40">
          <div>
            <label class="label" for="buscar-rival">Rival</label>
            <input id="buscar-rival" class="field mb-2" type="search" placeholder="Buscar jugador…" autocomplete="off" maxlength="40">
            <select id="select-rival" class="field" size="5" aria-label="Lista de jugadores"></select>
          </div>
          <div>
            <span class="label">¿Quién ve este reto?</span>
            <div class="seg" id="seg-vis" role="group" aria-label="Visibilidad">
              <button type="button" data-v="privado" aria-pressed="true"><i class="fa-solid fa-lock mr-1"></i>Solo el retado</button>
              <button type="button" data-v="publico" aria-pressed="false"><i class="fa-solid fa-eye mr-1"></i>Público</button>
            </div>
            <p id="hint-vis" class="text-[11px] text-gray-400 mt-1.5">Solo tu rival verá que lo retaste.</p>
          </div>
        </div>

        <div>
          <span class="label">Tamaño del partido <span class="text-gray-500 normal-case">(máximo 8 jugadores en total)</span></span>
          <div id="tam-presets" class="grid grid-cols-4 gap-2 mb-3" role="group" aria-label="Formatos rápidos">
            <button type="button" class="chip" data-t="1-1" aria-pressed="true">1v1</button>
            <button type="button" class="chip" data-t="2-2" aria-pressed="false">2v2</button>
            <button type="button" class="chip" data-t="3-3" aria-pressed="false">3v3</button>
            <button type="button" class="chip" data-t="4-4" aria-pressed="false">4v4</button>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div class="bg-black/40 border border-galaxy-border rounded-xl p-3 text-center">
              <div class="text-[10px] font-display font-bold uppercase tracking-wider text-gray-400 mb-1">Mi equipo (A)</div>
              <div class="flex items-center justify-between gap-2">
                <button type="button" id="tam-a-menos" aria-label="Quitar un jugador de mi equipo" class="chip !px-0 w-11">−</button>
                <span id="tam-a" class="font-display font-extrabold text-3xl text-white">1</span>
                <button type="button" id="tam-a-mas" aria-label="Añadir un jugador a mi equipo" class="chip !px-0 w-11">+</button>
              </div>
            </div>
            <div class="bg-black/40 border border-galaxy-border rounded-xl p-3 text-center">
              <div class="text-[10px] font-display font-bold uppercase tracking-wider text-gray-400 mb-1">Rival (B)</div>
              <div class="flex items-center justify-between gap-2">
                <button type="button" id="tam-b-menos" aria-label="Quitar un jugador del rival" class="chip !px-0 w-11">−</button>
                <span id="tam-b" class="font-display font-extrabold text-3xl text-white">1</span>
                <button type="button" id="tam-b-mas" aria-label="Añadir un jugador al rival" class="chip !px-0 w-11">+</button>
              </div>
            </div>
          </div>
          <p class="text-[11px] text-gray-400 mt-1.5">Total: <b id="tam-total" class="text-galaxy-400">2/8</b> · <span id="hint-equipos"></span></p>
        </div>

        <div id="bloque-amigos" hidden class="space-y-2 bg-[#0c051a] p-4 rounded-xl border border-galaxy-600/40">
          <span class="label">Invita a tu equipo (opcional)</span>
          <input id="buscar-amigo" class="field" type="search" placeholder="Buscar jugador…" autocomplete="off" maxlength="40">
          <ul id="lista-amigos" class="grid grid-cols-1 sm:grid-cols-2 gap-2 max-h-56 overflow-y-auto"></ul>
          <p id="hint-amigos" class="text-[11px] text-gray-400"></p>
        </div>

        <div>
          <span class="label">¿Quién hostea?</span>
          <div class="seg" id="seg-host" role="group" aria-label="Host">
            <button type="button" data-v="yo" aria-pressed="true">Yo tengo host</button>
            <button type="button" data-v="otro" aria-pressed="false">Necesito host</button>
          </div>
          <p id="hint-host" class="text-[11px] text-gray-400 mt-1.5"></p>
        </div>

        <div>
          <label class="label" for="select-plataforma">Plataforma</label>
          <select id="select-plataforma" class="field"><option value="Parsec">Parsec</option><option value="Smash Soda">Smash Soda</option><option value="Steam Remote Play">Steam Remote Play</option></select>
        </div>

        <div>
          <span class="label">¿Cuándo?</span>
          <div id="presets" class="grid grid-cols-2 sm:grid-cols-5 gap-2" role="group" aria-label="Cuándo jugar">
            <button type="button" class="chip" data-p="ya" aria-pressed="true">Ya</button>
            <button type="button" class="chip" data-p="15" aria-pressed="false">En 15 min</button>
            <button type="button" class="chip" data-p="30" aria-pressed="false">En 30 min</button>
            <button type="button" class="chip" data-p="60" aria-pressed="false">En 1 hora</button>
            <button type="button" class="chip col-span-2 sm:col-span-1" data-p="manual" aria-pressed="false"><i class="fa-regular fa-calendar mr-1"></i>Elegir hora</button>
          </div>
          <p id="hint-when" class="text-[11px] text-gray-400 mt-1.5"></p>
        </div>

        <div id="campo-fecha" hidden class="bg-[#0c051a] p-4 sm:p-5 rounded-xl border border-galaxy-600/40 space-y-4">
          <div class="seg" role="group" aria-label="Modo de horario">
            <button type="button" id="tab-modo-rapido" aria-pressed="true">Acceso rápido</button>
            <button type="button" id="tab-modo-manual" aria-pressed="false">Fecha específica</button>
          </div>
          <div id="panel-horario-rapido" class="space-y-3">
            <div class="seg" role="group" aria-label="Día">
              <button type="button" id="btn-dia-hoy" aria-pressed="true">Hoy</button>
              <button type="button" id="btn-dia-manana" aria-pressed="false">Mañana</button>
            </div>
            <span class="text-[10px] text-gray-400 uppercase tracking-wider font-semibold block">Hora (00:00 y 01:00 son de madrugada). Mínimo 30 min de antelación.</span>
            <div id="grid-horas" class="grid grid-cols-4 sm:grid-cols-6 md:grid-cols-8 gap-2"></div>
          </div>
          <div id="panel-horario-manual" hidden class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div><label class="label" for="manual-dia">Día del mes</label><select id="manual-dia" class="field"></select></div>
            <div><label class="label" for="manual-mes">Mes</label><select id="manual-mes" class="field"></select></div>
            <div><label class="label" for="manual-hora">Hora exacta (24H)</label><select id="manual-hora" class="field"></select></div>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-3 border-t border-galaxy-border/60">
          <div class="text-xs"><span class="text-gray-400">Resumen: </span><span id="resumen" class="font-display font-bold text-galaxy-400 uppercase tracking-wide">—</span></div>
          <button type="submit" id="btn-emitir-reto" disabled class="btn btn-primary !min-h-11 w-full sm:w-auto"><i class="fa-solid fa-bullhorn"></i> Emitir Reto</button>
        </div>
      </form>
    </section>

    <!-- 4. Mis partidos -->
    <section id="mis-partidos" hidden class="space-y-4 scroll-mt-24">
      <h2 class="text-lg sm:text-xl font-display font-bold text-white uppercase tracking-wider text-shadow-glow border-b border-galaxy-border pb-2">Mis partidos</h2>
      <div id="lista-mis" class="grid grid-cols-1 lg:grid-cols-2 gap-4"></div>
    </section>

    <!-- 5. Retos públicos -->
    <section class="space-y-4">
      <div class="flex items-center justify-between border-b border-galaxy-border pb-2">
        <h2 class="text-lg sm:text-xl font-display font-bold text-white uppercase tracking-wider text-shadow-glow">Retos en el Radar</h2>
        <button id="btn-refrescar" type="button" class="text-xs text-galaxy-400 hover:text-white uppercase font-bold flex items-center gap-1 min-h-11 px-2"><i class="fa-solid fa-arrows-rotate"></i> Actualizar</button>
      </div>
      <div id="lista-retos" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4"><div class="col-span-full text-center py-10 text-gray-400 text-xs">Cargando retos activos...</div></div>
    </section>
  </div>
</Layout>
<script>
  import '../js/pages/duelos.js';
</script>

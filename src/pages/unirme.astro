---
// Página «Unirme a la liga»: guía de entrada en 5 pasos (contenido en data/unirme.js). Pensada para que un recién llegado sepa qué hacer sin preguntar.
import Layout from '../layouts/Layout.astro';
import Plegable from '../components/Plegable.astro';
import { UNIRME } from '../data/unirme.js';
import { SOCIALS } from '../data/site.js';
const base = import.meta.env.BASE_URL;
const discord = SOCIALS.find((s) => s.label === 'Discord')?.href ?? '#';
// Un `href` relativo es una página de este sitio; «DISCORD» se sustituye por el enlace real del Discord.
const resolver = (h) => (h === 'DISCORD' ? discord : /^https?:/.test(h) ? h : `${base}${h}`);
---
<Layout title="Unirme a la liga" active="unirme" description="Guía rápida para entrar a Phoenix Evolution Series: Discord, cuenta, ficha, Parsec y tu primer partido.">
  <header class="relative overflow-hidden border-b border-galaxy-border/40">
    <div class="absolute inset-0 bg-gradient-to-b from-galaxy-900/70 to-transparent"></div>
    <div class="relative z-10 max-w-4xl mx-auto px-5 sm:px-8 py-10 sm:py-16 text-center space-y-3">
      <span class="liga-sello">Guía de entrada</span>
      <h1 class="text-4xl sm:text-6xl font-display font-extrabold text-white uppercase leading-none text-shadow-glow">{UNIRME.titulo[0]} <span class="text-transparent bg-clip-text bg-gradient-to-r from-galaxy-400 to-galaxy-600">{UNIRME.titulo[1]}</span></h1>
      <p class="text-sm sm:text-lg text-gray-300 font-display tracking-wide">{UNIRME.lema}</p>
    </div>
  </header>

  <div class="max-w-3xl mx-auto px-5 sm:px-8 py-8 sm:py-12 space-y-8 pb-20">
    <ol class="space-y-3" aria-label="Pasos para entrar a la liga">
      {UNIRME.pasos.map((p, i) => (
        <li class="glass-panel rounded-2xl p-4 sm:p-5 flex gap-4 items-start">
          <span class="shrink-0 w-11 h-11 rounded-xl grid place-items-center bg-galaxy-600/25 border border-galaxy-400/40 text-galaxy-400 font-display font-extrabold text-lg" aria-hidden="true">{i + 1}</span>
          <div class="min-w-0 flex-1 space-y-1.5">
            <h2 class="font-display font-bold text-base sm:text-lg text-white uppercase tracking-wider flex items-center gap-2"><i class={`${p.icon} text-galaxy-400 text-sm`}></i>{p.titulo}</h2>
            <p class="text-sm text-gray-300 leading-relaxed">{p.texto}</p>
            {p.enlace && (
              <a href={resolver(p.enlace.href)} target={p.enlace.externo ? '_blank' : undefined} rel={p.enlace.externo ? 'noopener noreferrer' : undefined} class="inline-flex items-center gap-2 text-xs font-display font-bold uppercase tracking-wider text-galaxy-400 hover:text-white border border-galaxy-400/30 bg-galaxy-400/10 hover:bg-galaxy-400/20 px-3 py-1.5 rounded transition-colors">{p.enlace.texto} <i class="fa-solid fa-arrow-right"></i></a>
            )}
            {p.accion === 'registro' && (
              <button type="button" id="unirme-registro" class="inline-flex items-center gap-2 text-xs font-display font-bold uppercase tracking-wider text-galaxy-400 hover:text-white border border-galaxy-400/30 bg-galaxy-400/10 hover:bg-galaxy-400/20 px-3 py-1.5 rounded transition-colors">Crear mi cuenta <i class="fa-solid fa-arrow-right"></i></button>
            )}
          </div>
        </li>
      ))}
    </ol>

    <Plegable titulo="Preguntas frecuentes" icono="fa-circle-question" resumen="Costo, requisitos, calendario y soporte">
      <dl class="space-y-4">
        {UNIRME.preguntas.map((q) => (<div><dt class="font-display font-bold text-sm text-white uppercase tracking-wider">{q.p}</dt><dd class="text-sm text-gray-300 mt-1 leading-relaxed">{q.r}</dd></div>))}
      </dl>
    </Plegable>
  </div>
</Layout>
<script>
  import { openAuthModal } from '../js/features/auth.js';
  document.getElementById('unirme-registro')?.addEventListener('click', () => openAuthModal('register'));
</script>

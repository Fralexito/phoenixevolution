---
// MODO MÁNAGER (Liga Máster de la web): opcional y por jugador. Cada usuario puede activar su carrera de DT,
// elegir un club aprobado, y fichar/vender en ventanas. Los movimientos se reflejan en el juego vía option file (claude/liga-master-plan.md).
// BD: migración 079 (lm_*). Lógica: js/pages/manager.js. Conexión con el juego: /mercado/ (programa Phoenix Sync).
import Layout from '../layouts/Layout.astro';
// CSS propio de esta página (antes iba en global.css para todas; 19-oct-2026). DESPUÉS de Layout: así gana a global.css como antes.
import '../styles/fichaJugador.css';
import '../styles/miClub.css';
import '../styles/cambiosOficiales.css';
import '../styles/salaFichajes.css';
import '../styles/perfilJugador.css';
// 19-oct-2026 (Fralex: «Mi club es lo más exclusivo que tengo… merece todo un ecosistema diferente… que se disfrute entrar ahí»):
// «El Estadio»: entrada con el escudo de tu club bajo las luces y teñida con su color, UNA barra propia (Resumen · Vestuario · Plantilla ·
// Fichajes · Diario · Administrar la liga [staff]) y un Resumen del club. La lógica de siempre (manager.js, clubUnificado.js) no cambia:
// la barra usa las mismas direcciones (#plantilla, #vestuario…). Estilos en miClubEstadio.css; comportamiento en features/miClub/estadio.js.
import '../styles/miClubEstadio.css';
import { FX } from '../data/experimento.js';
import Plegable from '../components/Plegable.astro';
const base = import.meta.env.BASE_URL;
const TABS = [['plantilla', 'fa-people-group', 'Plantilla'], ['mercado', 'fa-magnifying-glass-dollar', 'Mercado'], ['oficina', 'fa-envelope-open-text', 'Oficina'], ['movimientos', 'fa-right-left', 'Movimientos']];
---
<Layout title="Liga Máster" active="manager" description="Tu carrera de DT en la Galaxy League: club, presupuesto y fichajes que llegan al juego.">
  <div class={`mcx max-w-6xl mx-auto px-4 sm:px-8 py-6 w-full space-y-6${FX.ligaMasterGalaxia ? ' lmg' : ''}`} data-mcx>
    <!-- Luces del estadio: dos haces que caen sobre la entrada (decorativo). -->
    <div class="mcx-luces" aria-hidden="true"><i></i><i></i></div>

    {FX.ligaMasterGalaxia ? (
      <Fragment>
        <!-- Ronda 279 (FX.ligaMasterGalaxia): cabecera galáctica, igual familia que Mi club. Mismos ids que usa manager.js -->
        <header id="mg-portada" class="mcg-hero lmg-hero">
          <div class="mcg-estrellas" aria-hidden="true"></div>
          <svg class="mcg-orbitas" viewBox="0 0 240 240" aria-hidden="true">
            <ellipse cx="120" cy="120" rx="112" ry="44" transform="rotate(-18 120 120)"/>
            <ellipse cx="120" cy="120" rx="88" ry="30" transform="rotate(24 120 120)"/>
            <circle class="mcg-luna" cx="226" cy="98" r="5"/><circle class="mcg-luna mcg-luna2" cx="40" cy="96" r="3.5"/>
          </svg>
          <div class="mcg-insignia lmg-insignia" aria-hidden="true"><i class="fa-solid fa-user-tie"></i></div>
          <div class="mcg-texto min-w-0">
            <div class="mcg-chips"><span class="mcg-chip mcg-beta">Beta · Liga Máster</span><span id="lmg-ventana" class="mcg-chip lmg-ventana"><i></i><b>Ventana de fichajes…</b></span>{FX.clubUnificado && <span class="mcg-chip" id="mc-estado" data-estado="out"><i></i><b class="mcg-e-out">Phoenix Sync</b><b class="mcg-e-off">Juego sin conectar</b><b class="mcg-e-on">Juego conectado</b></span>}</div>
            <h1 class="mcg-titulo">{FX.clubUnificado ? 'Mi club' : 'Liga Máster'}</h1>
            <p class="mcg-sub">{FX.clubUnificado ? 'Todo tu club en un solo lugar: tu carrera de DT en la Galaxy (presupuesto, fichajes y ofertas) y el vestuario de tu partida de PES 2021, que Phoenix Sync aplica en el juego.' : 'Tu carrera de DT: eliges un club, manejas su presupuesto y fichas jugadores. Al cerrar cada ventana, los movimientos llegan al juego con el option file oficial.'}</p>
          </div>
          <div id="mg-club" class="lmg-club"></div>
        </header>
        <section id="mg-sin-sesion" class="mcg-panel mcg-acceso">
          <div><h2 class="mcg-h2">Activa tu carrera de DT</h2><p>Entra para elegir tu club y empezar a fichar.</p></div>
          <div class="flex flex-wrap gap-2"><button type="button" class="btn btn-primary" data-pr-auth="login"><i class="fa-solid fa-right-to-bracket"></i> Entrar</button><button type="button" class="btn btn-ghost" data-pr-auth="register"><i class="fa-solid fa-user-plus"></i> Crear cuenta</button></div>
        </section>
      </Fragment>
    ) : (
      <Fragment>
    <header id="mg-portada" class="mg-portada">
      <span class="text-[12px] font-display font-bold text-amber-300 uppercase tracking-widest bg-amber-500/10 px-2 py-0.5 rounded border border-amber-400/30">Beta · Galaxy League</span>
      <h1 class="text-3xl sm:text-5xl font-display font-extrabold text-white uppercase tracking-wider mt-2"><i class="fa-solid fa-user-tie text-galaxy-400 mr-2"></i>Liga Máster</h1>
      <p class="text-gray-300 text-sm mt-1 max-w-3xl">Tu carrera de DT: eliges un club, manejas su presupuesto y fichas jugadores. Al cerrar cada ventana, los movimientos llegan al juego con el option file oficial.</p>
      <div id="mg-club" class="mt-4"></div>
    </header>

    <p id="mg-sin-sesion" class="glass-panel rounded-2xl p-6 text-center text-sm text-gray-300">Inicia sesión para activar tu carrera de mánager.</p>

      </Fragment>
    )}

    <!-- La barra de Mi club: una sola navegación para todo el club (se pega bajo la cabecera al bajar). -->
    <nav class="mcx-dock" aria-label="Secciones de Mi club" data-mcx-dock>
      <a href="#resumen" data-mcx="resumen"><i class="fa-solid fa-gauge-high" aria-hidden="true"></i><span>Resumen</span></a>
      <a href="#plantilla" data-mcx="plantilla" data-mcx-club><i class="fa-solid fa-people-group" aria-hidden="true"></i><span>Plantilla</span></a>
      <a href="#mercado" data-mcx="mercado" data-mcx-club><i class="fa-solid fa-handshake" aria-hidden="true"></i><span>Fichajes</span><b class="mcx-dock-n" data-mcx-ofertas hidden></b></a>
      {FX.clubUnificado && <a href="#vestuario" data-mcx="vestuario" data-modo="vestuario"><i class="fa-solid fa-shirt" aria-hidden="true"></i><span>Vestuario del juego</span><em>PES</em></a>}
      <a href="#movimientos" data-mcx="movimientos" data-mcx-club><i class="fa-solid fa-right-left" aria-hidden="true"></i><span>Diario</span></a>
      <a href="#admin" data-mcx="admin" data-mcx-staff><i class="fa-solid fa-sliders" aria-hidden="true"></i><span>Administrar la liga</span></a>
      <button type="button" class="mcx-dock-ayuda" data-mcx-guia-abrir aria-label="Cómo funciona Mi club" title="Cómo funciona Mi club"><i class="fa-solid fa-circle-question" aria-hidden="true"></i></button>
    </nav>

    <!-- Cómo funciona Mi club (19-oct-2026): lo que antes no se entendía. Sale siempre sin club; con club, solo en Resumen hasta pulsar «Entendido».
         El botón «?» de la barra la vuelve a abrir (features/miClub/estadio.js). -->
    <section class="mcx-guia" data-mcx-guia aria-labelledby="mcx-guia-t">
      <div class="mcx-guia-cab"><h2 id="mcx-guia-t">Cómo funciona Mi club</h2><button type="button" class="mcx-guia-ok" data-mcx-guia-cerrar>Entendido</button></div>
      <ol class="mcx-guia-pasos">
        <li><b>Diriges un club de la Liga Máster</b><p>Eliges un club libre de la liga de la web y recibes un presupuesto. Desde ahí eres su DT; puedes dejarlo cuando quieras.</p></li>
        <li><b>Fichas con la ventana abierta</b><p>En Fichajes abres la sala: a los clubes de la IA y a los agentes libres los fichas al momento; a los clubes con DT les haces una oferta y la respuesta te llega a «Tus ofertas».</p></li>
        <li><b>Llevas todo a tu partida de PES</b><p>Con Phoenix Sync en tu PC, tus fichajes llegan a tu partida de PES 2021. En Vestuario del juego editas dorsales, posiciones y fichas del club que subiste.</p><a class="mcx-guia-link" href={`${base}mercado/`}>Conectar mi juego</a></li>
      </ol>
    </section>

    {FX.clubUnificado && (
      <nav class="cu-modos" role="tablist" aria-label="Mi club">
        <button type="button" role="tab" data-modo="carrera" aria-selected="true"><i class="fa-solid fa-user-tie"></i><span><b>Carrera de DT</b><small>Club, fichajes y ofertas</small></span></button>
        <button type="button" role="tab" data-modo="vestuario" aria-selected="false"><i class="fa-solid fa-shirt"></i><span><b>Vestuario del juego</b><small>Fichas de tu partida de PES</small></span></button>
      </nav>
    )}
    <div id="cu-carrera" class="space-y-6">
    <!-- Sin club: elegir uno -->
    <section id="mg-elegir" hidden class="space-y-3">
      <p class="mcg-kicker lmg-only">El vestuario te espera</p>
      <h2 class="font-display font-bold text-white uppercase tracking-wider lmg-h2">Elige tu club</h2>
      <p class="text-xs text-gray-400">Es opcional: si no activas tu carrera, todo lo demás de la web sigue igual. Puedes dejar el club cuando quieras.</p>
      <div id="mg-clubes-libres" class="grid grid-cols-2 lg:grid-cols-4 gap-3"></div>
    </section>

    <!-- Con club -->
    <div id="mg-panel" hidden class="space-y-4">
      <nav class="mg-tabs" role="tablist">
        {TABS.map(([id, ic, t], i) => <a href={`#${id}`} role="tab" data-tab={id} aria-current={i === 0 ? 'page' : undefined}><i class={`fa-solid ${ic}`}></i>{t}</a>)}
      </nav>
      <!-- Resumen del club (19-oct-2026): lo pinta manager.js (pintarResumen) con los datos de siempre. -->
      <section data-panel="resumen" class="mcx-resumen" hidden aria-live="polite"><div id="mcx-resumen" class="mcx-bento"></div></section>
      <!-- PLANTILLA (19-oct-2026): arriba, tu equipo por líneas (cuántos y su media; tocar una filtra). Tres formas de verlo: Cancha (todo el equipo
           en una pantalla, como en la pizarra), Cartas y Lista. En el celular las cartas van de a 3 por fila (antes 2). -->
      <section data-panel="plantilla" hidden class="space-y-4 mcx-plantilla"><div class="mg-lineas mcx-fuerza" role="group" aria-label="Tu equipo por líneas: toca una para ver solo esa" data-mcx-fuerza></div><div class="mg-herr"><div class="mg-vista" role="group" aria-label="Cómo ver a tus jugadores"><button type="button" data-vista="cancha" aria-pressed="false" title="Todo el equipo en la cancha"><i class="fa-solid fa-futbol"></i><span>Cancha</span></button><button type="button" data-vista="grande" aria-pressed="true" title="Cartas"><i class="fa-solid fa-table-cells-large"></i><span>Cartas</span></button><button type="button" data-vista="compacta" aria-pressed="false" title="Lista"><i class="fa-solid fa-list"></i><span>Lista</span></button></div><div class="mg-herr-der"><label class="mg-orden" title="Ordenar"><i class="fa-solid fa-arrow-down-wide-short"></i><select data-orden aria-label="Ordenar por"><option value="media">Mejor media</option><option value="valor">Más caros</option><option value="edad">Más jóvenes</option><option value="nombre">Nombre (A-Z)</option></select></label><div class="mg-tam" role="group" aria-label="Tamaño de las cartas"><button type="button" data-tam="-1" aria-label="Cartas más pequeñas" title="Alejar"><i class="fa-solid fa-magnifying-glass-minus"></i></button><button type="button" data-tam="1" aria-label="Cartas más grandes" title="Agrandar"><i class="fa-solid fa-magnifying-glass-plus"></i></button></div></div></div><div id="mg-plantilla" class="space-y-6"></div></section>
      <!-- FICHAJES (19-oct-2026): primero la sala (la forma principal de fichar), luego tus ofertas (antes estaban en otra pestaña, «Oficina»)
           y al final la lista completa del mercado, plegada: antes era un muro de 60 cartas que ocupaba casi seis pantallas. -->
      <section data-panel="mercado" hidden class="mcx-fichajes">
        <button type="button" id="mg-abrir-sala" class="cfx-sala mg-sala"><span class="cfx-sala-escudos" aria-hidden="true"><i class="fa-solid fa-people-group"></i></span><span class="cfx-sala-texto"><b>Abrir la sala de fichajes</b><small>Mira cada club, su plantilla y su DT, y ficha u oferta desde ahí.</small></span><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button>
        <section class="mcx-ofertas" id="mcx-ofertas" aria-labelledby="mcx-ofertas-t">
          <h3 class="mcx-h" id="mcx-ofertas-t">Tus ofertas</h3>
          <div class="mcx-ofertas-grid">
            <div class="mg-caja"><h4 class="mg-caja-tit"><i class="fa-solid fa-inbox"></i> Recibidas</h4><div id="mg-recibidas" class="space-y-2"></div></div>
            <div class="mg-caja"><h4 class="mg-caja-tit"><i class="fa-solid fa-paper-plane"></i> Enviadas</h4><div id="mg-enviadas" class="space-y-2"></div></div>
          </div>
        </section>
        <details class="mcx-lista" id="mcx-lista">
        <summary><i class="fa-solid fa-list" aria-hidden="true"></i><span><b>Lista completa del mercado</b><small>Busca por nombre o posición, o mira solo a los agentes libres</small></span></summary>
        <div class="mcx-lista-cuerpo">
        <div class="mg-filtros">
          <label class="relative flex-1 min-w-48"><i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 text-xs"></i><input id="mg-buscar" type="search" placeholder="Buscar jugador…" class="field w-full !pl-8"></label>
          <select id="mg-pos" class="field w-32"><option value="">Posición</option>{['PT','DEC','LD','LI','MCD','MC','MO','MD','MI','ED','EI','SD','DC'].map((p) => <option>{p}</option>)}</select>
          <label class="mg-toggle"><input id="mg-libres" type="checkbox"><span><i class="fa-solid fa-unlock"></i> Solo libres</span></label>
        </div>
        <div class="mg-herr"><div class="mg-lineas" role="group" aria-label="Ver solo una línea"><button type="button" data-linea="" aria-pressed="true">Todos</button><button type="button" data-linea="por" aria-pressed="false">Porteros</button><button type="button" data-linea="def" aria-pressed="false">Defensas</button><button type="button" data-linea="med" aria-pressed="false">Mediocampo</button><button type="button" data-linea="del" aria-pressed="false">Delanteros</button></div><div class="mg-herr-der"><label class="mg-orden" title="Ordenar"><i class="fa-solid fa-arrow-down-wide-short"></i><select data-orden aria-label="Ordenar por"><option value="media">Mejor media</option><option value="valor">Más caros</option><option value="edad">Más jóvenes</option><option value="nombre">Nombre (A-Z)</option></select></label><div class="mg-tam" role="group" aria-label="Tamaño de las cartas"><button type="button" data-tam="-1" aria-label="Cartas más pequeñas" title="Alejar"><i class="fa-solid fa-magnifying-glass-minus"></i></button><button type="button" data-tam="1" aria-label="Cartas más grandes" title="Agrandar"><i class="fa-solid fa-magnifying-glass-plus"></i></button></div><div class="mg-vista" role="group" aria-label="Cómo ver las cartas"><button type="button" data-vista="grande" aria-pressed="true" title="Cartas"><i class="fa-solid fa-table-cells-large"></i><span>Cartas</span></button><button type="button" data-vista="compacta" aria-pressed="false" title="Lista"><i class="fa-solid fa-list"></i><span>Lista</span></button></div></div></div>
        <div id="mg-mercado"></div>
        </div>
        </details>
      </section>
      <section data-panel="movimientos" hidden class="mg-caja"><h3 class="mg-caja-tit"><i class="fa-solid fa-right-left"></i> Diario de fichajes · Galaxy League</h3><div id="mg-movs"></div></section>
      <!-- «Dejar mi club» solo al pie del Resumen (antes salía bajo TODAS las pestañas). -->
      <div data-panel="resumen" hidden class="mcx-pie"><button type="button" id="mg-dejar" class="mcx-dejar"><i class="fa-solid fa-door-open" aria-hidden="true"></i> Dejar mi club</button></div>
    </div>

    <!-- ADMINISTRAR LA LIGA (antes «Centro de control», 19-oct-2026; Fralex: «no entiendo para nada la parte de centro de control»).
         Solo staff, con su propia pestaña (#admin) y en 3 pasos explicados: la temporada · clubes que juegan · herramientas avanzadas (plegadas).
         Mismos ids de siempre: la lógica sigue en manager.js, managerEquivalencias.js y managerTraspasosReales.js. Todo se guarda solo. -->
    <section id="mg-staff" hidden class="mg-staff mcx-admin" aria-labelledby="mcx-admin-t">
      <div class="mcx-admin-cab">
        <div class="min-w-0"><h2 id="mcx-admin-t">Administrar la liga</h2><p>Solo lo ve el staff. Aquí decides cuándo se puede fichar, con cuánto dinero empieza cada DT y qué clubes juegan. No hay botón Guardar: cada cambio se guarda solo.</p></div>
        <span id="mg-guardado" class="mg-guardado" aria-live="polite"></span>
      </div>
      <div id="mcx-admin-estado" class="mcx-admin-estado" aria-live="polite"></div>

      <section class="mcx-admin-paso" aria-labelledby="mcx-admin-1">
        <h3 id="mcx-admin-1"><span class="mcx-admin-n">1</span> La temporada</h3>
        <p class="mcx-admin-ayuda">Abre la ventana cuando quieras que los DT fichen y ciérrala para congelar las plantillas. El presupuesto y el máximo de jugadores valen para todos los clubes.</p>
        <div class="mg-ctrl-grid">
          <label class="mg-ctrl mg-ctrl-ventana" for="mg-c-ventana">
            <span class="mg-ctrl-ic"><i class="fa-solid fa-door-open"></i></span>
            <span class="flex-1"><b>Ventana de fichajes</b><small id="mg-c-ventana-txt">—</small></span>
            <input id="mg-c-ventana" type="checkbox" class="mg-switch">
          </label>
          <div class="mg-ctrl mg-ctrl-col">
            <div class="flex items-center gap-3 w-full"><span class="mg-ctrl-ic"><i class="fa-solid fa-wallet"></i></span>
              <span class="flex-1"><b>Dinero con el que empieza cada DT</b><small>Lo recibe al elegir su club</small></span><output id="mg-c-presu-v" class="mg-ctrl-num">—</output></div>
            <input id="mg-c-presu" type="range" min="5000000" max="300000000" step="5000000" class="mg-range" aria-label="Dinero con el que empieza cada DT">
            <div class="flex flex-wrap gap-1.5">{[25, 50, 100, 200].map((m) => <button type="button" class="mg-chip" data-presu={m * 1e6}>€{m} M</button>)}</div>
          </div>
          <div class="mg-ctrl">
            <span class="mg-ctrl-ic"><i class="fa-solid fa-people-group"></i></span>
            <span class="flex-1"><b>Máximo de jugadores</b><small>Por club; nadie puede fichar por encima</small></span>
            <div class="mg-stepper"><button type="button" data-max="-1" aria-label="Menos">−</button><output id="mg-c-max">30</output><button type="button" data-max="1" aria-label="Más">+</button></div>
          </div>
          <label class="mg-ctrl" for="mg-exigir">
            <span class="mg-ctrl-ic"><i class="fa-solid fa-key"></i></span>
            <span class="flex-1"><b>Vincular solo con código de mánager</b><small>Encendido: Phoenix Link ya no puede usar su propia vinculación</small></span>
            <input id="mg-exigir" type="checkbox" class="mg-switch">
          </label>
        </div>
      </section>

      <section class="mcx-admin-paso" aria-labelledby="mcx-admin-2">
        <h3 id="mcx-admin-2"><span class="mcx-admin-n">2</span> Clubes que juegan</h3>
        <p class="mcx-admin-ayuda">Enciende los clubes que participan. Un club encendido y sin DT lo maneja la IA: cualquier DT le puede fichar al momento. Si la lista está vacía, primero sube el catálogo que genera Phoenix Sync (los clubes entran apagados).</p>
        <label id="mg-drop" class="mg-drop" for="mg-json">
          <input id="mg-json" type="file" accept=".json,application/json" class="sr-only">
          <i class="fa-solid fa-file-import"></i>
          <b>Subir el catálogo de clubes y jugadores</b>
          <small>Arrastra aquí el archivo JSON de Phoenix Sync o haz clic para elegirlo</small>
        </label>
        <div id="mg-prev" hidden class="mg-prev"></div>
        <div class="mcx-admin-clubes-cab">
          <span id="mg-c-resumen" class="text-xs text-gray-400"></span>
          <label class="relative ml-auto"><i class="fa-solid fa-magnifying-glass absolute left-2.5 top-1/2 -translate-y-1/2 text-gray-500 text-[12px]"></i><input id="mg-c-buscar" type="search" placeholder="Buscar club…" class="field !min-h-9 !py-1 !pl-7 !text-xs w-44"></label>
          <button type="button" class="mg-chip" data-todos="1">Encender todos</button><button type="button" class="mg-chip" data-todos="0">Apagar todos</button>
        </div>
        <div id="mg-staff-clubes" class="mg-clubes-grid"></div>
      </section>

      <details class="mcx-admin-paso mcx-admin-avanzado">
        <summary><span class="mcx-admin-n">3</span><span class="min-w-0"><b>Herramientas avanzadas</b><small>Equivalencias entre parches y traspasos de la vida real. Solo hacen falta de vez en cuando.</small></span></summary>
        <div class="mcx-admin-avanzado-cuerpo">
      <!-- Equivalencias entre parches (informe de Phoenix Sync) -->
      <div id="eq" class="space-y-3">
        <p class="mcx-admin-ayuda">Cada parche de PES numera distinto a jugadores y clubes. Phoenix Sync informa a quién corresponde cada uno en cada parche; aquí confirmas los que quedaron «A revisar».</p>
        <div class="flex flex-wrap items-center gap-2">
          <h4 class="mg-caja-tit !mb-0"><i class="fa-solid fa-link"></i> Equivalencias entre parches</h4>
          <select id="eq-perfil" class="field !min-h-8 !py-1 !text-xs w-auto" aria-label="Parche"></select>
          <div class="flex gap-1">
            <button type="button" class="mg-chip" data-eq-tipo="jugadores" aria-pressed="true">Jugadores</button>
            <button type="button" class="mg-chip" data-eq-tipo="clubes" aria-pressed="false">Clubes</button>
          </div>
          <label class="relative ml-auto"><i class="fa-solid fa-magnifying-glass absolute left-2.5 top-1/2 -translate-y-1/2 text-gray-500 text-[12px]"></i><input id="eq-buscar" type="search" placeholder="Buscar nombre…" class="field !min-h-8 !py-1 !pl-7 !text-xs w-44"></label>
        </div>
        <div id="eq-conteo" class="flex flex-wrap gap-1.5"></div>
        <div id="eq-lista" class="space-y-2"></div>
        <button id="eq-mas" type="button" class="mg-chip" hidden>Cargar más</button>
      </div>

      <!-- Capa 1: traspasos reales por ventana -->
      <div id="tr" class="space-y-3">

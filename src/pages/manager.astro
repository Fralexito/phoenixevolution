          <select id="tr-tipo" name="tipo" class="field !min-h-9 !text-xs" aria-label="Tipo de movimiento"></select>
          <input name="de" inputmode="numeric" placeholder="Equipo de origen (ID)" class="field !min-h-9 !text-xs" aria-label="ID del equipo de origen">
          <input name="a" inputmode="numeric" placeholder="Equipo de destino (ID)" class="field !min-h-9 !text-xs" aria-label="ID del equipo de destino">
          <input name="nota" maxlength="200" placeholder="Nota (opcional)" class="field !min-h-9 !text-xs" aria-label="Nota">
          <button type="submit" class="btn btn-primary !min-h-9 !text-xs sm:col-span-2 lg:col-span-3"><i class="fa-solid fa-plus"></i> Guardar movimiento</button>
        </form>
        <div id="tr-lista" class="space-y-2"></div>
      </div>
        </div>
      </details>
    </section>

---
// MODO MÁNAGER (Liga Máster de la web): opcional y por jugador. Cada usuario puede activar su carrera de DT,
// elegir un club aprobado, y fichar/vender en ventanas. Los movimientos se reflejan en el juego vía option file (claude/liga-master-plan.md).
// BD: migración 079 (lm_*). Lógica: js/pages/manager.js. Conexión con el juego: /mercado/ (programa Phoenix Sync).
import Layout from '../layouts/Layout.astro';
import { FX } from '../data/experimento.js';
import Plegable from '../components/Plegable.astro';
const base = import.meta.env.BASE_URL;
const TABS = [['plantilla', 'fa-people-group', 'Plantilla'], ['mercado', 'fa-magnifying-glass-dollar', 'Mercado'], ['oficina', 'fa-envelope-open-text', 'Oficina'], ['movimientos', 'fa-right-left', 'Movimientos']];
---
<Layout title="Liga Máster" active="manager" description="Tu carrera de DT en la Galaxy League: club, presupuesto y fichajes que llegan al juego.">
  <div class={`max-w-6xl mx-auto px-4 sm:px-8 py-6 w-full space-y-6${FX.ligaMasterGalaxia ? ' lmg' : ''}`}>

    {FX.ligaMasterGalaxia ? (
      <Fragment>
        <!-- Ronda 279 (FX.ligaMasterGalaxia): cabecera galáctica, igual familia que Mi club. Mismos ids que usa manager.js -->
        <header id="mg-portada" class="mcg-hero lmg-hero">
          <div class="mcg-estrellas" aria-hidden="true"></div>
          <svg class="mcg-orbitas" viewBox="0 0 240 240" aria-hidden="true">
            <ellipse cx="120" cy="120" rx="112" ry="44" transform="rotate(-18 120 120)"/>
            <ellipse cx="120" cy="120" rx="88" ry="30" transform="rotate(24 120 120)"/>
            <circle class="mcg-luna" cx="226" cy="98" r="5"/><circle class="mcg-luna mcg-luna2" cx="40" cy="96" r="3.5"/>
          </svg>
          <div class="mcg-insignia lmg-insignia" aria-hidden="true"><i class="fa-solid fa-user-tie"></i></div>
          <div class="mcg-texto min-w-0">
            <div class="mcg-chips"><span class="mcg-chip mcg-beta">Beta · Liga Máster</span><span id="lmg-ventana" class="mcg-chip lmg-ventana"><i></i><b>Cargando…</b></span>{FX.clubUnificado && <span class="mcg-chip" id="mc-estado" data-estado="out"><i></i><b class="mcg-e-out">Phoenix Sync</b><b class="mcg-e-off">Juego sin conectar</b><b class="mcg-e-on">Juego conectado</b></span>}</div>
            <h1 class="mcg-titulo">{FX.clubUnificado ? 'Mi club' : 'Liga Máster'}</h1>
            <p class="mcg-sub">{FX.clubUnificado ? 'Todo tu club en un solo lugar: tu carrera de DT en la Galaxy (presupuesto, fichajes y ofertas) y el vestuario de tu partida de PES 2021, que Phoenix Sync aplica en el juego.' : 'Tu carrera de DT: eliges un club, manejas su presupuesto y fichas jugadores. Al cerrar cada ventana, los movimientos llegan al juego con el option file oficial.'}</p>
          </div>
          <div id="mg-club" class="lmg-club"></div>
        </header>
        <section id="mg-sin-sesion" class="mcg-panel mcg-acceso">
          <div><h2 class="mcg-h2">Activa tu carrera de DT</h2><p>Entra para elegir tu club y empezar a fichar.</p></div>
          <div class="flex flex-wrap gap-2"><button type="button" class="btn btn-primary" data-pr-auth="login"><i class="fa-solid fa-right-to-bracket"></i> Entrar</button><button type="button" class="btn btn-ghost" data-pr-auth="register"><i class="fa-solid fa-user-plus"></i> Crear cuenta</button></div>
        </section>
      </Fragment>
    ) : (
      <Fragment>
    <header id="mg-portada" class="mg-portada">
      <span class="text-[11px] font-display font-bold text-amber-300 uppercase tracking-widest bg-amber-500/10 px-2 py-0.5 rounded border border-amber-400/30">Beta · Galaxy League</span>
      <h1 class="text-3xl sm:text-5xl font-display font-extrabold text-white uppercase tracking-wider mt-2"><i class="fa-solid fa-user-tie text-galaxy-400 mr-2"></i>Liga Máster</h1>
      <p class="text-gray-300 text-sm mt-1 max-w-3xl">Tu carrera de DT: eliges un club, manejas su presupuesto y fichas jugadores. Al cerrar cada ventana, los movimientos llegan al juego con el option file oficial.</p>
      <div id="mg-club" class="mt-4"></div>
    </header>

    <p id="mg-sin-sesion" class="glass-panel rounded-2xl p-6 text-center text-sm text-gray-300">Inicia sesión para activar tu carrera de mánager.</p>

      </Fragment>
    )}

    {FX.clubUnificado && (
      <nav class="cu-modos" role="tablist" aria-label="Mi club">
        <button type="button" role="tab" data-modo="carrera" aria-selected="true"><i class="fa-solid fa-user-tie"></i><span><b>Carrera de DT</b><small>Club, fichajes y ofertas</small></span></button>
        <button type="button" role="tab" data-modo="vestuario" aria-selected="false"><i class="fa-solid fa-shirt"></i><span><b>Vestuario del juego</b><small>Fichas de tu partida de PES</small></span></button>
      </nav>
    )}
    <div id="cu-carrera" class="space-y-6">
    <!-- Sin club: elegir uno -->
    <section id="mg-elegir" hidden class="space-y-3">
      <p class="mcg-kicker lmg-only">El vestuario te espera</p>
      <h2 class="font-display font-bold text-white uppercase tracking-wider lmg-h2">Elige tu club</h2>
      <p class="text-xs text-gray-400">Es opcional: si no activas tu carrera, todo lo demás de la web sigue igual. Puedes dejar el club cuando quieras.</p>
      <div id="mg-clubes-libres" class="grid grid-cols-2 lg:grid-cols-4 gap-3"></div>
    </section>

    <!-- Con club -->
    <div id="mg-panel" hidden class="space-y-4">
      <nav class="mg-tabs" role="tablist">
        {TABS.map(([id, ic, t], i) => <a href={`#${id}`} role="tab" data-tab={id} aria-current={i === 0 ? 'page' : undefined}><i class={`fa-solid ${ic}`}></i>{t}</a>)}
      </nav>
      <section data-panel="plantilla" class="space-y-5"><div class="mg-herr"><div class="mg-lineas" role="group" aria-label="Ver solo una línea"><button type="button" data-linea="" aria-pressed="true">Todos</button><button type="button" data-linea="por" aria-pressed="false">Porteros</button><button type="button" data-linea="def" aria-pressed="false">Defensas</button><button type="button" data-linea="med" aria-pressed="false">Mediocampo</button><button type="button" data-linea="del" aria-pressed="false">Delanteros</button></div><div class="mg-herr-der"><label class="mg-orden" title="Ordenar"><i class="fa-solid fa-arrow-down-wide-short"></i><select data-orden aria-label="Ordenar por"><option value="media">Mejor media</option><option value="valor">Más caros</option><option value="edad">Más jóvenes</option><option value="nombre">Nombre (A-Z)</option></select></label><div class="mg-tam" role="group" aria-label="Tamaño de las cartas"><button type="button" data-tam="-1" aria-label="Cartas más pequeñas" title="Alejar"><i class="fa-solid fa-magnifying-glass-minus"></i></button><button type="button" data-tam="1" aria-label="Cartas más grandes" title="Agrandar"><i class="fa-solid fa-magnifying-glass-plus"></i></button></div><div class="mg-vista" role="group" aria-label="Cómo ver las cartas"><button type="button" data-vista="grande" aria-pressed="true" title="Cartas grandes"><i class="fa-solid fa-table-cells-large"></i><span>Grandes</span></button><button type="button" data-vista="compacta" aria-pressed="false" title="Lista compacta"><i class="fa-solid fa-list"></i><span>Compactas</span></button></div></div></div><div id="mg-plantilla" class="space-y-6"></div></section>
      <section data-panel="mercado" hidden class="space-y-4">
        <div class="mg-filtros">
          <label class="relative flex-1 min-w-48"><i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 text-xs"></i><input id="mg-buscar" type="search" placeholder="Buscar jugador…" class="field w-full !pl-8"></label>
          <select id="mg-pos" class="field w-32"><option value="">Posición</option>{['PT','DEC','LD','LI','MCD','MC','MO','MD','MI','ED','EI','SD','DC'].map((p) => <option>{p}</option>)}</select>
          <label class="mg-toggle"><input id="mg-libres" type="checkbox"><span><i class="fa-solid fa-unlock"></i> Solo libres</span></label>
        </div>
        <div class="mg-herr"><div class="mg-lineas" role="group" aria-label="Ver solo una línea"><button type="button" data-linea="" aria-pressed="true">Todos</button><button type="button" data-linea="por" aria-pressed="false">Porteros</button><button type="button" data-linea="def" aria-pressed="false">Defensas</button><button type="button" data-linea="med" aria-pressed="false">Mediocampo</button><button type="button" data-linea="del" aria-pressed="false">Delanteros</button></div><div class="mg-herr-der"><label class="mg-orden" title="Ordenar"><i class="fa-solid fa-arrow-down-wide-short"></i><select data-orden aria-label="Ordenar por"><option value="media">Mejor media</option><option value="valor">Más caros</option><option value="edad">Más jóvenes</option><option value="nombre">Nombre (A-Z)</option></select></label><div class="mg-tam" role="group" aria-label="Tamaño de las cartas"><button type="button" data-tam="-1" aria-label="Cartas más pequeñas" title="Alejar"><i class="fa-solid fa-magnifying-glass-minus"></i></button><button type="button" data-tam="1" aria-label="Cartas más grandes" title="Agrandar"><i class="fa-solid fa-magnifying-glass-plus"></i></button></div><div class="mg-vista" role="group" aria-label="Cómo ver las cartas"><button type="button" data-vista="grande" aria-pressed="true" title="Cartas grandes"><i class="fa-solid fa-table-cells-large"></i><span>Grandes</span></button><button type="button" data-vista="compacta" aria-pressed="false" title="Lista compacta"><i class="fa-solid fa-list"></i><span>Compactas</span></button></div></div></div>
        <div id="mg-mercado"></div>
      </section>
      <section data-panel="oficina" hidden class="grid md:grid-cols-2 gap-4">
        <div class="mg-caja"><h3 class="mg-caja-tit"><i class="fa-solid fa-inbox"></i> Ofertas recibidas</h3><div id="mg-recibidas" class="space-y-2"></div></div>
        <div class="mg-caja"><h3 class="mg-caja-tit"><i class="fa-solid fa-paper-plane"></i> Ofertas enviadas</h3><div id="mg-enviadas" class="space-y-2"></div></div>
      </section>
      <section data-panel="movimientos" hidden class="mg-caja"><h3 class="mg-caja-tit"><i class="fa-solid fa-right-left"></i> Diario de fichajes · Galaxy League</h3><div id="mg-movs"></div></section>
      <div class="flex flex-wrap gap-2 text-xs">
        <a href={`${base}mercado/`} class="btn btn-ghost !min-h-9 !text-xs"><i class="fa-solid fa-plug"></i> Conectar el juego (Phoenix Sync)</a>
        <button type="button" id="mg-dejar" class="btn btn-ghost !min-h-9 !text-xs !text-rose-300"><i class="fa-solid fa-door-open"></i> Dejar mi club</button>
      </div>
    </div>

    <!-- Staff: todo se guarda al instante (sin botón Guardar) -->
    <section id="mg-staff" hidden class="mg-staff">
      <header class="flex flex-wrap items-center gap-3">
        <h2 class="mg-staff-tit"><i class="fa-solid fa-shield-halved"></i> Centro de control</h2>
        <span class="text-[11px] text-gray-500">Staff · los cambios se guardan solos</span>
        <span id="mg-guardado" class="mg-guardado" aria-live="polite"></span>
      </header>

      <div class="mg-ctrl-grid">
        <!-- Ventana -->
        <label class="mg-ctrl mg-ctrl-ventana" for="mg-c-ventana">
          <span class="mg-ctrl-ic"><i class="fa-solid fa-door-open"></i></span>
          <span class="flex-1"><b>Ventana de fichajes</b><small id="mg-c-ventana-txt">—</small></span>
          <input id="mg-c-ventana" type="checkbox" class="mg-switch">
        </label>
        <!-- Exigir código -->
        <label class="mg-ctrl" for="mg-exigir">
          <span class="mg-ctrl-ic"><i class="fa-solid fa-key"></i></span>
          <span class="flex-1"><b>Exigir código manager</b><small>Phoenix Link no podrá usar su propia vinculación</small></span>
          <input id="mg-exigir" type="checkbox" class="mg-switch">
        </label>
        <!-- Presupuesto -->
        <div class="mg-ctrl mg-ctrl-col">
          <div class="flex items-center gap-3 w-full"><span class="mg-ctrl-ic"><i class="fa-solid fa-wallet"></i></span>
            <span class="flex-1"><b>Presupuesto inicial</b><small>Lo recibe cada DT al elegir club</small></span><output id="mg-c-presu-v" class="mg-ctrl-num">—</output></div>
          <input id="mg-c-presu" type="range" min="5000000" max="300000000" step="5000000" class="mg-range">
          <div class="flex flex-wrap gap-1.5">{[25, 50, 100, 200].map((m) => <button type="button" class="mg-chip" data-presu={m * 1e6}>€{m} M</button>)}</div>
        </div>
        <!-- Máx plantilla -->
        <div class="mg-ctrl">
          <span class="mg-ctrl-ic"><i class="fa-solid fa-people-group"></i></span>
          <span class="flex-1"><b>Máx. plantilla</b><small>Jugadores por club</small></span>
          <div class="mg-stepper"><button type="button" data-max="-1" aria-label="Menos">−</button><output id="mg-c-max">30</output><button type="button" data-max="1" aria-label="Más">+</button></div>
        </div>
      </div>

      <!-- Importar catálogo -->
      <label id="mg-drop" class="mg-drop" for="mg-json">
        <input id="mg-json" type="file" accept=".json,application/json" class="sr-only">
        <i class="fa-solid fa-file-import"></i>
        <b>Arrastra aquí el catálogo (JSON del programa)</b>
        <small>o haz clic para elegirlo · los clubes entran sin aprobar</small>
      </label>
      <div id="mg-prev" hidden class="mg-prev"></div>

      <!-- Clubes -->
      <div class="space-y-3">
        <div class="flex flex-wrap items-center gap-2">
          <h3 class="mg-caja-tit !mb-0"><i class="fa-solid fa-shield-halved"></i> Clubes</h3>
          <span id="mg-c-resumen" class="text-xs text-gray-400"></span>
          <label class="relative ml-auto"><i class="fa-solid fa-magnifying-glass absolute left-2.5 top-1/2 -translate-y-1/2 text-gray-500 text-[11px]"></i><input id="mg-c-buscar" type="search" placeholder="Buscar club…" class="field !min-h-8 !py-1 !pl-7 !text-xs w-44"></label>
          <button type="button" class="mg-chip" data-todos="1">Aprobar todos</button><button type="button" class="mg-chip" data-todos="0">Ninguno</button>
        </div>
        <div id="mg-staff-clubes" class="mg-clubes-grid"></div>
      </div>

      <!-- Equivalencias entre parches (informe de Phoenix Sync) -->
      <div id="eq" class="space-y-3">
        <div class="flex flex-wrap items-center gap-2">
          <h3 class="mg-caja-tit !mb-0"><i class="fa-solid fa-link"></i> Equivalencias entre parches</h3>
          <select id="eq-perfil" class="field !min-h-8 !py-1 !text-xs w-auto" aria-label="Parche"></select>
          <div class="flex gap-1">
            <button type="button" class="mg-chip" data-eq-tipo="jugadores" aria-pressed="true">Jugadores</button>
            <button type="button" class="mg-chip" data-eq-tipo="clubes" aria-pressed="false">Clubes</button>
          </div>
          <label class="relative ml-auto"><i class="fa-solid fa-magnifying-glass absolute left-2.5 top-1/2 -translate-y-1/2 text-gray-500 text-[11px]"></i><input id="eq-buscar" type="search" placeholder="Buscar nombre…" class="field !min-h-8 !py-1 !pl-7 !text-xs w-44"></label>
        </div>
        <div id="eq-conteo" class="flex flex-wrap gap-1.5"></div>
        <div id="eq-lista" class="space-y-2"></div>
        <button id="eq-mas" type="button" class="mg-chip" hidden>Cargar más</button>
      </div>

      <!-- Capa 1: traspasos reales por ventana -->
      <div id="tr" class="space-y-3">
        <div class="flex flex-wrap items-center gap-2">
          <h3 class="mg-caja-tit !mb-0"><i class="fa-solid fa-right-left"></i> Traspasos reales (Capa 1)</h3>
          <select id="tr-ventana" class="field !min-h-8 !py-1 !text-xs w-auto" aria-label="Ventana"></select>
          <button id="tr-nueva" type="button" class="mg-chip"><i class="fa-solid fa-plus"></i> Nueva ventana</button>
          <div id="tr-estado" class="flex gap-1 ml-auto"></div>
        </div>
        <p id="tr-resumen" class="text-xs text-gray-400"></p>
        <form id="tr-form" hidden class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3" autocomplete="off">
          <input name="pes_id" inputmode="numeric" placeholder="ID del jugador (pes_id)" class="field !min-h-9 !text-xs" aria-label="ID del jugador" required>
          <input name="jugador" maxlength="80" placeholder="Nombre del jugador" class="field !min-h-9 !text-xs" aria-label="Nombre del jugador" required>
          <select id="tr-tipo" name="tipo" class="field !min-h-9 !text-xs" aria-label="Tipo de movimiento"></select>
          <input name="de" inputmode="numeric" placeholder="Equipo de origen (ID)" class="field !min-h-9 !text-xs" aria-label="ID del equipo de origen">
          <input name="a" inputmode="numeric" placeholder="Equipo de destino (ID)" class="field !min-h-9 !text-xs" aria-label="ID del equipo de destino">
          <input name="nota" maxlength="200" placeholder="Nota (opcional)" class="field !min-h-9 !text-xs" aria-label="Nota">
          <button type="submit" class="btn btn-primary !min-h-9 !text-xs sm:col-span-2 lg:col-span-3"><i class="fa-solid fa-plus"></i> Guardar movimiento</button>
        </form>
        <div id="tr-lista" class="space-y-2"></div>
      </div>
    </section>
    </div>

    {FX.clubUnificado && (
      <div id="cu-vestuario" hidden class="space-y-4">
        <!-- Vestuario (antes /mi-club/): mismos ids que usa js/pages/miClub.js -->
        <p id="mc-sin-sesion" class="!hidden"></p>
        <div id="mc-vacio" hidden class="mcg-mision">
          <div class="mcg-panel mcg-pasos">
            <p class="mcg-kicker">Conecta tu partida</p>
            <h2 class="mcg-h2">Trae tu club desde PES 2021</h2>
            <ol class="mcg-ruta">
              <li><span class="mcg-planeta">1</span><div><b>Abre Phoenix Sync en tu PC</b><p>El programa que conecta tu partida de Liga Máster con la web.</p></div></li>
              <li><span class="mcg-planeta">2</span><div><b>Elige «Subir mi club a la web»</b><p>Sube tu plantilla, fichas y finanzas en segundos.</p></div></li>
              <li><span class="mcg-planeta">3</span><div><b>Edita aquí y juega</b><p>Dorsales, posiciones, habilidades… Phoenix Sync los aplica en tu partida.</p></div></li>
            </ol>
            <div class="mcg-acciones"><a class="btn btn-primary" href={`${base}mis-salas/`}><i class="fa-solid fa-desktop"></i> Vincular mi PC</a><a class="btn btn-ghost" href={`${base}mercado/`}><i class="fa-solid fa-plug"></i> Qué es Phoenix Sync</a></div>
          </div>
          <div class="mcg-panel mcg-vista" aria-hidden="true">
            <p class="mcg-kicker">Así se verá tu vestuario</p>
            <div class="mcg-fantasma">
              <div class="mcg-f-lista">{[['1','PT'],['4','DEC'],['8','MC'],['10','MO'],['7','ED'],['9','DC']].map(([n, p]) => <div class="mcg-f-fila"><span class="mcg-f-cara"></span><b>{n}</b><span class="mcg-f-linea"></span><small>{p}</small></div>)}</div>
              <div class="mcg-f-ficha"><div class="mcg-f-top"><span class="mcg-f-cara mcg-f-grande"></span><span class="mcg-f-linea w-24"></span><b class="mcg-f-media">84</b></div>
                {['Dorsal','Posición','Pie','Altura'].map((x) => <div class="mcg-f-campo"><small>{x}</small><span></span></div>)}
              </div>
            </div>
          </div>
        </div>
        <div id="mc-app" hidden class="space-y-4">
          <div id="mc-selector" class="flex flex-wrap gap-2" hidden></div>
          <section id="mc-cabecera" class="mc-cabecera glass-panel rounded-2xl p-4"></section>
          <div class="mc-cuerpo">
            <aside id="mc-plantilla" class="mc-plantilla" aria-label="Plantilla"></aside>
            <section id="mc-detalle" class="mc-detalle" aria-live="polite"></section>
          </div>
        </div>
        <div id="bz-card" hidden>
          <Plegable titulo="Mandar aviso a mi juego" icono="fa-bell" resumen="Sale en PES 2021 (barra espaciadora) con Phoenix Link abierto">
            <div class="space-y-3">
              <label class="block text-xs text-gray-300" for="bz-texto">Tu mensaje <span id="bz-contador" class="text-gray-400 ml-1">0/600</span></label>
              <textarea id="bz-texto" rows="3" maxlength="600" class="w-full rounded-lg bg-black/30 border border-white/15 p-2 text-sm text-white" placeholder="Ej.: Partido a las 9, conéctate"></textarea>
              <div class="flex flex-wrap items-center gap-2">
                <select id="bz-pc" class="rounded-lg bg-black/30 border border-white/15 p-2 text-sm text-white" aria-label="PC de destino"><option value="">Todas mis PCs</option></select>
                <button type="button" id="bz-enviar" class="btn btn-primary"><i class="fa-solid fa-paper-plane"></i> Enviar</button>
              </div>
              <div id="bz-lista" class="space-y-2" aria-live="polite"></div>
            </div>
          </Plegable>
        </div>
      </div>
    )}
  </div>
</Layout>
<script>import '../js/pages/manager.js'; import '../js/pages/managerEquivalencias.js'; import '../js/pages/managerTraspasosReales.js'; import '../js/features/clubUnificado.js';</script>

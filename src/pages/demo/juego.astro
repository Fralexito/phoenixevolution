---
// MUESTRA 1 · «Como un videojuego» (ronda 389). Portada rediseñada desde cero al estilo de los menús de EA FC / PES:
// menú de tarjetas grandes, carta del líder que se inclina en 3D con brillo, resultados como fichas y tabla tipo juego.
// Es una página APARTE para comparar: no toca la portada real. Datos reales de la Galaxy League (data/ligaResultados.js).
import Layout from '../../layouts/Layout.astro';
import '@fontsource/anton/400.css';
import { EDICIONES } from '../../data/ligaResultados.js';
import { CLUBES_VISUAL } from '../../data/clubesVisual.js';
import { resumenEdicion, iniciales, forma } from '../../js/core/portada/demoDatos.js';
import { escudoDe } from '../../js/core/sistema/escudos.js';
const base = import.meta.env.BASE_URL;
const ed = EDICIONES.galaxy[0];
const r = resumenEdicion(ed);
const lider = r.lider;
const vis = (club) => CLUBES_VISUAL[club] ?? { sigla: '???', a: '#334155', b: '#0f172a' };
const v = vis(lider?.club);
const formaLider = lider ? forma(ed, lider.nombre) : [];
const menu = [
  { t: 'Jugar un duelo', s: 'Reta a alguien ahora o agenda un partido', href: 'duelos/', ico: 'fa-gamepad' },
  { t: 'Mi club', s: 'Tu plantilla, fichajes y Liga Máster', href: 'manager/', ico: 'fa-shield-halved' },
  { t: 'Galaxy League', s: `Fecha ${r.ultima?.n ?? '—'} jugada · líder ${lider?.nombre ?? '—'}`, href: 'liga/', ico: 'fa-trophy' },
  { t: 'Comunidad', s: 'Social, clanes, jugadas y chat', href: 'social/', ico: 'fa-users' },
];
---
<Layout title="Muestra · Videojuego" active="" privada description="Muestra de diseño: la portada como el menú de un videojuego.">
  <div class="dj">
    <div class="dj-fondo" aria-hidden="true"><span class="dj-haz dj-haz1"></span><span class="dj-haz dj-haz2"></span><span class="dj-cancha"></span></div>

    <a class="dj-volver" href={`${base}demo/`}><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Las 3 muestras</a>

    <section class="dj-top" aria-labelledby="dj-titulo">
      <p class="dj-pre">Phoenix Evolution Series · Temporada 2026</p>
      <h1 id="dj-titulo" class="dj-titulo"><span>Galaxy</span> <span class="dj-acento">League</span></h1>
    </section>

    <div class="dj-grid">
      <nav class="dj-menu" aria-label="Menú principal" data-dj-menu>
        {menu.map((m, i) => (
          <a class="dj-op" href={`${base}${m.href}`} data-dj-op style={`--i:${i}`} aria-current={i === 0 ? 'true' : undefined}>
            <span class="dj-op-ico" data-ico-keep><i class={`fa-solid ${m.ico}`} aria-hidden="true"></i></span>
            <span class="dj-op-tx"><b>{m.t}</b><small>{m.s}</small></span>
            <i class="fa-solid fa-chevron-right dj-op-fl" aria-hidden="true"></i>
          </a>
        ))}
      </nav>

      {lider && (
        <a class="dj-carta-zona" href={`${base}liga/`} aria-label={`Líder de la Galaxy League: ${lider.nombre}, ${lider.pts} puntos`}>
          <div class="dj-carta" data-dj-carta style={`--ca:${v.a};--cb:${v.b}`}>
            <span class="dj-holo" aria-hidden="true"></span>
            <div class="dj-carta-cab">
              <span class="dj-rating">{lider.pts}<span class="dj-rating-et">PTS</span></span>
              <span class="dj-pos">1°</span>
            </div>
            <div class="dj-carta-escudo">
              {escudoDe(lider.club) ? <img src={escudoDe(lider.club)} alt="" width="120" height="120" loading="eager" decoding="async" /> : <span class="dj-mono">{iniciales(lider.nombre)}</span>}
            </div>
            <p class="dj-carta-nombre">{lider.nombre}</p>
            <p class="dj-carta-club">{lider.club} · Líder</p>
            <dl class="dj-stats">
              <div><dt>PJ</dt><dd>{lider.pj}</dd></div>
              <div><dt>G</dt><dd>{lider.g}</dd></div>
              <div><dt>GF</dt><dd>{lider.gf}</dd></div>
              <div><dt>GC</dt><dd>{lider.gc}</dd></div>
              <div><dt>DG</dt><dd>{lider.dg > 0 ? `+${lider.dg}` : lider.dg}</dd></div>
              <div><dt>Forma</dt><dd class="dj-forma">{formaLider.map((x) => <i class={`f-${x}`}>{x}</i>)}</dd></div>
            </dl>
          </div>
        </a>
      )}
    </div>

    {r.ultima && (
      <section class="dj-tira" aria-labelledby="dj-res">
        <div class="dj-tira-cab">
          <h2 id="dj-res">Fecha {r.ultima.n} · Resultados</h2>
          {r.proxima && <span class="dj-chip">Próxima: fecha {r.proxima}</span>}
        </div>
        <ul class="dj-fichas">
          {r.ultima.resultados.map((m, i) => (
            <li class="dj-ficha" style={`--i:${i}`}>
              <span class="dj-eq">{escudoDe(m.cl) && <img src={escudoDe(m.cl)} alt="" width="28" height="28" loading="lazy" decoding="async" />}<b>{m.l}</b></span>
              <span class="dj-marca"><b class={m.gl > m.gv ? 'gana' : ''}>{m.gl}</b><i>–</i><b class={m.gv > m.gl ? 'gana' : ''}>{m.gv}</b></span>
              <span class="dj-eq dj-eq-v"><b>{m.v}</b>{escudoDe(m.cv) && <img src={escudoDe(m.cv)} alt="" width="28" height="28" loading="lazy" decoding="async" />}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="dj-tabla" aria-labelledby="dj-tab">
      <div class="dj-tira-cab"><h2 id="dj-tab">Clasificación</h2><a class="dj-chip dj-chip-link" href={`${base}liga/`}>Tabla completa <i class="fa-solid fa-chevron-right" aria-hidden="true"></i></a></div>
      <ol class="dj-filas">
        {r.tabla.slice(0, 8).map((f) => (
          <li class={`dj-fila${f.pos <= 4 ? ' dj-top4' : ''}`}>
            <span class="dj-n">{f.pos}</span>
            <span class="dj-fila-eq">{escudoDe(f.club) && <img src={escudoDe(f.club)} alt="" width="22" height="22" loading="lazy" decoding="async" />}<b>{f.nombre}</b><small>{f.club}</small></span>
            <span class="dj-c">{f.pj}</span><span class="dj-c">{f.dg > 0 ? `+${f.dg}` : f.dg}</span><span class="dj-pts">{f.pts}</span>
          </li>
        ))}
      </ol>
    </section>
  </div>
</Layout>

<script>
  // Carta que se inclina hacia el mouse/dedo y menú que se recorre con las flechas del teclado (como en un juego).
  const quieto = () => matchMedia('(prefers-reduced-motion: reduce)').matches || document.documentElement.getAttribute('data-aj-mov-efectivo') === 'reducido';
  const carta = document.querySelector<HTMLElement>('[data-dj-carta]');
  if (carta && !quieto()) {
    let raf = 0;
    const mover = (x: number, y: number) => {
      const r = carta.getBoundingClientRect();
      const px = Math.min(1, Math.max(0, (x - r.left) / r.width)); const py = Math.min(1, Math.max(0, (y - r.top) / r.height));
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => {
        carta.style.setProperty('--rx', `${(0.5 - py) * 14}deg`); carta.style.setProperty('--ry', `${(px - 0.5) * 18}deg`);
        carta.style.setProperty('--hx', `${px * 100}%`); carta.style.setProperty('--hy', `${py * 100}%`);
      });
    };
    const zona = carta.parentElement!;
    zona.addEventListener('pointermove', (e) => mover(e.clientX, e.clientY));
    zona.addEventListener('pointerleave', () => { carta.style.setProperty('--rx', '0deg'); carta.style.setProperty('--ry', '0deg'); });
  }
  const ops = [...document.querySelectorAll<HTMLAnchorElement>('[data-dj-op]')];
  const marcar = (el: HTMLAnchorElement) => ops.forEach((o) => (o === el ? o.setAttribute('aria-current', 'true') : o.removeAttribute('aria-current')));
  ops.forEach((o, i) => {
    o.addEventListener('pointerenter', () => marcar(o));
    o.addEventListener('focus', () => marcar(o));
    o.addEventListener('keydown', (e) => {
      const d = e.key === 'ArrowDown' ? 1 : e.key === 'ArrowUp' ? -1 : 0; if (!d) return;
      e.preventDefault(); ops[(i + d + ops.length) % ops.length].focus();
    });
  });
</script>

<style>
  .dj { --lima: oklch(0.91 0.21 128); --tinta: oklch(0.97 0 0); --gris: oklch(0.76 0.01 260); --fondo: oklch(0.12 0.01 260);
        position: relative; isolation: isolate; overflow: hidden; min-height: calc(100svh - 120px); padding: 18px 16px 48px; color: var(--tinta);
        background: var(--fondo); font-family: var(--font-sans); }
  .dj-fondo { position: absolute; inset: 0; z-index: -1; pointer-events: none; overflow: hidden;
              background: radial-gradient(120% 70% at 70% 0%, oklch(0.3 0.06 140 / .55), transparent 60%), radial-gradient(90% 60% at 0% 100%, oklch(0.25 0.05 270 / .6), transparent 70%); }
  .dj-haz { position: absolute; top: -30%; width: 38vw; height: 160%; background: linear-gradient(90deg, transparent, oklch(1 0 0 / .07), transparent); transform: rotate(18deg); filter: blur(6px); }
  .dj-haz1 { left: 8%; animation: dj-haz 14s cubic-bezier(.45, 0, .55, 1) infinite alternate; }
  .dj-haz2 { left: 58%; animation: dj-haz 18s cubic-bezier(.45, 0, .55, 1) -6s infinite alternate; opacity: .7; }
  @keyframes dj-haz { to { transform: translateX(10vw) rotate(24deg); } }
  /* Cancha de verdad (líneas del campo en perspectiva): es la escena, no un fondo decorativo */
  .dj-cancha { position: absolute; left: 50%; top: 260px; width: 160%; height: 620px; transform: translateX(-50%) perspective(600px) rotateX(62deg);
               border: 2px solid oklch(1 0 0 / .08); border-radius: 4px;
               background: radial-gradient(circle at 50% 50%, transparent 0 11%, oklch(1 0 0 / .08) 11% calc(11% + 2px), transparent calc(11% + 2px)), linear-gradient(90deg, transparent calc(50% - 1px), oklch(1 0 0 / .08) calc(50% - 1px) calc(50% + 1px), transparent calc(50% + 1px)); }

  .dj-volver { display: inline-flex; align-items: center; gap: .5rem; font-size: 13px; color: var(--gris); padding: .4rem .2rem; }
  .dj-volver:hover { color: var(--tinta); }
  .dj-top { margin: 10px 0 22px; }
  .dj-pre { font: 600 13px/1.2 var(--font-sans); color: var(--gris); letter-spacing: .02em; }
  .dj-titulo { font: 400 clamp(3rem, 13vw, 6rem)/.9 'Anton', 'Oswald', sans-serif; text-transform: uppercase; letter-spacing: .01em; margin-top: 6px; }
  .dj-titulo span { display: inline-block; animation: dj-sube .8s cubic-bezier(.16, 1, .3, 1) both; }
  .dj-titulo span + span { animation-delay: .08s; }
  .dj-acento { color: var(--lima); }
  @keyframes dj-sube { from { transform: translateY(40%) skewY(4deg); opacity: 0; } }

  .dj-grid { display: grid; gap: 22px; align-items: start; }
  @media (min-width: 900px) { .dj-grid { grid-template-columns: minmax(0, 1fr) 320px; gap: 40px; } .dj { padding: 26px 40px 64px; } }

  /* Menú: tarjetas inclinadas; la elegida se llena de lima desde la izquierda */
  .dj-menu { display: grid; gap: 10px; }
  .dj-op { position: relative; display: flex; align-items: center; gap: 14px; padding: 16px 18px; color: var(--tinta);
           background: oklch(1 0 0 / .05); clip-path: polygon(14px 0, 100% 0, calc(100% - 14px) 100%, 0 100%);
           transition: transform .22s cubic-bezier(.16, 1, .3, 1), color .18s;
           animation: dj-entra .6s cubic-bezier(.16, 1, .3, 1) both; animation-delay: calc(.15s + var(--i) * .07s); }
  @keyframes dj-entra { from { transform: translateX(-24px); opacity: 0; } }
  .dj-op::before { content: ''; position: absolute; inset: 0; z-index: -1; background: var(--lima); transform: scaleX(0); transform-origin: left; transition: transform .28s cubic-bezier(.16, 1, .3, 1); }
  .dj-op[aria-current='true'] { color: oklch(0.16 0.02 140); transform: translateX(8px); }
  .dj-op[aria-current='true']::before { transform: scaleX(1); }
  .dj-op:focus-visible { outline: 2px solid var(--lima); outline-offset: 3px; }
  .dj-op-ico { flex: none; display: grid; place-items: center; width: 44px; height: 44px; font-size: 18px; background: oklch(0 0 0 / .25); clip-path: polygon(8px 0, 100% 0, calc(100% - 8px) 100%, 0 100%); }
  .dj-op-tx { flex: 1; min-width: 0; display: grid; gap: 2px; }
  .dj-op-tx b { font: 400 clamp(1.35rem, 5vw, 1.9rem)/1 'Anton', 'Oswald', sans-serif; text-transform: uppercase; letter-spacing: .02em; }
  .dj-op-tx small { font-size: 13px; opacity: .8; }
  .dj-op-fl { opacity: 0; transform: translateX(-8px); transition: opacity .2s, transform .2s; }
  .dj-op[aria-current='true'] .dj-op-fl { opacity: 1; transform: none; }

  /* Carta del líder: colores de su club, rating = puntos, se inclina en 3D y brilla */
  .dj-carta-zona { display: block; perspective: 900px; justify-self: center; width: min(300px, 72vw); order: -1; }
  @media (min-width: 900px) { .dj-carta-zona { order: 0; } }
  .dj-carta { --rx: 0deg; --ry: 0deg; --hx: 50%; --hy: 30%; position: relative; overflow: hidden; padding: 18px 18px 20px; border-radius: 14px 14px 40px 40px;
              background: linear-gradient(160deg, var(--ca), var(--cb) 70%), var(--cb); color: #fff;
              box-shadow: 0 30px 60px -24px oklch(0 0 0 / .9), inset 0 0 0 1px oklch(1 0 0 / .18);
              transform: rotateX(var(--rx)) rotateY(var(--ry)); transition: transform .5s cubic-bezier(.16, 1, .3, 1);
              animation: dj-carta 1s cubic-bezier(.16, 1, .3, 1) .2s both; }
  @keyframes dj-carta { from { transform: rotateY(-35deg) translateY(30px); opacity: 0; } }
  .dj-holo { position: absolute; inset: 0; pointer-events: none; mix-blend-mode: overlay;
             background: radial-gradient(circle at var(--hx) var(--hy), oklch(1 0 0 / .55), transparent 45%), linear-gradient(115deg, transparent 35%, oklch(1 0 0 / .25) 50%, transparent 65%); }
  .dj-carta-cab { display: flex; justify-content: space-between; align-items: flex-start; }
  .dj-rating { font: 400 3.4rem/.9 'Anton', 'Oswald', sans-serif; text-shadow: 0 2px 10px oklch(0 0 0 / .35); }
  .dj-rating-et { display: block; font: 700 12px/1 var(--font-sans) !important; letter-spacing: .12em; opacity: .85; margin-top: 4px; }
  .dj-pos { font: 400 1.6rem/1 'Anton', sans-serif; padding: 6px 10px; background: oklch(0 0 0 / .3); border-radius: 8px; }
  .dj-carta-escudo { display: grid; place-items: center; height: 150px; margin: 4px 0 6px; }
  .dj-carta-escudo img { width: 120px; height: 120px; object-fit: contain; filter: drop-shadow(0 10px 20px oklch(0 0 0 / .5)); }
  .dj-mono { font: 400 4rem/1 'Anton', sans-serif; }
  .dj-carta-nombre { text-align: center; font: 400 2rem/1 'Anton', 'Oswald', sans-serif; text-transform: uppercase; letter-spacing: .03em; }
  .dj-carta-club { text-align: center; font-size: 13px; opacity: .85; margin-top: 4px; }
  .dj-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px 6px; margin-top: 14px; padding-top: 12px; border-top: 1px solid oklch(1 0 0 / .25); }
  .dj-stats div { text-align: center; }
  .dj-stats dt { font: 700 12px/1 var(--font-sans); letter-spacing: .08em; opacity: .8; }
  .dj-stats dd { font: 400 1.35rem/1.15 'Anton', sans-serif; }
  .dj-forma { display: flex; justify-content: center; gap: 2px; }
  .dj-forma i { font: 700 11px/18px var(--font-sans); width: 16px; border-radius: 4px; font-style: normal; }
  .f-V { background: oklch(0.72 0.18 150); } .f-E { background: oklch(0.7 0.02 260); } .f-D { background: oklch(0.62 0.2 25); }

  /* Resultados como fichas que se deslizan de lado */
  .dj-tira, .dj-tabla { margin-top: 30px; }
  .dj-tira-cab { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 12px; }
  .dj-tira-cab h2 { font: 400 1.6rem/1 'Anton', 'Oswald', sans-serif; text-transform: uppercase; letter-spacing: .02em; }
  .dj-chip { font: 700 12px/1 var(--font-sans); padding: 8px 12px; background: oklch(1 0 0 / .08); border-radius: 999px; color: var(--tinta); }
  .dj-chip-link:hover { background: var(--lima); color: oklch(0.16 0.02 140); }
  .dj-fichas { display: flex; gap: 10px; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 6px; scrollbar-width: none; margin: 0 -16px; padding-inline: 16px; }
  .dj-fichas::-webkit-scrollbar { display: none; }
  .dj-ficha { flex: none; scroll-snap-align: start; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 10px; min-width: 270px;
              padding: 14px; background: oklch(1 0 0 / .05); border-radius: 10px; animation: dj-entra .6s cubic-bezier(.16, 1, .3, 1) both; animation-delay: calc(.35s + var(--i) * .06s);
              transition: background-color .2s, transform .2s cubic-bezier(.16, 1, .3, 1); }
  .dj-ficha:hover { background: oklch(1 0 0 / .1); transform: translateY(-3px); }
  .dj-eq { display: flex; align-items: center; gap: 8px; min-width: 0; }
  .dj-eq b { font-weight: 700; font-size: 14px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .dj-eq-v { justify-content: flex-end; }
  .dj-eq img { width: 28px; height: 28px; object-fit: contain; flex: none; }
  .dj-marca { display: flex; align-items: center; gap: 4px; font: 400 1.6rem/1 'Anton', sans-serif; }
  .dj-marca b { color: var(--gris); font-weight: 400; } .dj-marca b.gana { color: var(--lima); } .dj-marca i { font-style: normal; opacity: .5; }

  .dj-filas { display: grid; gap: 6px; }
  .dj-fila { display: grid; grid-template-columns: 34px minmax(0, 1fr) 34px 44px 48px; align-items: center; gap: 8px; padding: 10px 12px; background: oklch(1 0 0 / .04); border-radius: 8px; transition: background-color .2s, transform .2s cubic-bezier(.16, 1, .3, 1); }
  .dj-fila:hover { background: oklch(1 0 0 / .09); transform: translateX(4px); }
  .dj-n { font: 400 1.2rem/1 'Anton', sans-serif; color: var(--gris); }
  .dj-top4 .dj-n { color: var(--lima); }
  .dj-fila-eq { display: flex; align-items: center; gap: 8px; min-width: 0; }
  .dj-fila-eq img { width: 22px; height: 22px; object-fit: contain; flex: none; }
  .dj-fila-eq b { font-weight: 700; font-size: 14px; }
  .dj-fila-eq small { font-size: 12px; color: var(--gris); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .dj-c { text-align: center; font-size: 13px; color: var(--gris); font-variant-numeric: tabular-nums; }
  .dj-pts { text-align: right; font: 400 1.3rem/1 'Anton', sans-serif; }

  @media (prefers-reduced-motion: reduce) {
    .dj *, .dj *::before { animation: none !important; transition: none !important; }
  }
  :global(:root[data-aj-mov-efectivo='reducido']) .dj *, :global(:root[data-aj-mov-efectivo='reducido']) .dj *::before { animation: none !important; transition: none !important; }
</style>

---
// Las 3 muestras de rediseño de la portada (ronda 389). Páginas aparte para comparar; la portada real no cambia.
import Layout from '../../layouts/Layout.astro';
import '@fontsource/anton/400.css';
import '@fontsource/oswald/latin-600.css';
const base = import.meta.env.BASE_URL;
const muestras = [
  { href: 'demo/juego/', t: 'Como un videojuego', d: 'Menú de tarjetas grandes como EA FC o PES, la carta del líder que se inclina en 3D y resultados como fichas.', c: 'dm-juego' },
  { href: 'demo/tv/', t: 'Como una transmisión de TV', d: 'Rótulo «En directo» con reloj, marcadores tipo televisión, tabla de estudio y cinta de resultados que corre.', c: 'dm-tv' },
  { href: 'demo/app/', t: 'Como una app de deportes', d: 'Clara y limpia para el celular: tarjeta del líder, pestañas Partidos · Tabla · Datos y fechas que se recorren deslizando.', c: 'dm-app' },
];
---
<Layout title="Muestras de diseño" active="" privada description="Tres formas distintas de rediseñar la portada de Phoenix Evolution Series.">
  <div class="dm">
    <h1>Tres muestras de la portada</h1>
    <p class="dm-intro">Cada una es la portada rediseñada desde cero con un estilo distinto, con los datos reales de la Galaxy League. Son páginas aparte: la web de siempre no cambia. Ábrelas, juega con ellas y dime cuál te gusta más (o qué tomar de cada una).</p>
    <ul class="dm-lista">
      {muestras.map((m, i) => (
        <li><a class={`dm-carta ${m.c}`} href={`${base}${m.href}`}><span class="dm-n">Muestra {i + 1}</span><b>{m.t}</b><span class="dm-d">{m.d}</span><span class="dm-ir">Abrir <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span></a></li>
      ))}
    </ul>
  </div>
</Layout>
<style>
  .dm { max-width: 980px; margin: 0 auto; padding: 24px 16px 48px; }
  .dm h1 { font: 700 clamp(1.8rem, 6vw, 2.6rem)/1.1 var(--font-display); color: #fff; text-wrap: balance; }
  .dm-intro { margin-top: 10px; max-width: 65ch; color: #cbd5e1; line-height: 1.55; }
  .dm-lista { display: grid; gap: 14px; margin-top: 24px; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
  .dm-carta { display: grid; gap: 10px; height: 100%; padding: 20px; border-radius: 14px; transition: transform .25s cubic-bezier(.22, 1, .36, 1), box-shadow .25s; }
  .dm-carta:hover { transform: translateY(-4px); }
  .dm-carta:active { transform: scale(.98); }
  .dm-carta b { font-size: 1.35rem; line-height: 1.15; }
  .dm-n { font-size: 12px; font-weight: 700; opacity: .75; }
  .dm-d { font-size: 14px; line-height: 1.5; opacity: .9; }
  .dm-ir { margin-top: auto; font-weight: 700; font-size: 14px; display: inline-flex; gap: .5rem; align-items: center; }
  .dm-juego { background: oklch(0.14 0.01 260); color: #fff; box-shadow: inset 0 0 0 2px oklch(0.91 0.21 128); }
  .dm-juego b { font-family: 'Anton', 'Oswald', sans-serif; font-weight: 400; text-transform: uppercase; color: oklch(0.91 0.21 128); font-size: 1.6rem; }
  .dm-tv { background: linear-gradient(140deg, oklch(0.32 0.12 262), oklch(0.15 0.05 265)); color: oklch(0.93 0.01 250); }
  .dm-tv b { font-family: 'Oswald', sans-serif; text-transform: uppercase; font-weight: 600; }
  .dm-app { background: #fff; color: oklch(0.2 0.02 270); }
  .dm-app .dm-ir { color: oklch(0.5 0.23 290); }
</style>

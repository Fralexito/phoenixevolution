---
// MUESTRA 2 · «Como una transmisión de TV» (ronda 389). La portada como la previa de un partido en televisión: rótulo «En directo»
// con reloj, título que entra como gráfico de TV, marcadores tipo «score bug», tabla como gráfico de estudio, datos de la temporada
// como rótulos y cinta de resultados abajo. Página APARTE para comparar; datos reales de la Galaxy League.
import Layout from '../../layouts/Layout.astro';
import '@fontsource/oswald/latin-500.css';
import '@fontsource/oswald/latin-600.css';
import { EDICIONES } from '../../data/ligaResultados.js';
import { resumenEdicion } from '../../js/core/portada/demoDatos.js';
import { escudoDe } from '../../js/core/sistema/escudos.js';
const base = import.meta.env.BASE_URL;
const ed = EDICIONES.galaxy[0];
const r = resumenEdicion(ed);
const dg = (n) => (n > 0 ? `+${n}` : String(n));
const esc = (c, px) => (escudoDe(c) ? `<img src="${escudoDe(c)}" alt="" width="${px}" height="${px}" loading="lazy" decoding="async">` : '');
const cinta = [...(r.ultima?.resultados ?? [])].map((m) => `${m.l} ${m.gl}-${m.gv} ${m.v}`);
---
<Layout title="Muestra · Transmisión" active="" privada description="Muestra de diseño: la portada como una transmisión de TV.">
  <div class="tv">
    <div class="tv-cielo" aria-hidden="true"></div>

    <div class="tv-barra">
      <a class="tv-volver" href={`${base}demo/`}><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Las 3 muestras</a>
      <div class="tv-bug"><span class="tv-directo"><i aria-hidden="true"></i>En directo</span><span class="tv-bug-t">Galaxy League · Fecha {r.ultima?.n ?? '—'}</span><time class="tv-reloj" data-tv-reloj>--:--</time></div>
    </div>

    <section class="tv-intro" aria-labelledby="tv-titulo">
      <p class="tv-sobre"><span>Phoenix Evolution Series</span></p>
      <h1 id="tv-titulo" class="tv-titulo"><span class="tv-l1">La noche de la</span><span class="tv-l2">Galaxy League</span></h1>
      <p class="tv-bajada">{r.lider ? `${r.lider.nombre} lidera con ${r.lider.pts} puntos tras ${r.cifras.fechas} fechas. ${r.cifras.goles} goles en ${r.cifras.partidos} partidos.` : 'La temporada está por empezar.'}</p>
      <div class="tv-acciones" data-ico-keep>
        <a class="tv-btn tv-btn-p" href={`${base}en-vivo/`}><i class="fa-solid fa-tower-broadcast" aria-hidden="true"></i> Ver partidos en vivo</a>
        <a class="tv-btn" href={`${base}duelos/`}>Jugar un duelo</a>
      </div>
    </section>

    <div class="tv-cols">
      {r.ultima && (
        <section class="tv-bloque" aria-labelledby="tv-res">
          <h2 id="tv-res" class="tv-rotulo"><span>Resultados</span><small>Fecha {r.ultima.n}</small></h2>
          <ul class="tv-marcadores">
            {r.ultima.resultados.map((m, i) => (
              <li class="tv-sb" style={`--i:${i}`}>
                <span class="tv-sb-eq"><span set:html={esc(m.cl, 26)} /><b>{m.l}</b></span>
                <span class="tv-sb-res"><b>{m.gl}</b><b>{m.gv}</b></span>
                <span class="tv-sb-eq tv-sb-v"><b>{m.v}</b><span set:html={esc(m.cv, 26)} /></span>
                <span class="tv-sb-fin">Final</span>
              </li>
            ))}
          </ul>
        </section>
      )}

      <section class="tv-bloque" aria-labelledby="tv-tab">
        <h2 id="tv-tab" class="tv-rotulo"><span>Clasificación</span><small>Top 8</small></h2>
        <table class="tv-tabla">
          <thead><tr><th scope="col"><span class="sr-only">Puesto</span></th><th scope="col">Jugador</th><th scope="col">PJ</th><th scope="col">DG</th><th scope="col">Pts</th></tr></thead>
          <tbody>
            {r.tabla.slice(0, 8).map((f, i) => (
              <tr style={`--i:${i}`} class={f.pos <= 4 ? 'tv-cl' : ''}>
                <td class="tv-p">{f.pos}</td>
                <td><span class="tv-tj"><span set:html={esc(f.club, 22)} /><b>{f.nombre}</b></span></td>
                <td>{f.pj}</td><td>{dg(f.dg)}</td><td class="tv-pts">{f.pts}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="tv-nota"><i class="tv-punto" aria-hidden="true"></i> Puestos de clasificación a la siguiente fase</p>
      </section>
    </div>

    <section class="tv-datos" aria-labelledby="tv-dat">
      <h2 id="tv-dat" class="tv-rotulo"><span>Datos de la temporada</span></h2>
      <div class="tv-tercios">
        {r.goleada && (
          <article class="tv-tercio" style="--i:0">
            <p class="tv-tercio-et">Mayor goleada</p>
            <p class="tv-tercio-v">{r.goleada.l} <b>{r.goleada.gl}-{r.goleada.gv}</b> {r.goleada.v}</p>
            <p class="tv-tercio-s">Fecha {r.goleada.fecha}</p>
          </article>
        )}
        {r.masGoles && (
          <article class="tv-tercio" style="--i:1">
            <p class="tv-tercio-et">Ataque más fuerte</p>
            <p class="tv-tercio-v">{r.masGoles.nombre} <b>{r.masGoles.gf}</b> goles</p>
            <p class="tv-tercio-s">{r.masGoles.club}</p>
          </article>
        )}
        {r.muro && (
          <article class="tv-tercio" style="--i:2">
            <p class="tv-tercio-et">Mejor defensa</p>
            <p class="tv-tercio-v">{r.muro.nombre} <b>{r.muro.gc}</b> en contra</p>
            <p class="tv-tercio-s">en {r.muro.pj} partidos</p>
          </article>
        )}
      </div>
    </section>

    {r.partidosProxima.length > 0 && (
      <section class="tv-bloque" aria-labelledby="tv-prox">
        <h2 id="tv-prox" class="tv-rotulo"><span>Próxima fecha</span><small>Fecha {r.proxima}</small></h2>
        <ul class="tv-vs">
          {r.partidosProxima.map((m) => (
            <li><span class="tv-sb-eq"><span set:html={esc(m.cl, 22)} /><b>{m.l}</b></span><i>vs</i><span class="tv-sb-eq tv-sb-v"><b>{m.v}</b><span set:html={esc(m.cv, 22)} /></span></li>
          ))}
        </ul>
      </section>
    )}

    {cinta.length > 0 && (
      <div class="tv-cinta" aria-label="Resultados de la última fecha"><div class="tv-cinta-in">
        {[0, 1].map((k) => <span aria-hidden={k === 1 ? 'true' : undefined}>{cinta.map((t) => <em>{t}</em>)}</span>)}
      </div></div>
    )}
  </div>
</Layout>

<script>
  // Reloj de la transmisión (hora de Lima)
  const el = document.querySelector('[data-tv-reloj]');
  const pintar = () => { if (el) el.textContent = new Date().toLocaleTimeString('es-PE', { hour: '2-digit', minute: '2-digit', timeZone: 'America/Lima' }); };
  pintar(); setInterval(pintar, 15000);
</script>

<style>
  .tv { --azul: oklch(0.15 0.05 265); --azul2: oklch(0.21 0.07 265); --plata: oklch(0.93 0.01 250); --plata2: oklch(0.78 0.02 255); --oro: oklch(0.83 0.13 85); --rojo: oklch(0.62 0.22 25);
        position: relative; isolation: isolate; overflow: hidden; padding: 14px 16px 0; color: var(--plata); font-family: var(--font-sans);
        background: radial-gradient(140% 60% at 50% -5%, oklch(0.34 0.12 262), var(--azul) 60%), var(--azul); }
  @media (min-width: 900px) { .tv { padding: 20px 40px 0; } }
  /* Cielo de estudio: puntitos de luz que giran muy lento detrás del contenido */
  .tv-cielo { position: absolute; inset: -40% -40% auto; height: 180%; z-index: -1; pointer-events: none; opacity: .55;
              background-image: radial-gradient(1.5px 1.5px at 20px 30px, #fff, transparent), radial-gradient(1px 1px at 90px 120px, #fff, transparent), radial-gradient(1.2px 1.2px at 160px 60px, #fff, transparent), radial-gradient(1px 1px at 230px 180px, #fff, transparent);
              background-size: 260px 220px; animation: tv-gira 160s linear infinite; mask-image: radial-gradient(circle at 50% 20%, #000 20%, transparent 70%); }
  @keyframes tv-gira { to { transform: rotate(360deg); } }

  .tv-barra { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px; }
  .tv-volver { font-size: 13px; color: var(--plata2); display: inline-flex; gap: .5rem; align-items: center; }
  .tv-volver:hover { color: #fff; }
  .tv-bug { display: inline-flex; align-items: stretch; font: 600 12px/1 'Oswald', var(--font-display); letter-spacing: .08em; text-transform: uppercase; box-shadow: 0 8px 24px -10px #000; animation: tv-wipe .7s cubic-bezier(.16, 1, .3, 1) both; }
  .tv-directo { display: inline-flex; align-items: center; gap: 6px; padding: 8px 10px; background: var(--rojo); color: #fff; }
  .tv-directo i { width: 7px; height: 7px; border-radius: 50%; background: #fff; animation: tv-late 1.4s ease-in-out infinite; }
  @keyframes tv-late { 50% { opacity: .25; } }
  .tv-bug-t { padding: 8px 12px; background: var(--plata); color: var(--azul); }
  .tv-reloj { padding: 8px 10px; background: var(--azul2); color: var(--plata); font-variant-numeric: tabular-nums; }
  @keyframes tv-wipe { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 0 0 0); } }

  .tv-intro { padding: 34px 0 26px; max-width: 760px; }
  .tv-sobre span { display: inline-block; font: 600 13px/1 'Oswald', sans-serif; letter-spacing: .14em; text-transform: uppercase; color: var(--oro); padding-bottom: 8px; border-bottom: 2px solid var(--oro); animation: tv-wipe .8s cubic-bezier(.16, 1, .3, 1) .1s both; }
  .tv-titulo { margin-top: 14px; font-family: 'Oswald', sans-serif; text-transform: uppercase; line-height: .95; }
  .tv-l1 { display: block; font-weight: 500; font-size: clamp(1.4rem, 5.5vw, 2.4rem); color: var(--plata2); letter-spacing: .04em; animation: tv-sube .8s cubic-bezier(.16, 1, .3, 1) .2s both; }
  .tv-l2 { display: block; font-weight: 600; font-size: clamp(2.8rem, 12vw, 5.6rem); color: #fff; letter-spacing: .01em; animation: tv-sube .9s cubic-bezier(.16, 1, .3, 1) .3s both; }
  @keyframes tv-sube { from { transform: translateY(30px); opacity: 0; clip-path: inset(0 0 100% 0); } to { clip-path: inset(0 0 -10% 0); } }
  .tv-bajada { margin-top: 14px; font-size: 1rem; line-height: 1.55; color: var(--plata2); max-width: 60ch; animation: tv-sube .9s cubic-bezier(.16, 1, .3, 1) .45s both; }
  .tv-acciones { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 22px; animation: tv-sube .9s cubic-bezier(.16, 1, .3, 1) .55s both; }
  .tv-btn { display: inline-flex; align-items: center; gap: 8px; min-height: 46px; padding: 0 20px; border-radius: 999px; font: 600 14px/1 'Oswald', sans-serif; letter-spacing: .08em; text-transform: uppercase;
            color: #fff; box-shadow: inset 0 0 0 1px oklch(1 0 0 / .3); transition: background-color .25s, color .25s, transform .2s cubic-bezier(.16, 1, .3, 1); }
  .tv-btn:hover { background: oklch(1 0 0 / .1); }
  .tv-btn:active { transform: scale(.97); }
  .tv-btn-p { background: var(--plata); color: var(--azul); box-shadow: none; }
  .tv-btn-p:hover { background: #fff; }

  .tv-cols { display: grid; gap: 28px; }
  @media (min-width: 1000px) { .tv-cols { grid-template-columns: 1fr 1fr; gap: 40px; } }
  .tv-bloque, .tv-datos { margin-bottom: 30px; }
  /* Rótulo de TV: barra plateada con la palabra, el subtítulo en una pestaña azul */
  .tv-rotulo { display: inline-flex; align-items: stretch; margin-bottom: 14px; font-family: 'Oswald', sans-serif; text-transform: uppercase; }
  .tv-rotulo span { padding: 8px 14px; background: var(--plata); color: var(--azul); font-weight: 600; font-size: 1.1rem; letter-spacing: .06em; }
  .tv-rotulo small { display: grid; place-items: center; padding: 0 12px; background: var(--azul2); color: var(--oro); font-weight: 500; font-size: 12px; letter-spacing: .12em; }

  /* Marcadores tipo «score bug» */
  .tv-marcadores { display: grid; gap: 8px; }
  .tv-sb { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: center; gap: 10px; padding: 10px 12px;
           background: linear-gradient(90deg, var(--azul2), oklch(0.18 0.06 265)); box-shadow: inset 0 0 0 1px oklch(1 0 0 / .08);
           animation: tv-entra .7s cubic-bezier(.16, 1, .3, 1) both; animation-delay: calc(.6s + var(--i) * .08s); transition: transform .25s cubic-bezier(.16, 1, .3, 1); }
  .tv-sb:hover { transform: translateX(4px); }
  @keyframes tv-entra { from { transform: translateX(-30px); opacity: 0; } }
  .tv-sb-eq { display: flex; align-items: center; gap: 8px; min-width: 0; }
  .tv-sb-eq b { font: 500 15px/1 'Oswald', sans-serif; text-transform: uppercase; letter-spacing: .04em; color: #fff; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .tv-sb-eq :global(img) { width: 26px; height: 26px; object-fit: contain; flex: none; }
  .tv-sb-v { justify-content: flex-end; }
  .tv-sb-res { display: flex; }
  .tv-sb-res b { display: grid; place-items: center; width: 34px; height: 34px; background: var(--plata); color: var(--azul); font: 600 1.2rem/1 'Oswald', sans-serif; font-variant-numeric: tabular-nums; }
  .tv-sb-res b + b { background: #fff; }
  .tv-sb-fin { position: absolute; right: 10px; top: -8px; font: 600 10px/1 'Oswald', sans-serif; letter-spacing: .14em; text-transform: uppercase; background: var(--oro); color: var(--azul); padding: 3px 6px; display: none; }
  .tv-sb:first-child .tv-sb-fin { display: block; }

  /* Tabla de estudio */
  .tv-tabla { width: 100%; border-collapse: separate; border-spacing: 0 4px; font-variant-numeric: tabular-nums; }
  .tv-tabla th { font: 500 12px/1 'Oswald', sans-serif; letter-spacing: .12em; text-transform: uppercase; color: var(--plata2); text-align: center; padding: 4px 6px; }
  .tv-tabla th:nth-child(2) { text-align: left; }
  .tv-tabla td { padding: 9px 6px; text-align: center; background: oklch(0.19 0.06 265 / .85); font-size: 14px; color: var(--plata2); }
  .tv-tabla tbody tr { animation: tv-entra .6s cubic-bezier(.16, 1, .3, 1) both; animation-delay: calc(.8s + var(--i) * .05s); transition: transform .2s; }
  .tv-tabla tbody tr:hover { transform: translateX(4px); }
  .tv-tabla tbody tr:hover td { background: oklch(0.25 0.08 265); }
  .tv-p { width: 36px; font: 600 15px/1 'Oswald', sans-serif; color: #fff !important; }
  .tv-cl .tv-p { background: var(--oro) !important; color: var(--azul) !important; }
  .tv-tj { display: flex; align-items: center; gap: 8px; text-align: left; }
  .tv-tj :global(img) { width: 22px; height: 22px; object-fit: contain; }
  .tv-tj b { font: 500 15px/1 'Oswald', sans-serif; letter-spacing: .03em; text-transform: uppercase; color: #fff; }
  .tv-pts { font: 600 16px/1 'Oswald', sans-serif; color: #fff !important; background: oklch(0.27 0.09 265) !important; width: 48px; }
  .tv-nota { margin-top: 8px; font-size: 12px; color: var(--plata2); display: flex; align-items: center; gap: 6px; }
  .tv-punto { width: 10px; height: 10px; background: var(--oro); }

  /* Datos como rótulos inferiores de TV */
  .tv-tercios { display: grid; gap: 10px; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
  .tv-tercio { padding: 14px 16px; background: linear-gradient(100deg, var(--azul2), oklch(0.17 0.05 265)); box-shadow: inset 0 2px 0 var(--oro); animation: tv-sube .8s cubic-bezier(.16, 1, .3, 1) both; animation-delay: calc(.3s + var(--i) * .1s); }
  .tv-tercio-et { font: 500 12px/1 'Oswald', sans-serif; letter-spacing: .14em; text-transform: uppercase; color: var(--oro); }
  .tv-tercio-v { margin-top: 8px; font: 500 1.25rem/1.2 'Oswald', sans-serif; text-transform: uppercase; color: #fff; }
  .tv-tercio-v b { display: inline-block; padding: 0 8px; margin: 0 2px; background: var(--plata); color: var(--azul); font-weight: 600; }
  .tv-tercio-s { margin-top: 6px; font-size: 13px; color: var(--plata2); }

  .tv-vs { display: grid; gap: 6px; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
  .tv-vs li { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: center; gap: 10px; padding: 10px 12px; background: oklch(0.19 0.06 265 / .8); }
  .tv-vs i { font: 600 12px/1 'Oswald', sans-serif; letter-spacing: .1em; text-transform: uppercase; color: var(--oro); font-style: normal; }

  /* Cinta de resultados que corre abajo, como en la tele */
  .tv-cinta { margin: 10px -16px 0; overflow: hidden; background: var(--plata); color: var(--azul); font: 600 14px/1 'Oswald', sans-serif; text-transform: uppercase; letter-spacing: .06em; }
  @media (min-width: 900px) { .tv-cinta { margin-inline: -40px; } }
  .tv-cinta-in { display: flex; width: max-content; animation: tv-cinta 40s linear infinite; }
  .tv-cinta-in span { display: flex; }
  .tv-cinta em { font-style: normal; padding: 12px 22px; border-right: 1px solid oklch(0.15 0.05 265 / .2); white-space: nowrap; }
  @keyframes tv-cinta { to { transform: translateX(-50%); } }
  .tv-cinta:hover .tv-cinta-in { animation-play-state: paused; }

  @media (prefers-reduced-motion: reduce) { .tv *, .tv { animation: none !important; transition: none !important; } }
  :global(:root[data-aj-mov-efectivo='reducido']) .tv * { animation: none !important; transition: none !important; }
</style>

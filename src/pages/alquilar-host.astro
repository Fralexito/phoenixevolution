---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Alquilar host" active="hosts" description="Encuentra un host con buena conexión para tu partido de PES 2021 o Football Life por Parsec.">
  <div class="max-w-6xl mx-auto px-4 sm:px-8 py-4 sm:py-6 w-full space-y-4">
    <header class="glass-panel px-4 py-3 rounded-2xl flex flex-wrap items-center justify-between gap-3">
      <div>
        <h1 class="text-xl sm:text-2xl font-display font-extrabold text-white uppercase tracking-wider text-shadow-glow"><i class="fa-solid fa-server text-galaxy-400 mr-2"></i>Alquilar host</h1>
        <p class="text-gray-300 text-xs mt-0.5">Hosts verificados que te prestan su servidor para jugar online sin lag. Mira precios, ping y cómo contactarlos.</p>
      </div>
      <a href={`${import.meta.env.BASE_URL}duelos/`} class="btn btn-ghost !min-h-10"><i class="fa-solid fa-arrow-left"></i> Volver a Duelos</a>
    </header>

    <div class="seg" id="ah-tabs" role="tablist" aria-label="Secciones de alquiler">
      <button type="button" role="tab" data-tab="catalogo" aria-selected="true" aria-pressed="true">Hosts disponibles</button>
      <button type="button" role="tab" data-tab="mios" aria-selected="false" aria-pressed="false">Mis alquileres</button>
      <button type="button" role="tab" data-tab="oferta" aria-selected="false" aria-pressed="false">Ofrecer mi host</button>
    </div>

    <section id="ah-catalogo" class="space-y-3">
      <div class="glass-panel rounded-2xl p-3 grid grid-cols-2 sm:grid-cols-[minmax(0,1fr)_auto_auto_auto] gap-2 items-end">
        <label class="text-[12px] text-gray-400 col-span-2 sm:col-span-1">Buscar host<input id="ah-q" type="search" class="field mt-1" placeholder="Nombre o usuario" maxlength="40" autocomplete="off"></label>
        <label class="text-[12px] text-gray-400">Juego<select id="ah-juego" class="field mt-1"><option value="">Todos</option></select></label>
        <label class="text-[12px] text-gray-400">Ordenar por<select id="ah-orden" class="field mt-1"><option value="ping">Menor ping</option><option value="precio">Más barato</option><option value="alquileres">Más alquileres</option></select></label>
        <label class="flex items-center gap-2 text-[12px] text-gray-300 min-h-10 col-span-2 sm:col-span-1"><input id="ah-gemas" type="checkbox" class="w-4 h-4 accent-cyan-400"> Acepta gemas</label>
      </div>
      <p id="ah-cuenta" class="text-[12px] text-gray-400" aria-live="polite"></p>
      <div id="ah-lista" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3"><p class="text-xs text-gray-400 col-span-full text-center py-10">Cargando hosts…</p></div>
    </section>

    <section id="ah-mios" hidden class="glass-panel rounded-2xl p-4"><ul id="ah-mios-lista" class="text-sm text-gray-300"></ul></section>

    <section id="ah-oferta" hidden class="glass-panel rounded-2xl p-4 space-y-3">
      <h2 class="text-sm font-display font-bold text-white uppercase tracking-widest">Mi oferta de host</h2>
      <p id="ah-oferta-aviso" class="text-xs text-gray-400">Solo pueden ofrecer su host quienes ya fueron aprobados como host por el staff.</p>
      <div id="ah-oferta-caja"></div>
    </section>
  </div>
</Layout>
<script>
  import '../js/pages/alquilarHost.js';
</script>

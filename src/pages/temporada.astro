---
// Página «Temporada» (BETA): el sistema de dos divisiones (ascensos/descensos) y la Copa Interdivisional. Todo se calcula en el navegador
// con js/core/temporada.js a partir de la tabla REAL de Primera y la de Segunda (real si existe; si no, una de EJEMPLO claramente marcada).
import Layout from '../layouts/Layout.astro';
import Plegable from '../components/Plegable.astro';
import SelectorDivisiones from '../components/SelectorDivisiones.astro';
import { SISTEMA, DEMO_SEGUNDA } from '../data/temporada.js';
import { EDICIONES } from '../data/ligaResultados.js';
import { calcularTabla, tablaEdicion } from '../js/core/tabla.js';
const base = import.meta.env.BASE_URL;
const [d1cfg, d2cfg] = SISTEMA.divisiones;
const ultima = (id) => (EDICIONES[id] ?? []).at(-1) ?? null;
const filas = (ed) => tablaEdicion(ed).map((f) => ({ nombre: f.nombre, pts: f.pts, pj: f.pj, dg: f.dg, club: ed.clubes?.[f.nombre] ?? '' }));
const ed1 = ultima(d1cfg.ligaId); const ed2 = ultima(d2cfg.ligaId);
const datos = {
  d1: ed1 ? filas(ed1) : [], d2: ed2 ? filas(ed2) : DEMO_SEGUNDA.map((f) => ({ ...f, club: '' })), demo2: !ed2,
  edicion1: ed1?.nombre ?? '', temporada: SISTEMA.temporada, cfg: SISTEMA.inicial, resultados: SISTEMA.resultadosCopa,
  nombres: { d1: d1cfg.nombre, d2: d2cfg.nombre, copa: SISTEMA.copa.nombre },
};
---
<Layout title="Temporada" active="liga">
  <header class="relative overflow-hidden border-b border-galaxy-border/40">
    <div class="absolute inset-0 bg-gradient-to-b from-galaxy-900/70 to-transparent"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 py-10 sm:py-14 space-y-4">
      <SelectorDivisiones activa="galaxy" />
      <div class="flex flex-wrap items-center gap-3"><span class="liga-sello liga-sello-prox">Beta</span><span class="liga-sello">Temporada {SISTEMA.temporada}</span></div>
      <h1 class="text-4xl sm:text-6xl font-display font-extrabold text-white uppercase leading-none text-shadow-glow">Sistema de <span class="text-transparent bg-clip-text bg-gradient-to-r from-galaxy-400 to-galaxy-600">Divisiones</span></h1>
      <p class="max-w-3xl text-sm sm:text-base text-gray-300 leading-relaxed">Dos divisiones, <b class="text-white">ascensos y descensos</b> al cerrar cada temporada y una <b class="text-white">{SISTEMA.copa.nombre}</b> entre ambas. Mueve los controles y mira al instante cómo cambia todo.</p>
      <ul class="grid gap-3 sm:grid-cols-3 pt-2" aria-label="Cómo funciona">
        <li class="glass-panel rounded-xl p-4"><i class="fa-solid fa-layer-group text-galaxy-400 mr-2"></i><b class="text-white font-display uppercase tracking-wider text-sm">1 · Dos divisiones</b><p class="text-xs text-gray-400 mt-1.5 leading-relaxed">Primera y Segunda, cada una con su tabla y sus fechas.</p></li>
        <li class="glass-panel rounded-xl p-4"><i class="fa-solid fa-arrows-up-down text-galaxy-400 mr-2"></i><b class="text-white font-display uppercase tracking-wider text-sm">2 · Suben y bajan</b><p class="text-xs text-gray-400 mt-1.5 leading-relaxed">Los últimos de Primera bajan y los primeros de Segunda suben, siempre en igual número.</p></li>
        <li class="glass-panel rounded-xl p-4"><i class="fa-solid fa-trophy text-galaxy-400 mr-2"></i><b class="text-white font-display uppercase tracking-wider text-sm">3 · Copa de ambas</b><p class="text-xs text-gray-400 mt-1.5 leading-relaxed">Los mejores de cada división se cruzan en eliminación directa.</p></li>
      </ul>
    </div>
  </header>

  <div id="temporada" data-temporada={JSON.stringify(datos)} class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 py-8 sm:py-10 space-y-8 pb-20">
    <noscript><p class="text-sm text-amber-300">Esta página necesita JavaScript para calcular el sistema.</p></noscript>
    <!-- CONTROLES -->
    <Plegable titulo="Reglas de la simulación" icono="fa-sliders" resumen="Cuántos suben y bajan, cuántos van a la copa · toca para cambiarlos">
      <section class="space-y-3 pt-2" aria-label="Controles de simulación">
        <div class="grid gap-4 sm:grid-cols-3" id="tmp-controles"></div>
        <p id="tmp-avisos" class="text-xs text-amber-300/90 space-y-1" role="status"></p>
      </section>
    </Plegable>
    <!-- TABLAS -->
    <section class="grid gap-6 lg:grid-cols-2" aria-label="Divisiones">
      <div id="tmp-d1" class="space-y-3"></div><div id="tmp-d2" class="space-y-3"></div>
    </section>
    <ul class="flex flex-wrap gap-x-5 gap-y-1.5 text-xs text-gray-300" aria-label="Leyenda de zonas">
      <li><span class="tmp-dot tmp-copa"></span>Zona de copa</li><li><span class="tmp-dot tmp-sube"></span>Ascenso</li><li><span class="tmp-dot tmp-baja"></span>Descenso</li>
    </ul>
    <!-- RESULTADO AL CIERRE -->
    <Plegable titulo="Si la temporada terminara hoy" icono="fa-flag-checkered" resumen="Quién sube, quién baja y quién va a copa"><section id="tmp-cierre" class="space-y-3 pt-2" aria-label="Si la temporada terminara hoy"></section></Plegable>
    <!-- COPA -->
    <Plegable titulo="Copa Interdivisional" icono="fa-trophy" resumen="El cuadro entre ambas divisiones"><section id="tmp-copa" class="space-y-3 pt-2" aria-label="Copa interdivisional"></section></Plegable>
    <p class="text-xs text-gray-500 leading-relaxed">BETA: todo es una <b class="text-gray-300">proyección con la tabla de hoy</b> (no hay nada oficial hasta que se cierre la temporada). La Primera División usa los resultados reales de la Liga; la Segunda se llena sola cuando exista la liga real. <a class="text-galaxy-400 underline" href={`${base}liga/`}>Volver a la Liga</a>.</p>
  </div>
</Layout>
<script>
  import '../js/pages/temporada.js';
</script>

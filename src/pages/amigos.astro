---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Amigos" active="amigos">
  <div class="max-w-5xl mx-auto px-4 sm:px-8 py-4 sm:py-6 w-full space-y-4">
    <header class="glass-panel px-4 py-3 rounded-2xl">
      <span class="text-[12px] font-display font-bold text-galaxy-400 uppercase tracking-widest bg-galaxy-600/20 px-2 py-0.5 rounded border border-galaxy-400/30">Mi cuenta</span>
      <h1 class="text-xl sm:text-2xl font-display font-extrabold text-white uppercase tracking-wider text-shadow-glow mt-1"><i class="fa-solid fa-user-group text-galaxy-400 mr-2"></i>Amigos</h1>
      <p class="text-gray-300 text-xs mt-0.5">Tu círculo en la liga: amistades, seguidores, bloqueos y quién puede contactarte.</p>
    </header>

    <div id="amigos-vacio" hidden class="glass-panel rounded-2xl p-8 text-center text-gray-400 text-sm">Inicia sesión para ver y gestionar tus amigos.</div>

    <div id="amigos-app" hidden class="space-y-3">
      <div id="tabs-red" class="flex gap-1.5 overflow-x-auto pb-1" role="tablist" aria-label="Secciones de amigos"></div>
      <div id="panel-red" class="space-y-3"></div>
    </div>
  </div>
</Layout>
<script>
  import '../js/pages/amigos.js';
</script>

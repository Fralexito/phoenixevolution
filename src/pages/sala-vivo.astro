---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Sala en vivo" active="envivo" description="Chat y predicción en vivo de un duelo de Phoenix Evolution Series." privada>
  <div class="max-w-3xl mx-auto px-4 sm:px-8 py-4 sm:py-6 w-full space-y-4">
    <header class="glass-panel px-4 py-3 rounded-2xl">
      <span class="text-[12px] font-display font-bold text-galaxy-400 uppercase tracking-widest bg-galaxy-600/20 px-2 py-0.5 rounded border border-galaxy-400/30">Jugar · En vivo</span>
      <h1 id="sv-titulo" class="text-xl sm:text-2xl font-display font-extrabold text-white uppercase tracking-wider text-shadow-glow mt-1"><i class="fa-solid fa-comments text-galaxy-400 mr-2"></i>Sala en vivo</h1>
      <p class="text-gray-300 text-xs mt-0.5">Chat del duelo para jugadores, host y espectadores aprobados. Los espectadores predicen quién gana (sin premio, solo por orgullo).</p>
    </header>
    <div id="sv-aviso" hidden role="status" class="rounded-xl border border-galaxy-border bg-galaxy-panel px-4 py-3 text-sm text-gray-300"></div>
    <section id="sv-pred" hidden class="glass-panel rounded-2xl p-4 space-y-3" aria-labelledby="sv-pred-t"></section>
    <section id="sv-chat" hidden class="glass-panel rounded-2xl p-3 flex flex-col gap-2 mb-20 sm:mb-0" aria-labelledby="sv-chat-t">
      <h2 id="sv-chat-t" class="font-display font-bold text-white text-sm uppercase tracking-wider px-1">Chat de la sala</h2>
      <ol id="sv-msgs" class="flex flex-col gap-1.5 max-h-[55vh] min-h-40 overflow-y-auto px-1" aria-live="polite"></ol>
      <form id="sv-form" class="flex gap-2"><input id="sv-texto" maxlength="300" autocomplete="off" class="field flex-1 min-w-0" placeholder="Escribe un mensaje" aria-label="Mensaje"><button class="btn btn-primary !min-h-10 !px-4" aria-label="Enviar"><i class="fa-solid fa-paper-plane"></i></button></form>
    </section>
  </div>
</Layout>
<script>
  import '../js/pages/salaVivo.js';
</script>

---
// Sistema de Divisiones de la LIGA SUDARIO (BETA, incompleto a propósito): solo existe la División Sudario; la División 2 aún no está definida.
// Es independiente de /temporada/ (Galaxy). Todo se calcula al construir la web; no necesita JavaScript.
import Layout from '../layouts/Layout.astro';
import SelectorDivisiones from '../components/SelectorDivisiones.astro';
import { SISTEMAS_LIGA } from '../data/temporada.js';
import { EDICIONES } from '../data/ligaResultados.js';
import { calcularTabla } from '../js/core/tabla.js';
import { zonasLiga } from '../js/core/temporada.js';
import { escudoDe } from '../js/core/escudos.js';
const base = import.meta.env.BASE_URL;
const sis = SISTEMAS_LIGA.sudario;
const ed = (EDICIONES.sudario ?? []).at(-1);
const t = calcularTabla((ed?.fechas ?? []).flatMap((f) => f.partidos)).tabla;
const hay = new Set(t.map((f) => f.nombre));
const faltan = (ed?.jugadores ?? []).filter((n) => !hay.has(n)).sort((a, b) => a.localeCompare(b, 'es'));
const tabla = [...t, ...faltan.map((nombre) => ({ nombre, pj: 0, pts: 0, dg: 0 }))];
const zonas = zonasLiga(tabla.map((f) => f.nombre), sis);
const jugados = tabla.some((f) => f.pj > 0);
---
<Layout title="Divisiones · Liga Sudario" active="liga">
  <header class="relative overflow-hidden border-b border-galaxy-border/40">
    <div class="absolute inset-0 bg-gradient-to-b from-galaxy-900/70 to-transparent"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 py-10 sm:py-14 space-y-4">
      <SelectorDivisiones activa="sudario" />
      <div class="flex flex-wrap items-center gap-3"><span class="liga-sello liga-sello-prox">Beta</span><span class="liga-sello">Liga Sudario</span></div>
      <h1 class="text-4xl sm:text-6xl font-display font-extrabold text-white uppercase leading-none text-shadow-glow">Sistema de <span class="text-transparent bg-clip-text bg-gradient-to-r from-galaxy-400 to-galaxy-600">Divisiones</span></h1>
      <p class="max-w-3xl text-sm sm:text-base text-gray-300 leading-relaxed">Aquí se define cómo se moverán los jugadores de la <b class="text-white">Liga Sudario</b> entre divisiones. Es un sistema <b class="text-white">independiente</b> del de la Galaxy League y todavía está <b class="text-white">en construcción</b>: por ahora solo está activa la primera división.</p>
      <ul class="grid gap-3 sm:grid-cols-3 pt-2" aria-label="Cómo funciona">
        <li class="glass-panel rounded-xl p-4"><i class="fa-solid fa-layer-group text-galaxy-400 mr-2"></i><b class="text-white font-display uppercase tracking-wider text-sm">1 · Divisiones</b><p class="text-xs text-gray-400 mt-1.5 leading-relaxed">{sis.divisiones[0].nombre} (activa) y {sis.divisiones[1].nombre} (por definir).</p></li>
        <li class="glass-panel rounded-xl p-4"><i class="fa-solid fa-arrow-down text-rose-300 mr-2"></i><b class="text-white font-display uppercase tracking-wider text-sm">2 · Descenso</b><p class="text-xs text-gray-400 mt-1.5 leading-relaxed">Al cerrar la temporada, los {sis.bajan} últimos de la tabla pierden la categoría.</p></li>
        <li class="glass-panel rounded-xl p-4"><i class="fa-solid fa-trophy text-galaxy-400 mr-2"></i><b class="text-white font-display uppercase tracking-wider text-sm">3 · Zona de copa</b><p class="text-xs text-gray-400 mt-1.5 leading-relaxed">Los {sis.copa} primeros quedan marcados como clasificables a copa (por confirmar).</p></li>
      </ul>
    </div>
  </header>
  <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 py-8 sm:py-10 space-y-8 pb-20">
    <section class="space-y-3" aria-label="Escalera de divisiones">
      <h2 class="font-display font-bold text-base text-white uppercase tracking-widest"><i class="fa-solid fa-stairs text-galaxy-400 mr-2"></i>Escalera de divisiones</h2>
      <div class="grid gap-3 sm:grid-cols-2">
        <div class="glass-panel rounded-xl p-4 border border-galaxy-400/40"><i class={`fa-solid ${sis.divisiones[0].icono} text-galaxy-400 mr-2`}></i><b class="text-white font-display uppercase text-sm">{sis.divisiones[0].nombre}</b> <span class="liga-sello !text-[.6rem] !py-0 ml-1">Activa</span><p class="text-xs text-gray-400 mt-1.5">{ed?.participantes ?? 12} jugadores · {ed?.nombre ?? '1° Edición'}</p></div>
        <div class="glass-panel rounded-xl p-4 border border-dashed border-galaxy-border/70 opacity-80"><i class={`fa-solid ${sis.divisiones[1].icono} text-gray-400 mr-2`}></i><b class="text-gray-200 font-display uppercase text-sm">{sis.divisiones[1].nombre}</b> <span class="liga-sello liga-sello-prox !text-[.6rem] !py-0 ml-1">Por definir</span><p class="text-xs text-gray-500 mt-1.5">Aún no hay jugadores ni calendario. Cuando exista, aquí se activarán los ascensos.</p></div>
      </div>
    </section>
    <section class="space-y-3" aria-label="Tabla con zonas">
      <h2 class="font-display font-bold text-base text-white uppercase tracking-widest"><i class="fa-solid fa-flag-checkered text-galaxy-400 mr-2"></i>{jugados ? 'Si la temporada terminara hoy' : 'Tabla (aún sin partidos jugados)'}</h2>
      <div class="glass-panel rounded-2xl px-3 sm:px-5 py-2 overflow-x-auto">
        <table class="liga-tabla w-full text-sm"><thead><tr><th class="text-left w-8">#</th><th class="text-left">Jugador</th><th>PTS</th><th>PJ</th><th>DIF</th><th class="text-left">Zona</th></tr></thead>
          <tbody>{tabla.map((f, i) => { const z = zonas.get(f.nombre) ?? []; return (
            <tr class:list={['tmp-fila', z.includes('baja') ? 'tmp-baja' : z.includes('copa') ? 'tmp-copa' : '']}>
              <td class="text-left font-display font-bold text-gray-300">{i + 1}</td>
              <td class="text-left"><span class="inline-flex items-center gap-2">{escudoDe(ed?.clubes?.[f.nombre]) && <img src={escudoDe(ed.clubes[f.nombre])} alt="" width="20" height="20" loading="lazy" referrerpolicy="no-referrer" style="width:20px;height:20px" class="object-contain" onerror="this.style.display='none'" />}<b class="text-white font-display">{f.nombre}</b></span></td>
              <td class="font-display font-bold text-white">{f.pts}</td><td>{f.pj}</td><td>{f.dg > 0 ? `+${f.dg}` : f.dg}</td>
              <td class="text-left text-xs">{z.includes('baja') ? <span class="text-rose-300"><i class="fa-solid fa-arrow-down mr-1"></i>Descenso</span> : z.includes('copa') ? <span class="text-galaxy-400"><i class="fa-solid fa-trophy mr-1"></i>Copa</span> : <span class="text-gray-500">—</span>}</td>
            </tr>); })}</tbody></table>
      </div>
      <p class="text-xs text-gray-500">Los puestos son provisionales hasta que se jueguen todas las fechas. Con 0 partidos los jugadores aparecen por orden alfabético.</p>
    </section>
    <p><a href={`${base}liga/#liga-sudario`} class="btn btn-ghost"><i class="fa-solid fa-arrow-left"></i> Volver a la Liga Sudario</a></p>
  </div>
  <script is:inline>document.documentElement.dataset.tema = 'sudario';</script>
</Layout>

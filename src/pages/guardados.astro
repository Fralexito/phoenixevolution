---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Guardados" active="guardados">
  <div class="max-w-2xl mx-auto px-4 sm:px-8 py-4 sm:py-6 w-full space-y-4">
    <header class="glass-panel px-4 py-3 rounded-2xl">
      <span class="text-[12px] font-display font-bold text-galaxy-400 uppercase tracking-widest bg-galaxy-600/20 px-2 py-0.5 rounded border border-galaxy-400/30">Mi cuenta</span>
      <h1 class="text-xl sm:text-2xl font-display font-extrabold text-white uppercase tracking-wider text-shadow-glow mt-1"><i class="fa-solid fa-bookmark text-galaxy-400 mr-2"></i>Guardados</h1>
      <p class="text-gray-300 text-xs mt-0.5">Publicaciones y clips que marcaste para volver a verlos. Solo tú los ves. Si algo se oculta o ya no puedes verlo, deja de aparecer aquí (no se pierde: vuelve si vuelve a ser visible).</p>
    </header>
    <div id="gu-sinsesion" hidden class="glass-panel rounded-2xl p-8 text-center text-gray-400 text-sm">Inicia sesión para ver tus guardados.</div>
    <div id="gu-app" hidden class="space-y-3">
      <div id="gu-error" hidden role="alert" class="rounded-xl border border-rose-400/40 bg-rose-500/10 px-4 py-3 text-sm text-rose-200 flex flex-wrap items-center gap-3">
        <i class="fa-solid fa-triangle-exclamation"></i><span id="gu-error-txt" class="flex-1 min-w-0"></span>
        <button type="button" id="gu-reintentar" class="btn btn-ghost !min-h-8 !px-3 !text-[12px]">Reintentar</button>
      </div>
      <section id="gu-lista" class="space-y-3" aria-live="polite"></section>
      <div class="text-center"><button type="button" id="gu-mas" hidden class="btn btn-ghost">Cargar más</button></div>
    </div>
  </div>
</Layout>
<script>
  import '../js/pages/guardados.js';
</script>

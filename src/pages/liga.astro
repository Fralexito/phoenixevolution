---
// Página «Liga»: lo esencial — portada compacta, TABLA y RESULTADOS por fecha. Cada liga tiene su historial de ediciones (selector).
// Todo sale de datos (data/ligas.js + data/ligaResultados.js) y se calcula al construir la web. CopaFácil sigue siendo la fuente oficial.
import Layout from '../layouts/Layout.astro';
import { LIGAS, ETIQUETA_ESTADO } from '../data/ligas.js';
import { EDICIONES } from '../data/ligaResultados.js';
import { calcularTabla } from '../js/core/tabla.js';
import { escudoDe } from '../js/core/escudos.js';
import { SISTEMA, SISTEMAS_LIGA } from '../data/temporada.js';
import { zonasDivision, zonasLiga } from '../js/core/temporada.js';
import { estadoFecha, fechaActual, historial, resumenFecha, totalFechas } from '../js/core/ligaStats.js';
const base = import.meta.env.BASE_URL;
// Clases completas (Tailwind solo detecta nombres escritos enteros).
const CHIP = { G: 'bg-emerald-500/90 text-black', E: 'bg-amber-400/90 text-black', P: 'bg-rose-500/90 text-white' };
const ESTADO_ED = { en_curso: 'En curso', finalizada: 'Finalizada' };
const PUESTO = ['text-gold-400', 'text-gray-200', 'text-bronze-400'];

const divisionDe = (ligaId) => SISTEMA.divisiones.find((d) => d.ligaId === ligaId) ?? null;
const ESTADO_FECHA = { jugada: 'jugada', en_juego: 'en juego', pendiente: 'por jugar' };
// Tabla con TODOS los participantes: quien aún no juega aparece con ceros (útil al empezar una liga).
const tablaCompleta = (e) => {
  const t = calcularTabla(e.fechas.flatMap((f) => f.partidos)).tabla; const hay = new Set(t.map((f) => f.nombre));
  const faltan = [...new Set([...(e.jugadores ?? []), ...e.fechas.flatMap((f) => f.partidos.flatMap((m) => [m.l, m.v]))])].filter((n) => !hay.has(n)).sort((a, b) => a.localeCompare(b, 'es'));
  return [...t, ...faltan.map((nombre) => ({ nombre, pj: 0, g: 0, e: 0, p: 0, gf: 0, gc: 0, dg: 0, pts: 0 }))];
};
const datos = LIGAS.map((l) => ({
  liga: l,
  ediciones: (EDICIONES[l.id] ?? []).map((e) => ({
    ...e, tabla: tablaCompleta(e), actual: fechaActual(e.fechas),
    formas: Object.fromEntries(tablaCompleta(e).map((f) => [f.nombre, historial(e.fechas, f.nombre)])),
    total: totalFechas(e), jugadas: e.fechas.filter((f) => estadoFecha(f) === 'jugada').length,
    zonas: e.estado === 'en_curso' && SISTEMAS_LIGA[l.id] ? zonasLiga(tablaCompleta(e).map((f) => f.nombre), SISTEMAS_LIGA[l.id]) : e.estado === 'en_curso' && divisionDe(l.id) ? zonasDivision(tablaCompleta(e).map((f) => f.nombre), divisionDe(l.id).nivel, { ...SISTEMA.inicial, suben: SISTEMA.inicial.suben }) : null,   // zonas de copa/descenso (beta)
    fechas: e.fechas.map((f) => ({ ...f, estado: estadoFecha(f), resumen: resumenFecha(f) })),
  })).reverse(),   // la más reciente primero
}));
---
<Layout title="Liga" active="liga">
  <!-- Selector de liga: muestra una sola liga a la vez. Pulsar la otra vuelve al instante; el enlace (#liga-…) recuerda cuál. -->
  {LIGAS.length > 1 && (
    <nav class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 pt-5 flex items-center gap-3 flex-wrap" aria-label="Cambiar de liga">
      <span class="text-[10px] font-display font-bold tracking-[0.2em] uppercase text-gray-500">Ligas activas</span>
      <div class="liga-sel" role="group" aria-label="Ligas activas"><span class="liga-thumb" aria-hidden="true"></span>{LIGAS.map((l, i) => <button type="button" data-liga-btn={l.id} aria-pressed={i === 0 ? 'true' : 'false'}><i class={`fa-solid ${l.icono} mr-1.5`}></i>{l.titulo.join(' ')}</button>)}</div>
    </nav>
  )}

  {datos.map(({ liga: l, ediciones }) => { const ult = ediciones[0]; const fa = ult?.fechas.find((f) => f.n === ult.actual); return (
    <section id={`liga-${l.id}`} data-liga-sec={l.id} class="scroll-mt-20">
      <!-- PORTADA A PANTALLA COMPLETA (como la que tuvo Central): foto del espacio que se acerca despacio al pasar el mouse -->
      <header class="group relative overflow-hidden border-b border-galaxy-border/40">
        <img src={l.imagen} alt="" loading="eager" class="absolute inset-0 w-full h-full object-cover opacity-55 mix-blend-screen group-hover:scale-105 transition-transform duration-[1400ms] ease-out" />
        <div class="absolute inset-0 bg-gradient-to-r from-black via-galaxy-900/75 to-transparent"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-galaxy-dark via-transparent to-transparent"></div>
        <div class="relative z-10 max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 py-14 sm:py-24 min-h-[380px] sm:min-h-[500px] flex flex-col justify-center">
          <div class="max-w-3xl text-center sm:text-left space-y-4">
            <div class="flex items-center justify-center sm:justify-start gap-3">
              <i class={`fa-solid ${l.icono} text-galaxy-400 text-3xl sm:text-4xl drop-shadow-[0_0_15px_rgba(0,229,255,0.8)] animate-float`}></i>
              <span class:list={['liga-sello', l.estado === 'proxima' ? 'liga-sello-prox' : '']}>{ETIQUETA_ESTADO[l.estado]}</span>
            </div>
            <h1 class="text-5xl sm:text-7xl md:text-8xl font-display font-extrabold text-white uppercase leading-none text-shadow-glow">{l.titulo[0]} <span class="text-transparent bg-clip-text bg-gradient-to-r from-galaxy-400 to-galaxy-600">{l.titulo[1]}</span></h1>
            <p class="text-sm sm:text-2xl font-display font-light tracking-[0.25em] sm:tracking-[0.3em] text-gray-300 uppercase">{l.juego}</p>
            {ult && (
              <ul class="flex flex-wrap justify-center sm:justify-start gap-2" aria-label="Estado de la edición">
                <li class="hidden sm:block"><span class="pc-chip"><i class="fa-solid fa-calendar-day"></i>{ult.nombre}</span></li>
                {fa && <li><span class="pc-chip"><i class="fa-solid fa-futbol"></i>Fecha {fa.n} {ESTADO_FECHA[fa.estado]}</span></li>}
                {ult.tabla[0]?.pj > 0 && <li><span class="pc-chip"><i class="fa-solid fa-crown"></i>Líder: {ult.tabla[0].nombre} · {ult.tabla[0].pts} pts</span></li>}
                <li class="hidden sm:block"><span class="pc-chip"><i class="fa-solid fa-users"></i>{ult.participantes} jugadores</span></li>
              </ul>
            )}
            <div class="flex flex-wrap justify-center sm:justify-start gap-3 pt-1">
              {l.copafacil && <a href={l.copafacil} target="_blank" rel="noopener noreferrer" class="hero-cta hero-cta-p"><i class="fa-solid fa-table-list"></i> Ver en CopaFácil</a>}
              <a href={`${base}duelos/`} class="hero-cta hero-cta-s"><i class="fa-solid fa-gamepad"></i> Sala de Duelos</a>
            </div>
          </div>
        </div>
      </header>

      <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 py-8 sm:py-10 space-y-8 sm:space-y-10 pb-20">
        {ediciones.length === 0 && <p class="text-gray-400 text-sm">Esta liga aún no tiene ediciones cargadas.</p>}

        <!-- Historial: cada edición (la más reciente primero) se elige aquí; las terminadas quedan archivadas con su campeón. -->
        {ediciones.length > 0 && (
          <div class="flex items-center gap-3">
            <label for={`ed-${l.id}`} class="sr-only">Edición</label>
            <select id={`ed-${l.id}`} class="field !w-auto !bg-galaxy-900 font-display font-bold uppercase tracking-wider" data-ed-select={l.id} aria-label="Elegir edición">
              {ediciones.map((e) => <option value={e.id}>{e.nombre} · {ESTADO_ED[e.estado]}</option>)}
            </select>
          </div>
        )}

        {ediciones.map((e, idx) => (
          <div data-edicion={e.id} data-liga-ed={l.id} hidden={idx !== 0} class="space-y-8 sm:space-y-10">
            {e.estado === 'finalizada' && <p class="text-sm text-gray-200"><i class="fa-solid fa-crown text-gold-400 mr-1.5"></i>Campeón: <b class="text-white">{e.campeon ?? '—'}</b></p>}

            <div class="grid gap-8 lg:gap-6 grid-cols-[minmax(0,1fr)] lg:grid-cols-[minmax(0,1.75fr)_minmax(0,1fr)] lg:items-start">
            <!-- TABLA -->
            <section class="space-y-3" aria-label="Tabla de posiciones">
              <h2 class="font-display font-bold text-base text-white uppercase tracking-widest">Tabla de posiciones</h2>
              <div class="glass-panel rounded-2xl px-3 sm:px-5 py-2 sm:py-3">
                <table class="liga-tabla w-full">
                  <thead><tr>
                    <th class="text-left w-8">#</th><th class="text-left">Jugador</th><th>PTS</th><th>PJ</th>
                    <th class="hidden sm:table-cell">G</th><th class="hidden sm:table-cell">E</th><th class="hidden sm:table-cell">P</th>
                    <th class="hidden md:table-cell lg:hidden 2xl:table-cell">GF</th><th class="hidden md:table-cell lg:hidden 2xl:table-cell">GC</th><th>DIF</th><th>Últimos</th>
                  </tr></thead>
                  <tbody>
                    {e.tabla.map((f, i) => (
                      <tr data-jug={f.nombre} style={`--i:${i}`} class:list={['liga-fila', i === 0 && f.pj > 0 ? 'liga-lider' : '', e.zonas?.get(f.nombre)?.includes('baja') ? 'tmp-fila tmp-baja' : e.zonas?.get(f.nombre)?.includes('sube') ? 'tmp-fila tmp-sube' : e.zonas?.get(f.nombre)?.includes('copa') ? 'tmp-fila tmp-copa' : '']}>
                        <td class:list={['text-left font-display font-bold', PUESTO[i] ?? 'text-gray-500']}>{i + 1}</td>
                        <td class="text-left"><span class="inline-flex items-center gap-2">{escudoDe(e.clubes?.[f.nombre]) && <img src={escudoDe(e.clubes[f.nombre])} alt="" width="22" height="22" loading="lazy" referrerpolicy="no-referrer" class="escudo object-contain shrink-0" style="width:22px;height:22px" onerror="this.style.display='none'" />}<span class="font-display font-bold text-white tracking-wide">{f.nombre}</span></span>{e.clubes?.[f.nombre] && <span class="block text-[11px] text-gray-400 leading-tight mt-0.5 uppercase">{e.clubes[f.nombre]}</span>}</td>
                        <td class="font-display font-extrabold text-white text-base">{f.pts}</td><td>{f.pj}</td>
                        <td class="hidden sm:table-cell">{f.g}</td><td class="hidden sm:table-cell">{f.e}</td><td class="hidden sm:table-cell">{f.p}</td>
                        <td class="hidden md:table-cell lg:hidden 2xl:table-cell">{f.gf}</td><td class="hidden md:table-cell lg:hidden 2xl:table-cell">{f.gc}</td>
                        <td class:list={[f.dg > 0 ? 'text-emerald-400' : f.dg < 0 ? 'text-rose-400' : 'text-gray-400']}>{f.dg > 0 ? `+${f.dg}` : f.dg}</td>
                        <td>
                          {e.formas[f.nombre].length === 0 ? <span class="text-gray-600">—</span> : (
                            <div class="forma" data-forma>
                              <button type="button" class="forma-flecha" data-forma-paso="-1" aria-label={`Partidos anteriores de ${f.nombre}`}><i class="fa-solid fa-chevron-left"></i></button>
                              <div class="forma-strip" data-forma-strip tabindex="0" aria-label={`Resultados de ${f.nombre}, del más antiguo al más reciente`}>
                                {e.formas[f.nombre].map((h) => <span class:list={['liga-forma', CHIP[h.r]]} title={`Fecha ${h.n} · ${{ G: 'Ganó', E: 'Empató', P: 'Perdió' }[h.r]} ${h.gf}-${h.gc} ${h.local ? 'vs' : 'en casa de'} ${h.rival}`}>{h.r}</span>)}
                              </div>
                              <button type="button" class="forma-flecha" data-forma-paso="1" aria-label={`Partidos más recientes de ${f.nombre}`}><i class="fa-solid fa-chevron-right"></i></button>
                              <span class="forma-cont" data-forma-cont data-total={e.formas[f.nombre].length} title="Partidos que se ven, sobre el total jugado">{Math.min(5, e.formas[f.nombre].length)}/{e.formas[f.nombre].length}</span>
                            </div>
                          )}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              {e.zonas && <p class="text-xs text-gray-400 flex flex-wrap items-center gap-x-4 gap-y-1"><span><span class="tmp-dot tmp-copa"></span>Zona de copa</span>{SISTEMAS_LIGA[l.id] && <span><span class="tmp-dot tmp-sube"></span>Zona de ascenso</span>}<span><span class="tmp-dot tmp-baja"></span>Zona de descenso</span>{SISTEMAS_LIGA[l.id] ? <span class="text-gray-300"><i class="fa-solid fa-layer-group text-galaxy-400 mr-1"></i>{SISTEMAS_LIGA[l.id].nombre}: suben {SISTEMAS_LIGA[l.id].suben}, bajan {SISTEMAS_LIGA[l.id].bajan}</span> : <a href={`${base}temporada/`} class="text-galaxy-400 underline">Sistema de divisiones <span class="liga-sello liga-sello-prox !text-[.6rem] !py-0">Beta</span></a>}</p>}
              <p class="text-xs text-gray-500 leading-relaxed">{e.formato}. 3 puntos por victoria, 1 por empate; desempata el enfrentamiento directo. PJ: partidos jugados · DIF: diferencia de goles · Últimos: flechas, rueda o arrastre para ver partidos anteriores. Toca un jugador para resaltar sus partidos en Resultados.</p>
            </section>

            <!-- RESULTADOS por fecha -->
            {e.fechas.length === 0 ? (
              <section class="space-y-3 lg:sticky lg:top-20" aria-label="Resultados por fecha">
                <h2 class="font-display font-bold text-base text-white uppercase tracking-widest">Resultados</h2>
                <div class="glass-panel rounded-2xl p-6 text-center space-y-2">
                  <i class="fa-solid fa-calendar-days text-galaxy-400 text-2xl"></i>
                  <p class="text-sm text-gray-200 font-display font-bold uppercase tracking-wider">Fechas por confirmar</p>
                  <p class="text-xs text-gray-400">{e.aviso ?? 'Aún no hay calendario publicado.'}</p>
                </div>
              </section>
            ) : (
            <section class="space-y-3 lg:sticky lg:top-20" aria-label="Resultados por fecha" data-fechas={`${l.id}:${e.id}`}>
              <div class="flex items-end justify-between gap-3">
                <h2 class="font-display font-bold text-base text-white uppercase tracking-widest">Resultados</h2>
                <span class="text-[11px] font-display font-bold tracking-wider uppercase text-gray-400"><b class="text-galaxy-400">{e.jugadas}</b> de {e.total} fechas</span>
              </div>
              <div class="liga-prog" role="progressbar" aria-label="Fechas jugadas" aria-valuemin="0" aria-valuemax={e.total} aria-valuenow={e.jugadas}><span style={`width:${e.total ? Math.round((e.jugadas / e.total) * 100) : 0}%`}></span></div>
              <div class="flex items-stretch gap-2" aria-label="Elegir fecha">
                <button type="button" data-fecha-paso="-1" aria-label="Fecha anterior" class="adv-chip !min-h-10 !px-4"><i class="fa-solid fa-chevron-left"></i></button>
                <select data-fecha-select aria-label="Fecha" class="field flex-1 !min-h-10 text-center font-display font-bold uppercase tracking-wider">
                  {e.fechas.map((f) => <option value={f.n} selected={f.n === e.actual}>Fecha {f.n} de {e.total}{f.estado === 'jugada' ? '' : f.estado === 'en_juego' ? ' · en juego' : ' · pendiente'}</option>)}
                </select>
                <button type="button" data-fecha-paso="1" aria-label="Fecha siguiente" class="adv-chip !min-h-10 !px-4"><i class="fa-solid fa-chevron-right"></i></button>
              </div>
              {e.fechas.map((f) => (
                <div data-fecha-panel={f.n} hidden={f.n !== e.actual} class="space-y-3">
                  <div class="flex flex-nowrap items-center justify-center gap-2 overflow-x-auto py-1" aria-label="Escudos de la fecha">
                    {f.partidos.flatMap((m) => [m.l, m.v]).map((n) => escudoDe(e.clubes?.[n]) && <img src={escudoDe(e.clubes[n])} alt={e.clubes[n]} title={`${n} · ${e.clubes[n]}`} width="26" height="26" loading="lazy" referrerpolicy="no-referrer" class="escudo object-contain shrink-0 opacity-90 hover:opacity-100 hover:scale-110 transition-transform" style="width:26px;height:26px" onerror="this.style.display='none'" />)}
                  </div>
                  <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-1">
                    {f.partidos.map((m) => (
                      <li data-m-l={m.l} data-m-v={m.v} class="liga-partido rounded-xl border border-galaxy-border/60 bg-black/25 px-4 py-3.5 grid grid-cols-[1fr_auto_1fr] items-center gap-3">
                        <span class="flex items-center justify-end gap-2 min-w-0 flex-nowrap"><span class="text-right min-w-0"><span class="block text-gray-100 font-display font-bold truncate">{m.l}</span>{e.clubes?.[m.l] && <span class="block text-[11px] text-gray-400 truncate uppercase">{e.clubes[m.l]}</span>}</span>{escudoDe(e.clubes?.[m.l]) && <img src={escudoDe(e.clubes[m.l])} alt="" width="28" height="28" loading="lazy" referrerpolicy="no-referrer" class="escudo object-contain shrink-0" style="width:28px;height:28px" onerror="this.style.display='none'" />}</span>
                        {Number.isInteger(m.gl) ? <span class="px-2.5 py-1 rounded-md bg-galaxy-900 border border-galaxy-600/50 font-display font-extrabold text-white tabular-nums">{m.gl} : {m.gv}</span> : <span class="px-2 text-center font-display uppercase leading-tight"><span class="block text-xs text-gray-500">vs</span>{m.h && <span class="block text-[10px] text-galaxy-400 normal-case tracking-wide">{m.h}</span>}</span>}
                        <span class="flex items-center justify-start gap-2 min-w-0 flex-nowrap">{escudoDe(e.clubes?.[m.v]) && <img src={escudoDe(e.clubes[m.v])} alt="" width="28" height="28" loading="lazy" referrerpolicy="no-referrer" class="escudo object-contain shrink-0" style="width:28px;height:28px" onerror="this.style.display='none'" />}<span class="text-left min-w-0"><span class="block text-gray-100 font-display font-bold truncate">{m.v}</span>{e.clubes?.[m.v] && <span class="block text-[11px] text-gray-400 truncate uppercase">{e.clubes[m.v]}</span>}</span></span>
                      </li>
                    ))}
                  </ul>
                  {f.estado !== 'jugada' && <p class="text-xs text-gray-500">{f.resumen.pendientes === 1 ? '1 partido sin jugar' : `${f.resumen.pendientes} partidos sin jugar`}.</p>}
                </div>
              ))}
              {e.aviso && <p class="text-xs text-amber-300/80">{e.aviso}</p>}
            </section>
            )}
            </div>
          </div>
        ))}
      </div>
    </section>
  ); })}
</Layout>
<script is:inline>
  // Antes de pintar: muestra solo la liga elegida en el enlace (#liga-…) o la primera. Si esto fallara, se ven todas.
  (function () { try { var s = [].slice.call(document.querySelectorAll('[data-liga-sec]')); if (s.length < 2) return; var h = (location.hash || '').replace('#liga-', ''); var a = s.filter(function (x) { return x.dataset.ligaSec === h })[0] || s[0]; s.forEach(function (x) { x.classList.toggle('liga-activa', x === a); }); document.documentElement.dataset.tema = a.dataset.ligaSec; document.documentElement.classList.add('liga-multi'); } catch (e) { console.warn('[liga] selector:', e); } })();
</script>
<script>
  import '../js/pages/liga.js';
</script>

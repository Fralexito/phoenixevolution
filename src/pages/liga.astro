---
// Página «Liga»: lo esencial — portada compacta, TABLA y RESULTADOS por fecha. Cada liga tiene su historial de ediciones (selector).
// Todo sale de datos (data/ligas.js + data/ligaResultados.js) y se calcula al construir la web. CopaFácil sigue siendo la fuente oficial.
import Layout from '../layouts/Layout.astro';
import { LIGAS, ETIQUETA_ESTADO } from '../data/ligas.js';
import { EDICIONES } from '../data/ligaResultados.js';
import { calcularTabla } from '../js/core/tabla.js';
import { estadoFecha, fechaActual, forma, resumenFecha } from '../js/core/ligaStats.js';
const base = import.meta.env.BASE_URL;
// Clases completas (Tailwind solo detecta nombres escritos enteros).
const CHIP = { G: 'bg-emerald-500/90 text-black', E: 'bg-amber-400/90 text-black', P: 'bg-rose-500/90 text-white' };
const ESTADO_ED = { en_curso: 'En curso', finalizada: 'Finalizada' };
const PUESTO = ['text-gold-400', 'text-gray-200', 'text-bronze-400'];

const datos = LIGAS.map((l) => ({
  liga: l,
  ediciones: (EDICIONES[l.id] ?? []).map((e) => ({
    ...e, tabla: calcularTabla(e.fechas.flatMap((f) => f.partidos)).tabla, actual: fechaActual(e.fechas),
    formas: Object.fromEntries(calcularTabla(e.fechas.flatMap((f) => f.partidos)).tabla.map((f) => [f.nombre, forma(e.fechas, f.nombre)])),
    fechas: e.fechas.map((f) => ({ ...f, estado: estadoFecha(f), resumen: resumenFecha(f) })),
  })).reverse(),   // la más reciente primero
}));
---
<Layout title="Liga" active="liga">
  <div class="max-w-5xl mx-auto px-5 sm:px-8 py-6 sm:py-8 w-full space-y-8 sm:space-y-10 pb-20">
    {LIGAS.length > 1 && (
      <nav class="flex flex-wrap gap-2" aria-label="Ligas">{LIGAS.map((l) => <a href={`#liga-${l.id}`} class="adv-chip">{l.titulo.join(' ')}</a>)}</nav>
    )}

    {datos.map(({ liga: l, ediciones }) => (
      <section id={`liga-${l.id}`} class="space-y-6 sm:space-y-8 scroll-mt-24">
        <!-- Portada compacta -->
        <div class="liga-card group">
          <img src={l.imagen} alt="" loading="eager" class="absolute inset-0 w-full h-full object-cover opacity-55 mix-blend-screen group-hover:scale-105 transition-transform duration-[1400ms] ease-out" />
          <div class="absolute inset-0 bg-gradient-to-r from-black via-galaxy-900/80 to-transparent"></div>
          <div class="relative z-10 px-5 py-6 sm:p-9 space-y-3 text-center sm:text-left">
            <div class="flex items-center justify-center sm:justify-start gap-2.5">
              <i class={`fa-solid ${l.icono} text-galaxy-400 text-2xl drop-shadow-[0_0_15px_rgba(0,229,255,0.8)]`}></i>
              <span class:list={['liga-sello', l.estado === 'proxima' ? 'liga-sello-prox' : '']}>{ETIQUETA_ESTADO[l.estado]}</span>
            </div>
            <h1 class="text-4xl sm:text-6xl font-display font-extrabold text-white uppercase leading-none text-shadow-glow">{l.titulo[0]} <span class="text-transparent bg-clip-text bg-gradient-to-r from-galaxy-400 to-galaxy-600">{l.titulo[1]}</span></h1>
            <p class="text-xs sm:text-base font-display font-light tracking-[0.25em] text-gray-300 uppercase">{l.juego}</p>
            <div class="flex flex-wrap justify-center sm:justify-start gap-3 pt-1">
              {l.copafacil && <a href={l.copafacil} target="_blank" rel="noopener noreferrer" class="hero-cta hero-cta-p !py-2.5 !px-5 !text-xs"><i class="fa-solid fa-table-list"></i> Ver en CopaFácil</a>}
              <a href={`${base}duelos/`} class="hero-cta hero-cta-s !py-2.5 !px-5 !text-xs"><i class="fa-solid fa-gamepad"></i> Sala de Duelos</a>
            </div>
          </div>
        </div>

        {ediciones.length === 0 && <p class="text-gray-400 text-sm">Esta liga aún no tiene ediciones cargadas.</p>}

        <!-- Historial: cada edición (la más reciente primero) se elige aquí; las terminadas quedan archivadas con su campeón. -->
        {ediciones.length > 0 && (
          <div class="flex items-center gap-3">
            <label for={`ed-${l.id}`} class="sr-only">Edición</label>
            <select id={`ed-${l.id}`} class="field !w-auto !bg-galaxy-900 font-display font-bold uppercase tracking-wider" data-ed-select={l.id} aria-label="Elegir edición">
              {ediciones.map((e) => <option value={e.id}>{e.nombre} · {ESTADO_ED[e.estado]}</option>)}
            </select>
          </div>
        )}

        {ediciones.map((e, idx) => (
          <div data-edicion={e.id} data-liga-ed={l.id} hidden={idx !== 0} class="space-y-8 sm:space-y-10">
            {e.estado === 'finalizada' && <p class="text-sm text-gray-200"><i class="fa-solid fa-crown text-gold-400 mr-1.5"></i>Campeón: <b class="text-white">{e.campeon ?? '—'}</b></p>}

            <!-- TABLA -->
            <section class="space-y-3" aria-label="Tabla de posiciones">
              <h2 class="font-display font-bold text-base text-white uppercase tracking-widest">Tabla de posiciones</h2>
              <div class="glass-panel rounded-2xl px-3 sm:px-5 py-2 sm:py-3">
                <table class="liga-tabla w-full">
                  <thead><tr>
                    <th class="text-left w-8">#</th><th class="text-left">Jugador</th><th>PTS</th><th>PJ</th>
                    <th class="hidden sm:table-cell">G</th><th class="hidden sm:table-cell">E</th><th class="hidden sm:table-cell">P</th>
                    <th class="hidden md:table-cell">GF</th><th class="hidden md:table-cell">GC</th><th>DIF</th><th class="hidden sm:table-cell">Forma</th>
                  </tr></thead>
                  <tbody>
                    {e.tabla.map((f, i) => (
                      <tr class:list={[i === 0 ? 'liga-lider' : '']}>
                        <td class:list={['text-left font-display font-bold', PUESTO[i] ?? 'text-gray-500']}>{i + 1}</td>
                        <td class="text-left"><span class="font-display font-bold text-white tracking-wide">{f.nombre}</span>{e.clubes?.[f.nombre] && <span class="block text-[11px] text-gray-400 leading-tight mt-0.5">{e.clubes[f.nombre]}</span>}</td>
                        <td class="font-display font-extrabold text-white text-base">{f.pts}</td><td>{f.pj}</td>
                        <td class="hidden sm:table-cell">{f.g}</td><td class="hidden sm:table-cell">{f.e}</td><td class="hidden sm:table-cell">{f.p}</td>
                        <td class="hidden md:table-cell">{f.gf}</td><td class="hidden md:table-cell">{f.gc}</td>
                        <td class:list={[f.dg > 0 ? 'text-emerald-400' : f.dg < 0 ? 'text-rose-400' : 'text-gray-400']}>{f.dg > 0 ? `+${f.dg}` : f.dg}</td>
                        <td class="hidden sm:table-cell"><span class="inline-flex gap-1">{e.formas[f.nombre].map((r) => <span class:list={['liga-forma', CHIP[r]]} title={{ G: 'Ganó', E: 'Empató', P: 'Perdió' }[r]}>{r}</span>)}</span></td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              <p class="text-xs text-gray-500 leading-relaxed">{e.formato}. 3 puntos por victoria, 1 por empate; desempata el enfrentamiento directo. PJ: partidos jugados · DIF: diferencia de goles.</p>
            </section>

            <!-- RESULTADOS por fecha -->
            <section class="space-y-3" aria-label="Resultados por fecha" data-fechas={`${l.id}:${e.id}`}>
              <h2 class="font-display font-bold text-base text-white uppercase tracking-widest">Resultados</h2>
              <div class="flex gap-2 overflow-x-auto pb-2 featured-row" role="tablist" aria-label="Fechas">
                {e.fechas.map((f) => <button type="button" role="tab" data-fecha-btn={f.n} aria-pressed={String(f.n === e.actual)} class="adv-chip shrink-0 !min-h-9 !px-3">Fecha {f.n}{f.estado !== 'jugada' && <i class="fa-solid fa-circle text-[6px] ml-1.5 align-middle text-amber-300"></i>}</button>)}
              </div>
              {e.fechas.map((f) => (
                <div data-fecha-panel={f.n} hidden={f.n !== e.actual} class="space-y-3">
                  <ul class="grid gap-3 sm:grid-cols-2">
                    {f.partidos.map((m) => (
                      <li class="rounded-xl border border-galaxy-border/60 bg-black/25 px-4 py-3.5 grid grid-cols-[1fr_auto_1fr] items-center gap-3">
                        <span class="text-right text-gray-100 font-display font-bold truncate">{m.l}</span>
                        {Number.isInteger(m.gl) ? <span class="px-2.5 py-1 rounded-md bg-galaxy-900 border border-galaxy-600/50 font-display font-extrabold text-white tabular-nums">{m.gl} : {m.gv}</span> : <span class="px-2 text-xs text-gray-500 font-display uppercase">vs</span>}
                        <span class="text-left text-gray-100 font-display font-bold truncate">{m.v}</span>
                      </li>
                    ))}
                  </ul>
                  {f.estado !== 'jugada' && <p class="text-xs text-gray-500">{f.resumen.pendientes === 1 ? '1 partido sin jugar' : `${f.resumen.pendientes} partidos sin jugar`}.</p>}
                </div>
              ))}
              {e.aviso && <p class="text-xs text-amber-300/80">{e.aviso}</p>}
            </section>
          </div>
        ))}
      </section>
    ))}
  </div>
</Layout>
<script>
  import '../js/pages/liga.js';
</script>

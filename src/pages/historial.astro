---
// Página «Historial de partidos»: TODOS los partidos de todas las ligas, con filtros (liga, estado, texto) y paginación. La pinta js/pages/historialPartidos.js.
import Layout from '../layouts/Layout.astro';
import { LIGAS } from '../data/ligas.js';
---
<Layout title="Historial de partidos" active="historial" description="Todos los partidos de Phoenix Evolution Series: resultados, pendientes y detalle de goles, con filtros por liga, jugador y estado.">

  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-6 sm:py-8 space-y-4 pb-20">
    <header class="glass-panel px-4 py-3 rounded-2xl">
      <span class="text-[12px] font-display font-bold text-galaxy-400 uppercase tracking-widest bg-galaxy-600/20 px-2 py-0.5 rounded border border-galaxy-400/30">Archivo de la comunidad</span>
      <h1 class="text-xl sm:text-2xl font-display font-extrabold text-white uppercase tracking-wider text-shadow-glow mt-1"><i class="fa-solid fa-clock-rotate-left text-galaxy-400 mr-2"></i>Historial de partidos</h1>
      <p class="text-gray-300 text-xs mt-0.5">Cada partido jugado en la plataforma. Toca uno para ver sus goles, minutos y asistencias.</p>
    </header>
    <form id="hp-filtros" class="glass-panel rounded-2xl p-3 sm:p-4 grid gap-2 sm:grid-cols-[1fr_auto_auto] items-center" role="search" aria-label="Filtrar partidos">
      <label class="relative block"><span class="sr-only">Buscar jugador, club o fecha</span><i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 text-sm"></i>
        <input id="hp-q" type="search" maxlength="40" autocomplete="off" placeholder="Jugador, club o «fecha 8»" class="field !pl-9 w-full"></label>
      <select id="hp-liga" class="field" aria-label="Liga"><option value="">Todas las ligas</option>{LIGAS.map((l) => <option value={l.id}>{l.titulo.join(' ')}</option>)}</select>
      <select id="hp-estado" class="field" aria-label="Estado del partido">
        <option value="jugados">Jugados</option><option value="pendientes">Pendientes</option><option value="aplazado">Aplazados</option><option value="wo">WO</option><option value="incidencia">En revisión</option>
      </select>
    </form>
    <p id="hp-resumen" class="text-xs text-gray-400" aria-live="polite"></p>
    <div id="hp-lista" class="grid gap-2.5" aria-live="polite"><div class="esqueleto h-20"></div><div class="esqueleto h-20"></div><div class="esqueleto h-20"></div></div>
    <nav id="hp-paginas" class="flex items-center justify-between gap-3 pt-2" aria-label="Paginación"></nav>
  </div>
</Layout>
<script>
  import '../js/pages/historialPartidos.js';
</script>

---
import Layout from '../layouts/Layout.astro';
import { PODIO, TABS } from '../data/palmares.js';
---
<Layout title="Palmarés" active="palmares">
  <div class="max-w-[1250px] mx-auto px-4 sm:px-6 lg:px-8 py-6 w-full space-y-6 pb-16">

    <section class="relative rounded-2xl border border-gold-500/30 shadow-[0_0_30px_rgba(245,158,11,0.12)] overflow-hidden p-5 md:p-6 flex flex-col md:flex-row items-center justify-between gap-4">
      <div class="absolute inset-0 bg-gradient-to-r from-galaxy-dark via-galaxy-900/90 to-galaxy-dark z-10"></div>
      <img src="https://images.unsplash.com/photo-1518605368461-1e1e38ce81f6?q=80&w=1200&auto=format&fit=crop" alt="" loading="lazy" class="absolute inset-0 w-full h-full object-cover opacity-20 mix-blend-screen z-0" />
      <div class="relative z-20 text-center md:text-left flex-1 space-y-1">
        <div class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded bg-gold-500/20 border border-gold-500/40 text-gold-400 text-[12px] font-bold uppercase tracking-widest"><i class="fa-solid fa-crown"></i> Salón de la Fama</div>
        <h1 class="text-2xl md:text-4xl font-display font-black text-white uppercase tracking-wider text-shadow-glow">VITRINA <span class="text-transparent bg-clip-text bg-gradient-to-r from-gold-300 via-gold-500 to-yellow-600">INMORTAL</span></h1>
        <p class="text-gray-300 text-xs max-w-lg">El altar definitivo de la competición. Reinados históricos y galardones de la Galaxy League.</p>
      </div>
      <div class="relative z-20 bg-galaxy-panel/90 backdrop-blur-md p-3 rounded-xl border border-galaxy-400/40 w-full md:w-64">
        <label for="timeline" class="block text-[12px] font-bold text-galaxy-400 uppercase tracking-widest mb-1"><i class="fa-solid fa-clock-rotate-left mr-1"></i> Línea de Tiempo</label>
        <select id="timeline" class="field !bg-galaxy-900 font-display font-bold uppercase tracking-wider">
          <option>1° Edición</option><option disabled>Copa Libertadores (Próx.)</option>
        </select>
      </div>
    </section>

    <section class="space-y-3">
      <div class="text-center space-y-0.5">
        <span class="text-gold-500 tracking-[0.2em] text-[12px] font-bold uppercase">Podio Principal</span>
        <h2 class="text-xl md:text-2xl font-display font-black text-white uppercase tracking-widest text-shadow-glow">Los Reyes de la Edición</h2>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 items-center max-w-4xl mx-auto pt-2">
        {PODIO.map((p) => (
          <div class={`premium-glass rounded-2xl flex flex-col items-center text-center ${p.card}`}>
            {p.gold && <div class="absolute top-0 inset-x-0 h-1 bg-gradient-to-r from-gold-600 via-gold-300 to-gold-600"></div>}
            <i class={`fa-solid fa-trophy ${p.icon}`}></i>
            <p class={`${p.label} uppercase tracking-widest font-bold mb-1`}>{p.copa}</p>
            <h3 class="font-display font-black text-xl text-white uppercase tracking-wide mb-2.5">{p.dt}</h3>
            <div class={`w-full pt-2.5 border-t ${p.rule} flex items-center justify-center gap-2`}>
              <span class={`w-7 h-7 rounded-full bg-gradient-to-br border flex items-center justify-center font-display font-bold text-[12px] ${p.badge}`}>{p.sigla}</span>
              <p class={`text-[12px] font-bold uppercase ${p.clubCls}`}>{p.club}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="space-y-4 pt-2" id="palmares-root">
      <div role="tablist" class="flex flex-wrap justify-center gap-2 bg-black/60 p-1.5 rounded-xl border border-galaxy-border max-w-xl mx-auto backdrop-blur-md">
        {TABS.map((t, i) => (
          <button type="button" role="tab" data-tab={t.id} aria-selected={String(i === 0)} class="tab-btn flex-1 min-w-[100px] py-2 px-3 rounded-lg font-display font-bold text-[12px] uppercase tracking-wider text-gray-400 hover:text-white transition-all flex items-center justify-center gap-1">
            <i class={`fa-solid ${t.icon}`}></i> {t.label}
          </button>
        ))}
      </div>

      {TABS.map((t, i) => (
        <div data-pane={t.id} role="tabpanel" hidden={i !== 0} class="space-y-3 animate-fade-in">
          <div class={`border-l-4 ${t.border} pl-3`}>
            <h3 class="text-xl font-display font-bold text-white uppercase tracking-widest">{t.titulo}</h3>
            <p class="text-gray-400 text-xs">{t.sub}</p>
          </div>
          <div class={`grid ${t.grid} gap-3.5`}>
            {t.items.map((x) => {
              if (t.kind === 'award') return (
                <div class={`premium-glass p-4 rounded-xl border ${x.box}`}>
                  <div class={`w-7 h-7 rounded-lg flex items-center justify-center mb-2 text-[12px] ${x.chip}`}><i class={`fa-solid ${x.icon}`}></i></div>
                  <h4 class="font-display font-bold text-sm text-white uppercase">{x.t}</h4>
                  <p class="text-[12px] text-gray-400 uppercase tracking-widest mb-1">{x.s}</p>
                  <span class={`text-lg font-display font-black block ${x.name}`}>{x.who}</span>
                  <p class="text-[12px] text-gray-300 mt-1">{x.d}</p>
                </div>);
              if (t.kind === 'community') return (
                <div class={`bg-gradient-to-br from-galaxy-900 to-black p-4 rounded-xl border text-center ${x.box}`}>
                  <i class={`fa-solid ${x.icon} text-xl mb-1.5 ${x.ico}`}></i>
                  <h4 class="font-display font-bold text-white uppercase text-xs">{x.t}</h4>
                  <p class="text-[12px] text-gray-400 uppercase tracking-widest mb-1">{x.s}</p>
                  <span class={`text-base font-display font-black block ${x.name}`}>{x.who}</span>
                </div>);
              if (t.kind === 'olimpo') return (
                <div class={`premium-glass p-3 rounded-xl border flex items-center gap-3 ${x.box}`}>
                  <span class={`w-8 h-8 rounded-full bg-black border flex items-center justify-center shrink-0 text-xs ${x.ring}`}><i class={`fa-solid ${x.icon} ${x.col}`}></i></span>
                  <div><p class={`text-[12px] uppercase font-bold tracking-widest ${x.col}`}>{x.t}</p>
                    <h4 class="font-display font-bold text-sm text-white uppercase">{x.who} <span class="text-[12px] text-gray-400">{x.extra}</span></h4></div>
                </div>);
              return (
                <div class="bg-black/40 border border-galaxy-border p-3.5 rounded-xl text-center">
                  <h5 class="text-[12px] text-gray-400 uppercase tracking-widest mb-1">{x.t}</h5>
                  <span class={`text-xl font-display font-black block mb-0.5 ${x.col}`}>{x.v}</span>
                  <p class="text-[12px] text-white">{x.d}</p>
                </div>);
            })}
          </div>
        </div>
      ))}
    </section>
  </div>
</Layout>
<script>
  // Pestañas: un solo manejador para las 4 secciones.
  const root = document.getElementById('palmares-root');
  root?.addEventListener('click', (e) => {
    const b = e.target.closest('[data-tab]'); if (!b) return;
    root.querySelectorAll('[data-tab]').forEach((x) => x.setAttribute('aria-selected', String(x === b)));
    root.querySelectorAll('[data-pane]').forEach((p) => { p.hidden = p.dataset.pane !== b.dataset.tab; });
  });
</script>

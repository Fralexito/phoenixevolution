---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---
<Layout title="Mercado" active="mercado">
  <div class="max-w-3xl mx-auto px-4 py-24 text-center space-y-5">
    <div class="animate-float"><i class="fa-solid fa-handshake text-galaxy-400 text-6xl drop-shadow-[0_0_15px_rgba(0,229,255,0.6)]"></i></div>
    <span class="inline-block text-xs font-display font-bold text-galaxy-400 uppercase tracking-widest bg-galaxy-600/20 px-3 py-1 rounded border border-galaxy-400/30">Próximamente</span>
    <h1 class="text-4xl md:text-5xl font-display font-extrabold text-white uppercase tracking-wider text-shadow-glow">MERCADO DE FICHAJES</h1>
    <p class="text-gray-400 text-sm">El sistema de fichajes está en pausa reglamentaria. Muy pronto podrás comprar, vender y negociar jugadores aquí.</p>
    <a href={base} class="btn btn-primary inline-flex"><i class="fa-solid fa-house"></i> Volver a Central</a>
  </div>
</Layout>

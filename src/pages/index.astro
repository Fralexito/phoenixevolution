---
import Layout from '../layouts/Layout.astro';
import { DEMO_CLIPS } from '../data/demo.js';
import { LIGAS, ETIQUETA_ESTADO } from '../data/ligas.js';
const base = import.meta.env.BASE_URL;
---
<Layout title="Central" active="central">
  <!-- 1. PORTADA de Central (la original de la base). La ficha completa de cada liga vive en la página «Liga». -->
  <header class="relative flex flex-col overflow-hidden pt-6 pb-8 sm:pb-14 px-4 sm:px-6 lg:px-8 min-h-[calc(100svh-6.1rem)] sm:min-h-[calc(100svh-7rem)] border-b border-galaxy-border/40">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[550px] h-[550px] bg-galaxy-600/20 rounded-full blur-[130px] pointer-events-none"></div>
    <div class="flex-1 flex items-center justify-center w-full"><div class="max-w-4xl mx-auto text-center relative z-10 space-y-6">
      <span class="inline-block text-xs font-display font-bold text-galaxy-400 uppercase tracking-widest bg-galaxy-600/20 px-3 py-1 rounded border border-galaxy-400/30 shadow-[0_0_15px_rgba(0,229,255,0.2)]">Temporada Oficial 2026</span>
      <h1 class="text-4xl sm:text-6xl md:text-7xl font-display font-extrabold text-white uppercase tracking-wider leading-tight">
        EL SHOW MÁXIMO DE LA <span class="text-transparent bg-clip-text bg-gradient-to-r from-galaxy-400 via-galaxy-500 to-galaxy-600 text-shadow-glow">GALAXY LEAGUE</span>
      </h1>
      <p class="text-gray-300 text-sm sm:text-base md:text-lg max-w-2xl mx-auto">Comunidad competitiva de simulación futbolística. Matchmaking punto a punto, hosting remoto, transferencias de mercado y disputas de honor sobre el campo virtual.</p>
      <div class="flex flex-wrap items-center justify-center gap-4 pt-4">
        <a href={`${base}duelos/`} class="bg-gradient-to-r from-galaxy-600 to-galaxy-700 hover:from-galaxy-500 hover:to-galaxy-600 text-white font-display font-bold px-8 py-3.5 rounded-xl text-sm uppercase tracking-wider transition-all shadow-[0_0_25px_rgba(128,0,255,0.4)] flex items-center gap-2"><i class="fa-solid fa-gamepad"></i> Sala de Duelos</a>
        <a href={`${base}database/`} class="glass-panel hover:bg-white/10 text-white font-display font-bold px-8 py-3.5 rounded-xl text-sm uppercase tracking-wider hover:border-galaxy-400 transition-all flex items-center gap-2"><i class="fa-solid fa-chart-simple"></i> Jugadores</a>
      </div>
    </div></div>
  <!-- PULSO DE LA COMUNIDAD (dentro de la portada, bajo los botones): cifras reales (se leen de la base al cargar; «—» si no se pudo leer) -->
  <section aria-label="Pulso de la comunidad" class="relative z-10 w-full grid grid-cols-2 lg:grid-cols-4 gap-2.5 sm:gap-4 pt-6 text-left">
    {[
      { id: 'jugadores', icon: 'fa-id-card', label: 'Fichas de jugador', href: 'database/' },
      { id: 'comunidad', icon: 'fa-users', label: 'Jugadores registrados', href: 'duelos/' },
      { id: 'hosts', icon: 'fa-tower-broadcast', label: 'Hosts disponibles', href: 'duelos/' },
      { id: 'retos', icon: 'fa-bolt', label: 'Retos abiertos', href: 'duelos/' },
    ].map((t) => (
      <a href={`${base}${t.href}`} class="pulse-tile group">
        <i class={`fa-solid ${t.icon} pulse-ico`}></i>
        <span class="pulse-num" id={`pulso-${t.id}`}>—</span>
        <span class="pulse-lbl">{t.label}</span>
      </a>
    ))}
  </section>
  </header>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8 w-full space-y-8 sm:space-y-10">

    <!-- 1b. COMPETICIONES: solo aparece cuando hay más de una liga (data/ligas.js); cada tarjeta lleva a la página «Liga». -->
    {LIGAS.length > 1 && (
      <section aria-label="Competiciones" class="space-y-3">
        <h2 class="font-display font-bold text-xs text-gray-400 uppercase tracking-widest">Competiciones</h2>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {LIGAS.map((l) => (
            <a href={`${base}liga/#liga-${l.id}`} class="liga-card group min-h-[170px] block">
              <div class="absolute inset-0 bg-gradient-to-r from-black via-galaxy-900/80 to-transparent z-10"></div>
              <img src={l.imagen} alt="" loading="lazy" class="absolute inset-0 w-full h-full object-cover opacity-60 mix-blend-screen group-hover:scale-105 transition-transform duration-[1400ms] ease-out" />
              <div class="relative z-20 p-5 flex flex-col justify-end h-full min-h-[170px]">
                <span class:list={['liga-sello self-start mb-2', l.estado === 'proxima' ? 'liga-sello-prox' : '']}>{ETIQUETA_ESTADO[l.estado]}</span>
                <h3 class="text-2xl font-display font-bold text-white uppercase leading-none">{l.titulo[0]} <span class="text-galaxy-400">{l.titulo[1]}</span></h3>
                <p class="text-xs font-display tracking-[0.2em] text-gray-300 uppercase mt-1">{l.juego}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- 3. CENTRAL DE PARTIDOS (con el partido destacado dentro) + clasificación y XI al costado -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-8 items-start">
      <section id="central-partidos" class="lg:col-span-2 space-y-4 scroll-mt-32">
        <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-2 border-b border-galaxy-border pb-2">
          <h2 class="text-xl sm:text-2xl font-display font-bold text-white uppercase tracking-wider text-shadow-glow">Central de Partidos</h2>
          <div class="seg adv-seg" id="seg-partidos" role="group" aria-label="Tipo de partidos">
            <button type="button" data-v="proximos" aria-pressed="true">Próximos</button>
            <button type="button" data-v="resultados" aria-pressed="false">Resultados</button>
          </div>
        </div>

        <article class="glass-panel rounded-xl overflow-hidden relative">
          <div class="absolute top-0 right-0 bg-galaxy-600 text-white text-[10px] font-bold px-3 py-1 rounded-bl-lg uppercase tracking-widest z-10"><i class="fa-solid fa-fire mr-1"></i> Partido Destacado</div>
          <div class="absolute inset-0 bg-gradient-to-r from-blue-900/20 via-transparent to-white/10"></div>
          <div class="relative z-10 p-4 sm:p-6 pt-9 sm:pt-8 grid grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] items-center gap-2 sm:gap-4">
            <div class="flex flex-col-reverse sm:flex-row items-center gap-2 sm:gap-4 sm:justify-end text-center sm:text-right min-w-0">
              <div class="min-w-0">
                <div class="inline-flex items-center gap-1.5 px-2 py-0.5 whitespace-nowrap rounded bg-emerald-500/20 border border-emerald-500/40 text-[10px] text-emerald-400 font-bold mb-1"><span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span> HOST ACTIVO</div>
                <h3 class="font-display font-bold text-xl sm:text-3xl text-white text-shadow-glow truncate">FRALEX</h3>
                <p class="text-[11px] sm:text-sm text-galaxy-400 uppercase tracking-widest font-bold truncate">FC Barcelona</p>
              </div>
              <div class="w-14 h-14 sm:w-20 sm:h-20 shrink-0 rounded-full border-2 border-blue-500 bg-gradient-to-br from-blue-800 to-red-800 flex items-center justify-center font-display font-bold text-lg sm:text-2xl text-white shadow-[0_0_20px_rgba(37,99,235,0.5)]">FCB</div>
            </div>
            <div class="flex flex-col items-center">
              <span class="font-display font-bold text-2xl sm:text-4xl text-galaxy-400 italic drop-shadow-[0_0_10px_rgba(0,229,255,0.8)]">VS</span>
              <span class="text-[9px] sm:text-[10px] text-gray-500 uppercase tracking-widest mt-1 text-center">Parsec · Próximamente</span>
            </div>
            <div class="flex flex-col-reverse sm:flex-row-reverse items-center gap-2 sm:gap-4 sm:justify-end text-center sm:text-left min-w-0">
              <div class="min-w-0">
                <div class="inline-flex items-center gap-1.5 px-2 py-0.5 whitespace-nowrap rounded bg-blue-500/20 border border-blue-500/40 text-[10px] text-blue-400 font-bold mb-1"><i class="fa-solid fa-network-wired text-[9px]"></i> CLIENTE</div>
                <h3 class="font-display font-bold text-xl sm:text-3xl text-white text-shadow-glow truncate">AXEL</h3>
                <p class="text-[11px] sm:text-sm text-galaxy-400 uppercase tracking-widest font-bold truncate">Real Madrid</p>
              </div>
              <div class="w-14 h-14 sm:w-20 sm:h-20 shrink-0 rounded-full border-2 border-gray-300 bg-gradient-to-br from-gray-100 to-gray-400 flex items-center justify-center font-display font-bold text-lg sm:text-2xl text-black shadow-[0_0_20px_rgba(255,255,255,0.3)]">RMA</div>
            </div>
          </div>
        </article>

        <div class="grid gap-3" id="matches-container" aria-live="polite"></div>
        <a href={`${base}duelos/`} class="flex items-center justify-center gap-2 text-xs font-display font-bold text-galaxy-400 hover:text-white uppercase tracking-wider border border-dashed border-galaxy-400/30 rounded-xl py-3 hover:border-galaxy-400 transition-colors"><i class="fa-solid fa-gamepad"></i> Ver retos abiertos en la Sala de Duelos <i class="fa-solid fa-arrow-right"></i></a>
      </section>

      <aside class="space-y-5">
        <section class="glass-panel rounded-xl overflow-hidden">
          <div class="bg-gradient-to-r from-galaxy-900 to-black px-4 py-3 border-b border-galaxy-border flex justify-between items-center">
            <h3 class="font-display font-bold text-lg uppercase tracking-wider text-white">Posiciones</h3><i class="fa-solid fa-trophy text-galaxy-400"></i>
          </div>
          <div class="p-4 overflow-auto max-h-[260px]">
            <table class="w-full text-left text-sm">
              <thead><tr class="text-gray-500 border-b border-galaxy-border/50"><th class="pb-2 font-semibold">Pos</th><th class="pb-2 font-semibold">Club / DT</th><th class="pb-2 text-center font-semibold text-galaxy-400">PTS</th></tr></thead>
              <tbody id="mini-table-container"></tbody>
            </table>
          </div>
        </section>
        <!-- En celular el XI viene plegado para no alargar la página (central.js lo abre en PC). -->
        <details id="xi-det" open class="glass-panel rounded-2xl overflow-hidden shadow-[0_0_25px_rgba(128,0,255,0.2)]">
          <summary class="bg-galaxy-dark/80 px-4 py-3 border-b border-galaxy-border/60 cursor-pointer flex items-center justify-between list-none">
            <h3 class="font-display font-bold text-sm uppercase tracking-widest text-galaxy-400 text-shadow-glow">XI IDEAL DE LA FECHA</h3><i class="fa-solid fa-chevron-down text-galaxy-400 text-xs xi-chev"></i>
          </summary>
          <div class="tactical-pitch w-full h-[250px] p-4 relative overflow-hidden flex flex-col justify-between">
            <div class="absolute inset-x-4 top-0 h-16 border-b border-x border-galaxy-400/25"></div>
            <div class="absolute inset-x-0 top-1/2 -translate-y-1/2 h-px bg-galaxy-400/25"></div>
            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-20 h-20 rounded-full border border-galaxy-400/25"></div>
            <div class="absolute inset-x-4 bottom-0 h-16 border-t border-x border-galaxy-400/25"></div>
            <div id="xi-container" class="contents"></div>
          </div>
        </details>
      </aside>
    </div>

    <!-- 4. JUGADORES DESTACADOS: en celular, carrusel que se desliza de lado -->
    <section class="space-y-4">
      <div class="flex items-center justify-between">
        <h2 class="text-xl sm:text-2xl font-display font-bold text-white uppercase tracking-wider text-shadow-glow">Jugadores Destacados</h2>
        <a href={`${base}database/`} class="text-xs font-display font-bold text-galaxy-400 hover:text-white uppercase flex items-center gap-1.5 border border-galaxy-400/30 bg-galaxy-400/10 px-3 py-1.5 rounded hover:bg-galaxy-400/20 transition-colors">Ver todos <i class="fa-solid fa-arrow-right"></i></a>
      </div>
      <div class="podio" id="featured-players-container"><div class="text-center py-6 text-gray-400 text-sm w-full">Conectando con la base de datos...</div></div>
    </section>

    <!-- 5. HIGHLIGHTS: video principal grande + lista de clips al costado (en celular, debajo) -->
    <section class="space-y-4">
      <div class="flex items-center justify-between">
        <h2 class="text-xl sm:text-2xl font-display font-bold text-white uppercase tracking-wider text-shadow-glow flex items-center gap-2"><i class="fa-solid fa-video text-galaxy-400 text-lg"></i> Highlights<span class="hidden sm:inline"> de la jornada</span></h2>
        <a href="https://youtube.com" target="_blank" rel="noopener" class="text-galaxy-400 hover:text-white text-xs font-display font-bold tracking-wider uppercase flex items-center gap-1.5 whitespace-nowrap"><i class="fa-brands fa-youtube text-red-500 text-sm"></i> Ver canal</a>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 lg:gap-6">
        <div class="lg:col-span-2 glass-panel rounded-2xl overflow-hidden relative aspect-video w-full flex items-center justify-center group shadow-[0_0_35px_rgba(128,0,255,0.25)]">
          <img src="https://images.unsplash.com/photo-1574629810360-7efbbe195018?q=80&w=1400&auto=format&fit=crop" alt="" loading="lazy" class="absolute inset-0 w-full h-full object-cover opacity-40 group-hover:scale-105 transition-transform duration-700" />
          <div class="absolute inset-0 bg-gradient-to-t from-galaxy-dark via-galaxy-dark/40 to-transparent"></div>
          <div class="relative z-10 w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-galaxy-600/90 border border-galaxy-400/80 flex items-center justify-center shadow-[0_0_30px_rgba(128,0,255,0.8)] group-hover:scale-110 transition-all duration-300"><i class="fa-solid fa-play text-white text-xl sm:text-2xl pl-1"></i></div>
          <div class="absolute bottom-4 sm:bottom-6 left-4 sm:left-6 right-4 z-10 text-left">
            <span class="px-2 py-0.5 rounded bg-red-600 text-white font-bold text-[10px] uppercase tracking-wider inline-block mb-1">TOP 5</span>
            <h3 class="text-xl sm:text-3xl font-display font-bold text-white uppercase tracking-wide text-shadow-glow">Mejores goles: Jornada 3</h3>
            <p class="text-xs text-gray-300 mt-0.5">Resumen oficial · Galaxy League PES</p>
          </div>
        </div>
        <div class="space-y-2.5">
          <h3 class="font-display font-bold text-xs text-gray-400 uppercase tracking-widest">Más clips</h3>
          {DEMO_CLIPS.map((c) => (
            <a href="https://youtube.com" target="_blank" rel="noopener" class="clip-row group/clip">
              <span class="clip-thumb"><i class="fa-solid fa-play"></i></span>
              <span class="min-w-0 flex-1"><b class="clip-tag">{c.tag}</b><span class="block text-sm text-white font-semibold leading-snug truncate">{c.titulo}</span></span>
              <span class="text-[11px] text-gray-400 font-display tabular-nums shrink-0">{c.dur}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- 6. INVITACIÓN FINAL -->
    <section class="glass-panel rounded-2xl p-5 sm:p-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
      <div>
        <h2 class="font-display font-bold text-lg sm:text-xl text-white uppercase tracking-wider">¿Listo para entrar a la Galaxy?</h2>
        <p class="text-sm text-gray-400 mt-0.5">La comunidad vive en Discord: ahí se pactan partidas, se arman torneos y se avisa cada novedad.</p>
      </div>
      <a href="https://discord.gg/jsxZ3mtfwe" target="_blank" rel="noopener" class="shrink-0 bg-[#5865F2] hover:bg-[#4752c4] text-white font-display font-bold px-6 py-3 rounded-xl text-sm uppercase tracking-wider transition-colors flex items-center gap-2"><i class="fa-brands fa-discord text-lg"></i> Unirme al Discord</a>
    </section>
  </div>
</Layout>
<script>
  import '../js/pages/central.js';
</script>

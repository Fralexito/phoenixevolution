---
import Layout from '../layouts/Layout.astro';
import { FX } from '../data/experimento.js';
import Plegable from '../components/Plegable.astro';
import { DEMO_CLIPS } from '../data/demo.js';
import { LIGAS, ETIQUETA_ESTADO } from '../data/ligas.js';
const base = import.meta.env.BASE_URL;
// «¿Qué quieres hacer?»: las acciones más buscadas, a un clic desde Central. `invitado` = solo sin sesión; `cuenta` = solo con sesión (lo decide html[data-sesion]).
const ACCIONES = [
  { href: 'duelos/', icono: 'fa-gamepad', titulo: 'Jugar un reto', txt: 'Reta a alguien y arma la sala', tono: 'primario' },
  { href: 'ahora/', icono: 'fa-tower-broadcast', titulo: 'Ver en vivo', txt: 'Partidos y retos en este momento' },
  { href: 'liga/', icono: 'fa-table-list', titulo: 'Tabla de la liga', txt: 'Posiciones, fechas y resultados' },
  { href: 'noticias/', icono: 'fa-newspaper', titulo: 'Noticias', txt: 'Lo oficial y la Tribuna' },
  { href: 'mis-salas/', icono: 'fa-desktop', titulo: 'Vincular mi PC', txt: 'Phoenix Soda y Parsec', cuenta: true },
  { href: 'unirme/', icono: 'fa-door-open', titulo: 'Unirme a la liga', txt: 'Inscríbete para la próxima edición', invitado: true },
];
---
<Layout title="Central" active="central">
  <!-- 1. PORTADA de Central (la original de la base). La ficha completa de cada liga vive en la página «Liga». -->
  <header class="relative flex flex-col justify-center overflow-hidden pt-4 pb-16 sm:pt-8 sm:pb-16 px-4 sm:px-6 lg:px-8 border-b border-galaxy-border/40">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[550px] h-[550px] bg-galaxy-600/20 rounded-full blur-[130px] pointer-events-none"></div>
    <div class="hero-aurora" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="flex items-center justify-center w-full"><div class="max-w-4xl mx-auto text-center relative z-10 space-y-3 sm:space-y-5">
      <span class="inline-block text-xs font-display font-bold text-galaxy-400 uppercase tracking-widest bg-galaxy-600/20 px-3 py-1 rounded border border-galaxy-400/30 shadow-[0_0_15px_rgba(0,229,255,0.2)]">Temporada Oficial 2026</span>
      <h1 class="text-[1.85rem] leading-[1.15] sm:text-5xl md:text-6xl font-display font-extrabold text-white uppercase tracking-wider sm:leading-tight">
        EL SHOW MÁXIMO DE<br class="hidden sm:inline" /> LA <span class="text-transparent bg-clip-text bg-gradient-to-r from-galaxy-400 via-galaxy-500 to-galaxy-600 text-shadow-glow">GALAXY LEAGUE</span>
      </h1>
      <p class="text-gray-300 text-[13px] leading-snug sm:leading-normal sm:text-base md:text-lg max-w-2xl mx-auto">Comunidad competitiva de simulación futbolística. Matchmaking punto a punto, hosting remoto, transferencias de mercado y disputas de honor sobre el campo virtual.</p>
      {!FX.limpio && <Fragment>
      <div class="flex flex-nowrap sm:flex-wrap items-center justify-center gap-2 sm:gap-4 pt-1 sm:pt-4">
        <a href={`${base}duelos/`} class="bg-gradient-to-r from-galaxy-600 to-galaxy-700 hover:from-galaxy-500 hover:to-galaxy-600 text-white font-display font-bold px-4 sm:px-8 py-2.5 sm:py-3.5 rounded-xl text-xs sm:text-sm uppercase tracking-wider transition-all shadow-[0_0_25px_rgba(128,0,255,0.4)] flex items-center gap-2"><i class="fa-solid fa-gamepad"></i> Sala de Duelos</a>
        <a href={`${base}database/`} class="glass-panel hover:bg-white/10 text-white font-display font-bold px-4 sm:px-8 py-2.5 sm:py-3.5 rounded-xl text-xs sm:text-sm uppercase tracking-wider hover:border-galaxy-400 transition-all flex items-center gap-2"><i class="fa-solid fa-chart-simple"></i> Jugadores</a>
      </div>
      <p class="pt-1"><a href={`${base}unirme/`} class="inline-flex items-center gap-2 text-[12px] sm:text-xs font-display font-bold uppercase tracking-widest text-galaxy-400 hover:text-white border border-galaxy-400/30 bg-galaxy-400/10 hover:bg-galaxy-400/20 px-3.5 py-1.5 rounded-full transition-colors"><i class="fa-solid fa-door-open"></i> ¿Eres nuevo? Únete a la liga en 5 pasos <i class="fa-solid fa-arrow-right"></i></a></p>
      </Fragment>}
    </div></div>
  <!-- PULSO DE LA COMUNIDAD (dentro de la portada, bajo los botones): cifras reales (se leen de la base al cargar; «—» si no se pudo leer) -->
  {FX.limpio ? (
    <div class="relative z-10 w-full max-w-5xl mx-auto pt-6 sm:pt-8 space-y-4">
      <div class="acciones-grid acciones-hero">
        {ACCIONES.map((a) => (
          <a href={`${base}${a.href}`} class:list={['accion', a.tono === 'primario' && 'accion-primaria', a.invitado && 'solo-invitado', a.cuenta && 'solo-cuenta']}>
            <i class={`fa-solid ${a.icono}`}></i><span><b>{a.titulo}</b><small>{a.txt}</small></span>
          </a>
        ))}
      </div>
      <p class="pulso-linea" aria-label="Pulso de la comunidad">
        {[['jugadores', 'fichas', 'database/'], ['comunidad', 'registrados', 'database/'], ['hosts', 'hosts listos', 'duelos/'], ['retos', 'retos abiertos', 'duelos/']].map(([id, txt, href]) => (
          <a href={`${base}${href}`}><b id={`pulso-${id}`}>—</b> {txt}</a>
        ))}
      </p>
    </div>
  ) : (<Fragment>
  <section aria-label="Pulso de la comunidad" class="relative z-10 w-full grid grid-cols-2 lg:grid-cols-4 gap-2 sm:gap-4 pt-5 sm:pt-8 text-left">
    {[
      { id: 'jugadores', icon: 'fa-id-card', label: 'Fichas de jugador', href: 'database/' },
      { id: 'comunidad', icon: 'fa-users', label: 'Jugadores registrados', href: 'duelos/' },
      { id: 'hosts', icon: 'fa-tower-broadcast', label: 'Hosts disponibles', href: 'duelos/' },
      { id: 'retos', icon: 'fa-bolt', label: 'Retos abiertos', href: 'duelos/' },
    ].map((t) => (
      <a href={`${base}${t.href}`} class="pulse-tile group">
        <i class={`fa-solid ${t.icon} pulse-ico`}></i>
        <span class="pulse-num" id={`pulso-${t.id}`}>—</span>
        <span class="pulse-lbl">{t.label}</span>
      </a>
    ))}
  </section>
  </Fragment>)}
  </header>

  <div class:list={["max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8 w-full", FX.limpio ? "space-y-12 sm:space-y-16" : "space-y-8 sm:space-y-10"]}>

    {!FX.limpio && <Fragment>
    <!-- 00. ¿QUÉ QUIERES HACER? Accesos directos a lo más usado (que nada importante quede escondido en menús). -->
    <section aria-labelledby="acc-t" class="acciones">
      <h2 id="acc-t" class="acciones-tit">¿Qué quieres hacer?</h2>
      <div class="acciones-grid">
        {ACCIONES.map((a) => (
          <a href={`${base}${a.href}`} class:list={['accion', a.tono === 'primario' && 'accion-primaria', a.invitado && 'solo-invitado', a.cuenta && 'solo-cuenta']}>
            <i class={`fa-solid ${a.icono}`}></i><span><b>{a.titulo}</b><small>{a.txt}</small></span><i class="fa-solid fa-arrow-right accion-flecha"></i>
          </a>
        ))}
      </div>
    </section>

    </Fragment>}
    <!-- 0. ESTADO DE LA LIGA: franja compacta («en juego · fecha · avance»). La pinta js/pages/central.js con los datos reales de la edición en curso. -->
    <a id="estado-liga" hidden href={`${base}liga/#liga-galaxy`} class="estado-liga" aria-live="polite"></a>

    <!-- 0b. SALTO RÁPIDO entre secciones (pegajosa bajo la cabecera). Las minisecciones plegadas se abren al saltar a ellas (js/pages/central.js). -->
{(<nav class="anclas" aria-label="Saltar a una sección">
      <a href="#central-partidos"><i class="fa-solid fa-futbol"></i>Partidos</a>
      <a href="#pos-seccion"><i class="fa-solid fa-trophy"></i>Posiciones</a>
      <a href="#rank-liga"><i class="fa-solid fa-ranking-star"></i>Clubes</a>
      <a href="#destacados-seccion"><i class="fa-solid fa-id-card"></i>Jugadores</a>
      {FX.highlightsDemo && <a href="#highlights"><i class="fa-solid fa-video"></i>Highlights</a>}
    </nav>)}

    <!-- 1b. COMPETICIONES: solo aparece cuando hay más de una liga (data/ligas.js); cada tarjeta lleva a la página «Liga». -->
    {LIGAS.filter((l) => l.enCentral !== false).length > 1 && (
      <section aria-label="Competiciones" class="space-y-3">
        <h2 class="font-display font-bold text-xs text-gray-400 uppercase tracking-widest">Competiciones</h2>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {LIGAS.filter((l) => l.enCentral !== false).map((l) => (
            <a href={`${base}liga/#liga-${l.id}`} class="liga-card group min-h-[170px] block">
              <div class="absolute inset-0 bg-gradient-to-r from-black via-galaxy-900/80 to-transparent z-10"></div>
              <img src={l.imagen} alt="" loading="lazy" class="absolute inset-0 w-full h-full object-cover opacity-60 mix-blend-screen group-hover:scale-105 transition-transform duration-[1400ms] ease-out" />
              <div class="relative z-20 p-5 flex flex-col justify-end h-full min-h-[170px]">
                <span class:list={['liga-sello self-start mb-2', l.estado === 'proxima' ? 'liga-sello-prox' : '']}>{ETIQUETA_ESTADO[l.estado]}</span>
                <h3 class="text-2xl font-display font-bold text-white uppercase leading-none">{l.titulo[0]} <span class="text-galaxy-400">{l.titulo[1]}</span></h3>
                <p class="text-xs font-display tracking-[0.2em] text-gray-300 uppercase mt-1">{l.juego}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- 3. CENTRAL DE PARTIDOS (con el partido destacado dentro) + clasificación y XI al costado -->
    {FX.visita && <div id="novedad" hidden class="novedad" role="status"></div>}
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-8 items-start">
      <section id="central-partidos" class="lg:col-span-2 space-y-4 scroll-mt-32">
        <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-2 border-b border-galaxy-border pb-2">
          <h2 class="text-xl sm:text-2xl font-display font-bold text-white uppercase tracking-wider text-shadow-glow">Central de Partidos</h2>
          <div id="fecha-nav" hidden class="order-3 sm:order-none w-full sm:w-auto sm:flex-1 sm:max-w-[19rem] sm:mx-auto min-w-0"></div>
          <div class="seg adv-seg" id="seg-partidos" role="group" aria-label="Tipo de partidos">
            <button type="button" data-v="proximos" aria-pressed="true">Próximos</button>
            <button type="button" data-v="resultados" aria-pressed="false">Resultados</button>
            <button type="button" data-v="porfecha" aria-pressed="false">Por fecha</button>
          </div>
        </div>

        <!-- Partido destacado: lo pinta js/pages/central.js con el próximo cruce entre los mejor ubicados de la tabla real. -->
        <article id="destacado" class="glass-panel rounded-xl overflow-hidden relative min-h-[9rem]" aria-live="polite">
          <div class="p-6 space-y-3" role="status" aria-label="Cargando el partido destacado"><div class="esqueleto h-5 w-1/3 mx-auto"></div><div class="esqueleto h-16"></div></div>
        </article>

        <div class="grid gap-3" id="matches-container" aria-live="polite"></div>
        <a href={`${base}duelos/`} class="flex items-center justify-center gap-2 text-xs font-display font-bold text-galaxy-400 hover:text-white uppercase tracking-wider border border-dashed border-galaxy-400/30 rounded-xl py-3 hover:border-galaxy-400 transition-colors"><i class="fa-solid fa-gamepad"></i> Ver retos abiertos en la Sala de Duelos <i class="fa-solid fa-arrow-right"></i></a>
      </section>

      <aside class="space-y-5">
        <section id="pos-seccion" class="glass-panel rounded-xl overflow-hidden scroll-mt-40">
          <div class="bg-gradient-to-r from-galaxy-900 to-black px-4 py-3 border-b border-galaxy-border flex justify-between items-center">
            <div><h3 id="pos-titulo" class="font-display font-bold text-lg uppercase tracking-wider text-white">Posiciones</h3><p id="pos-sub" hidden class="text-[12px] text-gray-400"></p></div><i class="fa-solid fa-trophy text-galaxy-400"></i>
          </div>
          <div class="p-4 overflow-auto max-h-[260px]" role="region" tabindex="0" aria-label="Contenido desplazable">
            <table class="w-full text-left text-sm">
              <thead><tr class="text-gray-500 border-b border-galaxy-border/50"><th class="pb-2 font-semibold">Pos</th><th class="pb-2 font-semibold">DT / Club</th><th class="pb-2 text-center font-semibold">PJ</th><th class="pb-2 text-center font-semibold text-galaxy-400">PTS</th></tr></thead>
              <tbody id="mini-table-container"></tbody>
            </table>
          </div>
        </section>
        {FX.rachas && <section id="rachas" hidden class="glass-panel rounded-xl overflow-hidden">
          <div class="bg-gradient-to-r from-galaxy-900 to-black px-4 py-3 border-b border-galaxy-border flex justify-between items-center"><h3 class="font-display font-bold text-lg uppercase tracking-wider text-white">En racha</h3><i class="fa-solid fa-fire-flame-curved text-amber-400"></i></div>
          <div id="rachas-lista" class="px-4 py-2 text-sm"></div>
        </section>}
        <div id="inicio-creadores" hidden></div>
        <div id="inicio-semanal" hidden></div>
      </aside>
    </div>

    <!-- 3b. CLUBES Y GOLEADORES (plegado). Los pinta js/pages/central.js. El ELO NO va aquí: solo mide amistosos (página Ranking). -->
    <Plegable titulo="Clubes y goleadores" icono="fa-ranking-star" resumen="Clubes más usados y máximos goleadores · toca para ver" id="rank-liga" clase="scroll-mt-40">
      <div class="space-y-6">
        <div>
          <h3 class="font-display font-bold text-xs text-gray-400 uppercase tracking-widest mb-1">Clubes más usados</h3>
          <p class="text-[12px] text-gray-500 mb-2">Partidos jugados por club en la edición en curso.</p>
          <div id="clubes-lista" class="text-sm md:columns-2 md:gap-x-8"></div>
        </div>
        <div id="goleadores-bloque" hidden class="grid gap-6 md:grid-cols-2 border-t border-galaxy-border/40 pt-5">
          <div><h3 class="font-display font-bold text-xs text-gray-400 uppercase tracking-widest mb-1">Goleadores</h3><p class="text-[12px] text-gray-500 mb-2">Según el detalle cargado por el staff (sin autogoles).</p><div id="goleadores-lista" class="text-sm"></div></div>
          <div><h3 class="font-display font-bold text-xs text-gray-400 uppercase tracking-widest mb-1">Asistentes</h3><p class="text-[12px] text-gray-500 mb-2">Pases de gol registrados.</p><div id="asistentes-lista" class="text-sm"></div></div>
        </div>
      </div>
    </Plegable>

    <!-- 4. JUGADORES DESTACADOS: en celular, carrusel que se desliza de lado -->
    <section id="destacados-seccion" class="space-y-4 scroll-mt-40">
      <div class="flex items-center justify-between">
        <h2 class="text-xl sm:text-2xl font-display font-bold text-white uppercase tracking-wider text-shadow-glow">Jugadores Destacados</h2>
        <a href={`${base}database/`} class="text-xs font-display font-bold text-galaxy-400 hover:text-white uppercase flex items-center gap-1.5 border border-galaxy-400/30 bg-galaxy-400/10 px-3 py-1.5 rounded hover:bg-galaxy-400/20 transition-colors">Ver todos <i class="fa-solid fa-arrow-right"></i></a>
      </div>
      <div class="podio" id="featured-players-container"><div class="grid grid-cols-3 gap-3 w-full" role="status" aria-label="Cargando jugadores"><div class="esqueleto h-56"></div><div class="esqueleto h-64"></div><div class="esqueleto h-56"></div></div></div>
    </section>

    <!-- 5. HIGHLIGHTS (oculto mientras sean clips de ejemplo: FX.highlightsDemo) -->
    {FX.highlightsDemo && <>    <Plegable titulo="Highlights de la jornada" icono="fa-video" resumen="Mejores goles y clips · toca para ver" id="highlights" clase="scroll-mt-40">
      <p class="mb-3 text-right"><a href="https://youtube.com" target="_blank" rel="noopener" class="text-galaxy-400 hover:text-white text-xs font-display font-bold tracking-wider uppercase inline-flex items-center gap-1.5"><i class="fa-brands fa-youtube"></i> Ver canal</a></p>
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 lg:gap-6">
        <div class="lg:col-span-2 glass-panel rounded-2xl overflow-hidden relative aspect-video w-full flex items-center justify-center group shadow-[0_0_35px_rgba(128,0,255,0.25)]">
          <img src="https://images.unsplash.com/photo-1574629810360-7efbbe195018?q=80&w=1400&auto=format&fit=crop" alt="" loading="lazy" class="absolute inset-0 w-full h-full object-cover opacity-40 group-hover:scale-105 transition-transform duration-700" />
          <div class="absolute inset-0 bg-gradient-to-t from-galaxy-dark via-galaxy-dark/40 to-transparent"></div>
          <div class="relative z-10 w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-galaxy-600/90 border border-galaxy-400/80 flex items-center justify-center shadow-[0_0_30px_rgba(128,0,255,0.8)] group-hover:scale-110 transition-all duration-300"><i class="fa-solid fa-play text-white text-xl sm:text-2xl pl-1"></i></div>
          <div class="absolute bottom-4 sm:bottom-6 left-4 sm:left-6 right-4 z-10 text-left">
            <span class="px-2 py-0.5 rounded bg-red-600 text-white font-bold text-[12px] uppercase tracking-wider inline-block mb-1">TOP 5</span>
            <h3 class="text-xl sm:text-3xl font-display font-bold text-white uppercase tracking-wide text-shadow-glow">Mejores goles: Jornada 3</h3>
            <p class="text-xs text-gray-300 mt-0.5">Resumen oficial · Galaxy League PES</p>
          </div>
        </div>
        <div class="space-y-2.5">
          <h3 class="font-display font-bold text-xs text-gray-400 uppercase tracking-widest">Más clips</h3>
          {DEMO_CLIPS.map((c) => (
            <a href="https://youtube.com" target="_blank" rel="noopener" class="clip-row group/clip">
              <span class="clip-thumb"><i class="fa-solid fa-play"></i></span>
              <span class="min-w-0 flex-1"><b class="clip-tag">{c.tag}</b><span class="block text-sm text-white font-semibold leading-snug truncate">{c.titulo}</span></span>
              <span class="text-[12px] text-gray-400 font-display tabular-nums shrink-0">{c.dur}</span>
            </a>
          ))}
        </div>
      </div>
    </Plegable></>}

    <!-- 6. INVITACIÓN FINAL -->
    <section class="glass-panel rounded-2xl p-5 sm:p-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
      <div>
        <h2 class="font-display font-bold text-lg sm:text-xl text-white uppercase tracking-wider">¿Listo para entrar a la Galaxy?</h2>
        <p class="text-sm text-gray-400 mt-0.5">La comunidad vive en Discord: ahí se pactan partidas, se arman torneos y se avisa cada novedad.</p>
      </div>
      <a href="https://discord.gg/jsxZ3mtfwe" target="_blank" rel="noopener" class="shrink-0 bg-[#5865F2] hover:bg-[#4752c4] text-white font-display font-bold px-6 py-3 rounded-xl text-sm uppercase tracking-wider transition-colors flex items-center gap-2"><i class="fa-brands fa-discord text-lg"></i> Unirme al Discord</a>
    </section>
  </div>
</Layout>
<script>
  import '../js/pages/central.js';
</script>

            <span class="px-2 py-0.5 rounded bg-red-600 text-white font-bold text-[12px] uppercase tracking-wider inline-block mb-1">TOP 5</span>
            <h3 class="text-xl sm:text-3xl font-display font-bold text-white uppercase tracking-wide text-shadow-glow">Mejores goles: Jornada 3</h3>
            <p class="text-xs text-gray-300 mt-0.5">Resumen oficial · Galaxy League PES</p>
          </div>
        </div>
        <div class="space-y-2.5">
          <h3 class="font-display font-bold text-xs text-gray-400 uppercase tracking-widest">Más clips</h3>
          {DEMO_CLIPS.map((c) => (
            <a href="https://youtube.com" target="_blank" rel="noopener" class="clip-row group/clip">
              <span class="clip-thumb"><i class="fa-solid fa-play"></i></span>
              <span class="min-w-0 flex-1"><b class="clip-tag">{c.tag}</b><span class="block text-sm text-white font-semibold leading-snug truncate">{c.titulo}</span></span>
              <span class="text-[12px] text-gray-400 font-display tabular-nums shrink-0">{c.dur}</span>
            </a>
          ))}
        </div>
      </div>
    </Plegable></>}

    <!-- 6. INVITACIÓN FINAL -->
    {FX.portada ? (
    <section class="cierre" aria-labelledby="cierre-t">
      <div class="hero-aurora" aria-hidden="true"><i></i><i></i><i></i></div>
      <div class="cierre-cuerpo">
        <h2 id="cierre-t" class="cierre-tit">¿Listo para entrar a la <span>Galaxy</span>?</h2>
        <p class="cierre-sub">Crea tu cuenta gratis y empieza hoy: tu perfil, tus retos, tus torneos y tu club.</p>
        <div class="cierre-botones">
          <button type="button" id="cierre-registro" class="cierre-btn cierre-btn-prim solo-invitado"><i class="fa-solid fa-user-plus"></i> Crear mi cuenta</button>
          <a href={`${base}perfil/`} class="cierre-btn cierre-btn-prim solo-cuenta"><i class="fa-solid fa-user"></i> Ir a mi perfil</a>
          <a href={discord} target="_blank" rel="noopener" class="cierre-btn cierre-btn-sec"><i class="fa-brands fa-discord"></i> Entrar al Discord</a>
        </div>
        <p class="cierre-guia solo-invitado"><a href={`${base}unirme/`}>¿Primera vez? Mira la guía de 5 pasos <i class="fa-solid fa-arrow-right"></i></a></p>
      </div>
    </section>
    ) : (
    <section class="glass-panel rounded-2xl p-5 sm:p-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
      <div>
        <h2 class="font-display font-bold text-lg sm:text-xl text-white uppercase tracking-wider">¿Listo para entrar a la Galaxy?</h2>
        <p class="text-sm text-gray-400 mt-0.5">La comunidad vive en Discord: ahí se pactan partidas, se arman torneos y se avisa cada novedad.</p>
      </div>
      <a href="https://discord.gg/jsxZ3mtfwe" target="_blank" rel="noopener" class="shrink-0 bg-[#5865F2] hover:bg-[#4752c4] text-white font-display font-bold px-6 py-3 rounded-xl text-sm uppercase tracking-wider transition-colors flex items-center gap-2"><i class="fa-brands fa-discord text-lg"></i> Unirme al Discord</a>
    </section>
    )}
  </div>
</Layout>
<script>
  import '../js/pages/central.js';
  import { montarMundos } from '../js/features/mundos.js';
  import { openAuthModal } from '../js/features/auth.js';
  montarMundos();
  import('../js/features/elite.js').then((m) => m.montarElite()).catch((e) => console.warn('[central] elite:', e));
  import('../js/features/estrellas.js').then((m) => m.montarEstrellas()).catch((e) => console.warn('[central] estrellas:', e));
  import('../js/features/ventanas.js').then((m) => m.montarVentanas()).catch((e) => console.warn('[central] ventanas:', e));
  import('../js/features/escenario.js').then((m) => m.montarEscenario()).catch((e) => console.warn('[central] escenario:', e));
  import('../js/features/transmision.js').then((m) => m.montarTransmision()).catch((e) => console.warn('[central] transmisión:', e));
  document.getElementById('cierre-registro')?.addEventListener('click', () => openAuthModal('register'));
</script>

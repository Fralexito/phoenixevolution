---
// INICIO (rama rediseno). Pensado para quien entra por primera vez: qué es esto, qué puedo hacer y por dónde empiezo.
// Toda la lógica de datos (partidos, destacado, tabla, cifras, rachas) sigue en js/pages/central.js: aquí solo cambia la ESTRUCTURA
// y se conservan los mismos ids que ese archivo busca. Para volver al inicio anterior: git checkout borrador -- src/pages/index.astro.
import Layout from '../layouts/Layout.astro';
import { FX } from '../data/experimento.js';
import Plegable from '../components/Plegable.astro';
import { LIGAS } from '../data/ligas.js';
import { NOTICIAS } from '../data/noticias.js';
import { EDICIONES } from '../data/ligaResultados.js';
const base = import.meta.env.BASE_URL;

// Cifras que NO dependen de la base de datos (salen de data/ligaResultados.js al compilar): así la portada nunca queda vacía.
const edicion = EDICIONES.galaxy.find((e) => e.estado === 'en_curso') ?? null;
const partidosEd = (edicion?.fechas ?? []).flatMap((f) => f.partidos ?? []);
const nJugadores = new Set([...(edicion?.jugadores ?? []), ...partidosEd.flatMap((m) => [m.l, m.v])].filter(Boolean)).size;
const nJugados = partidosEd.filter((m) => Number.isInteger(m?.gl) && Number.isInteger(m?.gv)).length;
const nLigas = LIGAS.filter((l) => l.enCentral !== false).length;
const noticias = NOTICIAS.slice(0, 3);
const DISCORD = 'https://discord.gg/jsxZ3mtfwe';

// Los 4 pasos del nuevo (solo sin sesión). Con sesión, este bloque se oculta y lo reemplaza «Primeros pasos» (ver js/features/primerosPasos.js cuando exista).
const PASOS = [
  { n: 1, t: 'Crea tu cuenta', p: 'Con Discord, Google o correo. Te da perfil, reputación y acceso a los retos.', tiempo: '1 minuto', accion: 'registro' },
  { n: 2, t: 'Arma tu ficha', p: 'Tu carta de jugador: posición y estadísticas. Es tu presentación ante los rivales.', tiempo: '3 minutos', href: 'database/' },
  { n: 3, t: 'Prepara tu conexión', p: 'Instala Parsec. Si vas a recibir rivales, Phoenix Link te configura el host.', tiempo: '5 minutos', href: 'unirme/#conexion' },
  { n: 4, t: 'Juega tu primer reto', p: 'Lanza un reto o acepta uno abierto en la Sala de Duelos. El resultado va a tu reputación.', tiempo: 'cuando quieras', href: 'duelos/' },
];
const IDEAS = [
  { i: 'fa-trophy', t: 'Una liga real', p: 'Galaxy League y Liga Sudario: fechas, tabla, goleadores y palmarés. Como una liga de barrio, pero en PES 2021 y con todo registrado.' },
  { i: 'fa-gamepad', t: 'Retos cuando quieras', p: 'Fuera de la liga puedes retar a cualquiera: 1 vs 1 o equipos de hasta 8. La Sala de Duelos arma la partida y avisa a los dos.' },
  { i: 'fa-plug', t: 'Se juega por Parsec', p: 'Uno pone la PC (el «host») y los demás entran por internet. Phoenix Link lo deja listo con un clic. Hay guía paso a paso.' },
];
---
<Layout title="Central" active="central">

  <!-- 1. PORTADA · izquierda: qué es y UNA acción principal · derecha: lo que pasa ahora (estado real + partido destacado + cifras) -->
  <header class="in-hero px-4 sm:px-6 lg:px-8">
    <div class="hero-aurora" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="max-w-7xl mx-auto in-hero-g">
      <div>
        <span class="in-pill vivo">Temporada oficial 2026</span>
        <h1 class="in-h1">Juega PES 2021<br />en línea, con <em>liga de verdad</em></h1>
        <p class="in-bajada">Phoenix Evolution es una <b>comunidad de jugadores</b>: tabla, fechas, retos y transmisiones. Entras, armas tu ficha, retas a alguien y tu resultado cuenta. <b>Gratis</b> y sin instalar nada raro: solo PES 2021 y Parsec.</p>
        <div class="in-cta">
          <a href="#empezar" class="in-btn in-btn-p solo-invitado"><i class="fa-solid fa-rocket"></i> Empezar en 4 pasos</a>
          <a href={`${base}duelos/`} class="in-btn in-btn-p solo-cuenta"><i class="fa-solid fa-gamepad"></i> Jugar un reto</a>
          <a href={`${base}liga/`} class="in-btn in-btn-s"><i class="fa-solid fa-table-list"></i> Ver la liga</a>
          <button type="button" id="btn-hero-register" class="in-enlace solo-invitado" data-auth="login">Ya tengo cuenta →</button>
        </div>
        <div class="in-confianza" aria-label="Datos de la comunidad">
          {nJugadores > 0 && <span><i class="fa-solid fa-users"></i> {nJugadores} jugadores en la liga</span>}
          {nJugados > 0 && <span><i class="fa-solid fa-futbol"></i> {nJugados} partidos jugados</span>}
          {nLigas > 1 && <span><i class="fa-solid fa-crown"></i> {nLigas} competiciones</span>}
          <span><i class="fa-brands fa-discord"></i> Comunidad en Discord</span>
        </div>
      </div>

      <aside class="in-card in-ahora" aria-label="Ahora mismo en la comunidad">
        <div class="in-ahora-cab"><span class="in-eti">Ahora mismo</span><span class="in-pill vivo">En vivo</span></div>
        <!-- Franja de estado de la liga (la pinta central.js; hidden hasta tener datos) -->
        <a id="estado-liga" hidden href={`${base}liga/#liga-galaxy`} class="estado-liga" aria-live="polite"></a>
        <!-- Partido destacado real (central.js) -->
        <article id="destacado" class="glass-panel rounded-xl overflow-hidden relative" aria-live="polite">
          <div class="p-5 space-y-3" role="status" aria-label="Cargando el partido destacado"><div class="esqueleto h-4 w-1/3 mx-auto"></div><div class="esqueleto h-12"></div></div>
        </article>
        <!-- Cifras reales de la base (central.js las rellena; «—» mientras tanto) -->
        <div class="in-cifras">
          <a href={`${base}duelos/`} class="in-cifra"><span class="in-mini">Hosts listos</span><b id="pulso-hosts">—</b></a>
          <a href={`${base}duelos/`} class="in-cifra"><span class="in-mini">Retos abiertos</span><b id="pulso-retos">—</b></a>
          <a href={`${base}database/`} class="in-cifra"><span class="in-mini">Registrados</span><b id="pulso-comunidad">—</b></a>
          <span hidden id="pulso-jugadores">—</span>
        </div>
      </aside>
    </div>
  </header>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-10 w-full">

    <!-- 2. TU CAMINO (solo invitados). Con sesión aquí irá «Primeros pasos» (progreso real). -->
    <section id="empezar" class="in-sec scroll-mt-28 solo-invitado" aria-labelledby="empezar-t">
      <div class="in-card in-acc in-ruta">
        <div class="in-cab">
          <div><span class="in-eti">Para empezar</span><h2 id="empezar-t" class="in-tit">Tu camino hasta el <em>primer partido</em></h2><p class="in-leyenda">Cuatro pasos. Cada tarjeta te lleva a donde se hace y te dice cuánto tarda. Cuando tengas cuenta, aquí verás tu progreso.</p></div>
          <a href={`${base}unirme/`} class="in-btn in-btn-g"><i class="fa-regular fa-circle-question"></i> Guía completa y preguntas</a>
        </div>
        <div class="in-pasos">
          {PASOS.map((s) => (
            s.accion
              ? <button type="button" class:list={['in-paso text-left', s.n === 1 && 'act']} data-auth="register"><span class="n">{s.n}</span><b>{s.t}</b><p>{s.p}</p><span class="t"><i class="fa-regular fa-clock"></i>{s.tiempo}</span></button>
              : <a href={`${base}${s.href}`} class="in-paso"><span class="n">{s.n}</span><b>{s.t}</b><p>{s.p}</p><span class="t"><i class="fa-regular fa-clock"></i>{s.tiempo}</span></a>
          ))}
        </div>
      </div>
    </section>
    <!-- Con sesión: contenedor del panel «Primeros pasos» (lo monta js/features/primerosPasos.js; vacío hasta entonces) -->
    <section id="primeros-pasos" class="solo-cuenta in-sec in-card in-acc cl-pasos" hidden aria-label="Primeros pasos"></section>

    <!-- 3. QUÉ ES ESTO (solo invitados) -->
    <section class="in-sec solo-invitado" aria-labelledby="ideas-t">
      <div class="in-cab"><div><span class="in-eti">En 3 ideas</span><h2 id="ideas-t" class="in-tit">¿Qué es Phoenix Evolution?</h2></div></div>
      <div class="in-ideas">
        {IDEAS.map((x) => (<div class="in-card in-idea"><i class={`fa-solid ${x.i}`}></i><div><b>{x.t}</b><p>{x.p}</p></div></div>))}
      </div>
    </section>

    <!-- 4. PARTIDOS + POSICIONES (misma lógica de central.js: ids intactos) -->
    {FX.visita && <div id="novedad" hidden class="novedad mt-6" role="status"></div>}
    <section class="in-sec" aria-labelledby="liga-t">
      <div class="in-liga">
        <section id="central-partidos" class="space-y-3 scroll-mt-32 min-w-0">
          <div class="in-cab !mb-2">
            <div><span class="in-eti">Galaxy League{edicion ? ` · ${edicion.nombre}` : ''}</span><h2 id="liga-t" class="in-tit">Central de <em>partidos</em></h2><p class="in-leyenda">Próximos cruces y resultados de la liga oficial. Toca un partido para ver su detalle.</p></div>
            <div class="seg adv-seg" id="seg-partidos" role="group" aria-label="Tipo de partidos">
              <button type="button" data-v="proximos" aria-pressed="true">Próximos</button>
              <button type="button" data-v="resultados" aria-pressed="false">Resultados</button>
              <button type="button" data-v="porfecha" aria-pressed="false">Por fecha</button>
            </div>
          </div>
          <div id="fecha-nav" hidden class="w-full sm:max-w-[19rem] min-w-0"></div>
          <div class="grid gap-3" id="matches-container" aria-live="polite"></div>
          <a href={`${base}duelos/`} class="flex items-center justify-center gap-2 text-xs font-display font-bold text-galaxy-400 hover:text-white uppercase tracking-wider border border-dashed border-galaxy-400/30 rounded-xl py-3 hover:border-galaxy-400 transition-colors"><i class="fa-solid fa-gamepad"></i> Ver retos abiertos en la Sala de Duelos <i class="fa-solid fa-arrow-right"></i></a>
        </section>

        <aside class="space-y-4 min-w-0">
          <div class="in-cab !mb-2"><div><span class="in-eti">Tabla</span><h2 id="pos-titulo" class="in-tit">Posiciones</h2><p id="pos-sub" hidden class="in-leyenda"></p></div><a href={`${base}liga/`} class="in-enlace">Tabla completa →</a></div>
          <section id="pos-seccion" class="in-card in-tabla scroll-mt-40">
            <div class="overflow-auto max-h-[300px]" role="region" tabindex="0" aria-label="Tabla de posiciones (desplazable)">
              <table class="w-full text-left text-sm">
                <thead><tr><th>Pos</th><th>DT / Club</th><th class="text-center">PJ</th><th class="text-center !text-galaxy-400">PTS</th></tr></thead>
                <tbody id="mini-table-container"></tbody>
              </table>
            </div>
            <p class="in-nota px-1 py-2"><i class="fa-regular fa-lightbulb"></i>PJ = partidos jugados · PTS = puntos (3 por ganar, 1 por empatar). ▲▼ aparecen en «Por fecha».</p>
          </section>
          {FX.rachas && <section id="rachas" hidden class="glass-panel rounded-xl overflow-hidden">
            <div class="bg-gradient-to-r from-galaxy-900 to-black px-4 py-3 border-b border-galaxy-border flex justify-between items-center"><h3 class="font-display font-bold text-base uppercase tracking-wider text-white">En racha</h3><i class="fa-solid fa-fire-flame-curved text-amber-400"></i></div>
            <div id="rachas-lista" class="px-4 py-2 text-sm"></div>
          </section>}
          <div id="inicio-creadores" hidden></div>
          <div id="inicio-semanal" hidden></div>
        </aside>
      </div>
    </section>

    <!-- 4b. CLUBES Y GOLEADORES (plegado, como antes) -->
    <div class="in-sec">
    <Plegable titulo="Clubes y goleadores" icono="fa-ranking-star" resumen="Clubes más usados y máximos goleadores · toca para ver" id="rank-liga" clase="scroll-mt-40">
      <div class="space-y-6">
        <div>
          <h3 class="font-display font-bold text-xs text-gray-400 uppercase tracking-widest mb-1">Clubes más usados</h3>
          <p class="text-[12px] text-gray-500 mb-2">Partidos jugados por club en la edición en curso.</p>
          <div id="clubes-lista" class="text-sm md:columns-2 md:gap-x-8"></div>
        </div>
        <div id="goleadores-bloque" hidden class="grid gap-6 md:grid-cols-2 border-t border-galaxy-border/40 pt-5">
          <div><h3 class="font-display font-bold text-xs text-gray-400 uppercase tracking-widest mb-1">Goleadores</h3><p class="text-[12px] text-gray-500 mb-2">Según el detalle cargado por el staff (sin autogoles).</p><div id="goleadores-lista" class="text-sm"></div></div>
          <div><h3 class="font-display font-bold text-xs text-gray-400 uppercase tracking-widest mb-1">Asistentes</h3><p class="text-[12px] text-gray-500 mb-2">Pases de gol registrados.</p><div id="asistentes-lista" class="text-sm"></div></div>
        </div>
      </div>
    </Plegable>
    </div>

    <!-- 5. NOTICIAS (data/noticias.js, las 3 más recientes) -->
    {noticias.length > 0 && <section class="in-sec" aria-labelledby="noti-t">
      <div class="in-cab"><div><span class="in-eti">Noticias</span><h2 id="noti-t" class="in-tit">Lo <em>último</em></h2><p class="in-leyenda">Lo oficial (calendario, reglamento) y la Tribuna (la joda de la comunidad).</p></div><a href={`${base}noticias/`} class="in-enlace">Todas las noticias →</a></div>
      <div class="in-noti">
        {noticias.map((n, i) => (
          <a href={`${base}noticias/#noticia-${n.id}`} class:list={['in-card in-nt', i === 0 && 'dest']}>
            {n.imagen ? <img src={n.imagen} alt="" loading="lazy" /> : <span class="in-img"></span>}
            <div class={i === 0 ? 'cu' : 'min-w-0'}><span class="in-pill">{n.categoria}</span><b>{n.titulo}</b><small>{n.tag} · {n.fecha}</small></div>
          </a>
        ))}
      </div>
    </section>}

    <!-- 6. JUGADORES DESTACADOS (como antes) -->
    <section id="destacados-seccion" class="in-sec scroll-mt-40" aria-labelledby="dest-t">
      <div class="in-cab"><div><span class="in-eti">Jugadores</span><h2 id="dest-t" class="in-tit">Fichas <em>destacadas</em></h2><p class="in-leyenda">Las cartas mejor valoradas. Cada jugador arma la suya; tú tendrás la tuya en el paso 2.</p></div><a href={`${base}database/`} class="in-enlace">Ver todas →</a></div>
      <div class="podio" id="featured-players-container"><div class="grid grid-cols-3 gap-3 w-full" role="status" aria-label="Cargando jugadores"><div class="esqueleto h-56"></div><div class="esqueleto h-64"></div><div class="esqueleto h-56"></div></div></div>
    </section>

    <!-- 7. COMUNIDAD -->
    <section class="in-sec" aria-labelledby="com-t">
      <div class="in-cab"><div><span class="in-eti">Comunidad</span><h2 id="com-t" class="in-tit">Dónde se <em>habla</em></h2><p class="in-leyenda">El Muro es el espacio social de la web: publicaciones, clips y reacciones. Discord es donde se avisan los partidos y se pide ayuda.</p></div></div>
      <div class="in-com">
        <a href={`${base}social/`} class="in-card in-idea" style="align-items:center">
          <i class="fa-solid fa-earth-americas"></i>
          <div><b>Entrar al Muro</b><p>Historias, publicaciones y reacciones de la comunidad. Sin cuenta puedes mirar; con cuenta, publicar.</p></div>
        </a>
        <a href={DISCORD} target="_blank" rel="noopener" class="in-card in-disc">
          <i class="fa-brands fa-discord"></i><b>Discord oficial</b><p>Avisos de fechas, canal de soporte y salas de voz para jugar.</p>
          <span class="in-btn in-btn-s mt-2">Unirme al Discord</span>
        </a>
      </div>
    </section>
  </div>
</Layout>
<script>
  import '../js/pages/central.js';
</script>

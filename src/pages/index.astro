---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---
<Layout title="Central" active="central">
  <header class="relative flex items-center justify-center overflow-hidden py-24 px-4 sm:px-6 lg:px-8 min-h-[60vh] border-b border-galaxy-border/40">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[550px] h-[550px] bg-galaxy-600/20 rounded-full blur-[130px] pointer-events-none"></div>
    <div class="max-w-4xl mx-auto text-center relative z-10 space-y-6">
      <span class="inline-block text-xs font-display font-bold text-galaxy-400 uppercase tracking-widest bg-galaxy-600/20 px-3 py-1 rounded border border-galaxy-400/30 shadow-[0_0_15px_rgba(0,229,255,0.2)]">Temporada Oficial 2026</span>
      <h1 class="text-4xl sm:text-6xl md:text-7xl font-display font-extrabold text-white uppercase tracking-wider leading-tight">
        EL CIRCO MÁXIMO DE LA <span class="text-transparent bg-clip-text bg-gradient-to-r from-galaxy-400 via-galaxy-500 to-galaxy-600 text-shadow-glow">GALAXY LEAGUE</span>
      </h1>
      <p class="text-gray-300 text-sm sm:text-base md:text-lg max-w-2xl mx-auto">Comunidad competitiva de simulación futbolística. Matchmaking punto a punto, hosting remoto, transferencias de mercado y disputas de honor sobre el campo virtual.</p>
      <div class="flex flex-wrap items-center justify-center gap-4 pt-4">
        <a href={`${base}duelos/`} class="bg-gradient-to-r from-galaxy-600 to-galaxy-700 hover:from-galaxy-500 hover:to-galaxy-600 text-white font-display font-bold px-8 py-3.5 rounded-xl text-sm uppercase tracking-wider transition-all shadow-[0_0_25px_rgba(128,0,255,0.4)] flex items-center gap-2"><i class="fa-solid fa-gamepad"></i> Sala de Duelos</a>
        <a href={`${base}database/`} class="glass-panel hover:bg-white/10 text-white font-display font-bold px-8 py-3.5 rounded-xl text-sm uppercase tracking-wider hover:border-galaxy-400 transition-all flex items-center gap-2"><i class="fa-solid fa-chart-simple"></i> Jugadores</a>
      </div>
    </div>
  </header>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full space-y-8">
    <section class="relative rounded-2xl overflow-hidden bg-galaxy-panel border border-galaxy-border shadow-[0_0_40px_rgba(128,0,255,0.25)] group">
      <div class="absolute inset-0 bg-gradient-to-r from-black via-galaxy-900/80 to-transparent z-10"></div>
      <img src="https://images.unsplash.com/photo-1462331940025-496dfbfc7564?q=80&w=1200&auto=format&fit=crop" alt="" loading="lazy" class="absolute inset-0 w-full h-full object-cover opacity-60 mix-blend-screen group-hover:scale-105 transition-transform duration-1000" />
      <div class="relative z-20 p-8 md:p-12 flex flex-col justify-center min-h-[350px]">
        <div class="animate-float mb-4"><i class="fa-solid fa-crown text-galaxy-400 text-4xl drop-shadow-[0_0_15px_rgba(0,229,255,0.8)]"></i></div>
        <span class="text-galaxy-400 font-display font-bold tracking-widest uppercase mb-2">Competición Activa</span>
        <h2 class="text-5xl md:text-7xl font-display font-bold text-white mb-2 uppercase leading-none text-shadow-glow">GALAXY <span class="text-transparent bg-clip-text bg-gradient-to-r from-galaxy-400 to-galaxy-600">LEAGUE</span></h2>
        <p class="text-2xl font-display font-light tracking-[0.3em] text-gray-300 mb-6 uppercase">Pro Evolution Soccer</p>
        <div class="flex flex-wrap gap-4">
          <button id="btn-hero-register" type="button" class="bg-gradient-to-r from-galaxy-600 to-galaxy-700 hover:from-galaxy-400 hover:to-galaxy-500 text-white font-bold py-3 px-8 rounded text-sm uppercase tracking-wider transition-all shadow-[0_0_20px_rgba(128,0,255,0.5)]"><i class="fa-solid fa-user-plus mr-2"></i> Crear Cuenta Oficial</button>
          <a href={`${base}database/`} class="bg-black/50 border border-galaxy-600 text-white font-bold py-3 px-8 rounded text-sm uppercase tracking-wider backdrop-blur-md hover:border-galaxy-400 hover:text-galaxy-400 transition-colors">Ver Jugadores</a>
        </div>
      </div>
    </section>

    <section class="glass-panel rounded-xl overflow-hidden relative">
      <div class="absolute top-0 right-0 bg-galaxy-600 text-white text-[10px] md:text-xs font-bold px-4 py-1 rounded-bl-lg uppercase tracking-widest z-10"><i class="fa-solid fa-fire mr-1"></i> Partido Destacado</div>
      <div class="absolute inset-0 bg-gradient-to-r from-blue-900/20 via-transparent to-white/10"></div>
      <div class="p-6 md:p-8 flex flex-col md:flex-row justify-between items-center relative z-10">
        <div class="flex flex-col md:flex-row items-center gap-4 w-full md:w-2/5 md:justify-end text-center md:text-right">
          <div>
            <div class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded bg-emerald-500/20 border border-emerald-500/40 text-[10px] text-emerald-400 font-bold mb-1"><span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span> HOST ACTIVO</div>
            <h3 class="font-display font-bold text-3xl text-white text-shadow-glow">FRALEX</h3>
            <p class="text-sm text-galaxy-400 uppercase tracking-widest font-bold">FC Barcelona</p>
          </div>
          <div class="w-20 h-20 rounded-full border-2 border-blue-500 bg-gradient-to-br from-blue-800 to-red-800 flex items-center justify-center font-display font-bold text-2xl text-white shadow-[0_0_20px_rgba(37,99,235,0.5)]">FCB</div>
        </div>
        <div class="my-6 md:my-0 flex flex-col items-center">
          <span class="font-display font-bold text-4xl text-galaxy-400 italic drop-shadow-[0_0_10px_rgba(0,229,255,0.8)]">VS</span>
          <span class="text-[10px] text-gray-500 uppercase tracking-widest mt-1">Vía Parsec • Próximamente</span>
        </div>
        <div class="flex flex-col md:flex-row-reverse items-center gap-4 w-full md:w-2/5 md:justify-end text-center md:text-left">
          <div>
            <div class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded bg-blue-500/20 border border-blue-500/40 text-[10px] text-blue-400 font-bold mb-1"><i class="fa-solid fa-network-wired text-[9px]"></i> CLIENTE</div>
            <h3 class="font-display font-bold text-3xl text-white text-shadow-glow">AXEL</h3>
            <p class="text-sm text-galaxy-400 uppercase tracking-widest font-bold">Real Madrid</p>
          </div>
          <div class="w-20 h-20 rounded-full border-2 border-gray-300 bg-gradient-to-br from-gray-100 to-gray-400 flex items-center justify-center font-display font-bold text-2xl text-black shadow-[0_0_20px_rgba(255,255,255,0.3)]">RMA</div>
        </div>
      </div>
    </section>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <section class="lg:col-span-2 space-y-6">
        <h2 class="text-2xl font-display font-bold text-white uppercase tracking-wider text-shadow-glow border-b border-galaxy-border pb-2">Central de Partidos</h2>
        <div class="grid gap-4" id="matches-container"></div>
      </section>
      <div class="space-y-6">
        <section class="glass-panel rounded-xl overflow-hidden">
          <div class="bg-gradient-to-r from-galaxy-900 to-black px-4 py-3 border-b border-galaxy-border flex justify-between items-center">
            <h3 class="font-display font-bold text-lg uppercase tracking-wider text-white">Posiciones</h3><i class="fa-solid fa-trophy text-galaxy-400"></i>
          </div>
          <div class="p-4 overflow-auto max-h-[260px]">
            <table class="w-full text-left text-sm">
              <thead><tr class="text-gray-500 border-b border-galaxy-border/50"><th class="pb-2 font-semibold">Pos</th><th class="pb-2 font-semibold">Club / DT</th><th class="pb-2 text-center font-semibold text-galaxy-400">PTS</th></tr></thead>
              <tbody id="mini-table-container"></tbody>
            </table>
          </div>
        </section>
        <section class="glass-panel rounded-2xl overflow-hidden shadow-[0_0_25px_rgba(128,0,255,0.2)]">
          <div class="bg-galaxy-dark/80 px-4 py-3 border-b border-galaxy-border/60 text-center"><h3 class="font-display font-bold text-sm uppercase tracking-widest text-galaxy-400 text-shadow-glow">XI IDEAL DE LA FECHA</h3></div>
          <div class="tactical-pitch w-full h-[320px] p-4 relative overflow-hidden flex flex-col justify-between">
            <div class="absolute inset-x-4 top-0 h-16 border-b border-x border-galaxy-400/25"></div>
            <div class="absolute inset-x-0 top-1/2 -translate-y-1/2 h-px bg-galaxy-400/25"></div>
            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-20 h-20 rounded-full border border-galaxy-400/25"></div>
            <div class="absolute inset-x-4 bottom-0 h-16 border-t border-x border-galaxy-400/25"></div>
            <div id="xi-container" class="contents"></div>
          </div>
        </section>
      </div>
    </div>

    <section class="pt-6 border-t border-galaxy-border/50 space-y-6">
      <div class="flex items-center justify-between">
        <h2 class="text-2xl font-display font-bold text-white uppercase tracking-wider text-shadow-glow">Jugadores Destacados</h2>
        <a href={`${base}database/`} class="text-xs font-display font-bold text-galaxy-400 hover:text-white uppercase flex items-center gap-1.5 border border-galaxy-400/30 bg-galaxy-400/10 px-3 py-1.5 rounded hover:bg-galaxy-400/20 transition-colors">Ver todos <i class="fa-solid fa-arrow-right"></i></a>
      </div>
      <div class="flex flex-wrap justify-center gap-3 sm:gap-6" id="featured-players-container"><div class="text-center py-6 text-gray-400 text-sm w-full">Conectando con la base de datos...</div></div>
    </section>

    <section class="pt-8 border-t border-galaxy-border/50 space-y-4">
      <div class="flex items-center justify-between">
        <h2 class="text-2xl font-display font-bold text-white uppercase tracking-wider text-shadow-glow flex items-center gap-2"><i class="fa-solid fa-video text-galaxy-400 text-xl"></i> HIGHLIGHTS DE LA JORNADA</h2>
        <a href="https://youtube.com" target="_blank" rel="noopener" class="text-galaxy-400 hover:text-white text-xs font-display font-bold tracking-wider uppercase flex items-center gap-1.5"><i class="fa-brands fa-youtube text-red-500 text-sm"></i> VER CANAL</a>
      </div>
      <div class="glass-panel rounded-2xl overflow-hidden relative aspect-video max-h-[480px] w-full flex items-center justify-center group shadow-[0_0_35px_rgba(128,0,255,0.25)]">
        <img src="https://images.unsplash.com/photo-1574629810360-7efbbe195018?q=80&w=1400&auto=format&fit=crop" alt="" loading="lazy" class="absolute inset-0 w-full h-full object-cover opacity-40 group-hover:scale-105 transition-transform duration-700" />
        <div class="absolute inset-0 bg-gradient-to-t from-galaxy-dark via-galaxy-dark/40 to-transparent"></div>
        <div class="relative z-10 w-20 h-20 rounded-full bg-galaxy-600/90 border border-galaxy-400/80 flex items-center justify-center shadow-[0_0_30px_rgba(128,0,255,0.8)] group-hover:scale-110 transition-all duration-300"><i class="fa-solid fa-play text-white text-2xl pl-1"></i></div>
        <div class="absolute bottom-6 left-6 z-10 text-left">
          <span class="px-2 py-0.5 rounded bg-red-600 text-white font-bold text-[10px] uppercase tracking-wider inline-block mb-1">TOP 5</span>
          <h3 class="text-2xl md:text-3xl font-display font-bold text-white uppercase tracking-wide text-shadow-glow">MEJORES GOLES: JORNADA 3</h3>
          <p class="text-xs text-gray-300 mt-0.5">Resumen Oficial • Galaxy League PES</p>
        </div>
      </div>
    </section>
  </div>
</Layout>
<script>
  import '../js/pages/central.js';
</script>

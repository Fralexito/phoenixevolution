---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Jugadores" active="database">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full space-y-6">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end border-b border-galaxy-line pb-6 gap-4">
      <div>
        <span class="text-xs font-display font-bold text-galaxy-400 uppercase tracking-widest bg-galaxy-600/20 px-2.5 py-1 rounded border border-galaxy-400/30 inline-block mb-2">REGISTRO OFICIAL</span>
        <h1 class="text-3xl font-display font-bold text-white uppercase tracking-widest text-shadow-glow">JUGADORES</h1>
        <p class="text-gray-400 text-sm mt-1">Base de datos global: registro oficial de estadísticas y valoraciones.</p>
      </div>
      <div class="flex flex-col sm:flex-row sm:flex-wrap sm:justify-end items-stretch sm:items-center gap-3 w-full md:w-auto md:max-w-[75%]">
        <button id="btn-compare" type="button" class="btn btn-ghost shrink-0"><i class="fa-solid fa-scale-balanced"></i> Comparar</button>
        <button id="btn-add-player" type="button" hidden class="btn btn-primary shrink-0"><i class="fa-solid fa-plus"></i> Añadir Jugador</button>
        <div class="flex gap-3 w-full sm:w-auto">
          <select id="player-filter-select" aria-label="Filtrar por equipo" class="field !w-1/2 sm:!w-auto"><option value="ALL">Todos los Equipos</option></select>
          <div class="relative w-1/2 sm:w-48">
            <input id="player-search-input" type="search" placeholder="Buscar jugador..." aria-label="Buscar jugador" class="field !pl-8" />
            <i class="fa-solid fa-search absolute left-3 top-3 text-gray-500 text-xs"></i>
          </div>
        </div>
        <button id="btn-avanzada" type="button" class="btn btn-ghost shrink-0" aria-expanded="false" aria-controls="adv-panel"><i class="fa-solid fa-sliders"></i> Avanzada</button>
      </div>
    </div>
    <div id="adv-panel" hidden></div>
    <!-- Filtros por liga, torneo y temporada: un jugador aparece si en ALGUNA participación cumplió todo lo elegido (y con el club de esa participación). -->
    <details id="hist-filtros" class="glass-panel rounded-xl px-4 py-3 group">
      <summary class="cursor-pointer select-none flex flex-wrap items-center gap-x-3 gap-y-1 text-xs font-display font-bold uppercase tracking-widest text-gray-300 list-none">
        <span><i class="fa-solid fa-filter text-galaxy-400 mr-2"></i>Liga · Torneo · Temporada</span>
        <span id="hist-resumen" class="normal-case tracking-normal font-sans font-normal text-gray-400"></span>
        <i class="fa-solid fa-chevron-down ml-auto text-gray-500 transition-transform group-open:rotate-180"></i>
      </summary>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4 pt-3 items-end">
        <div><label class="label" for="f-liga-h">Liga</label><select id="f-liga-h" class="field"><option value="">Todas</option></select></div>
        <div><label class="label" for="f-torneo-h">Torneo</label><select id="f-torneo-h" class="field"><option value="">Todos</option></select></div>
        <div><label class="label" for="f-temp-h">Temporada</label><select id="f-temp-h" class="field"><option value="">Todas</option></select></div>
        <button id="hist-limpiar" type="button" class="btn btn-ghost" hidden><i class="fa-solid fa-xmark"></i> Quitar filtros</button>
      </div>
      <p class="text-[11px] text-gray-500 pt-2 leading-snug">Buscar un equipo (arriba) incluye a todos los que lo eligieron alguna vez; cada carta muestra en qué liga, torneo y temporada lo usó.</p>
    </details>
    <!-- Reconocimientos: formas de destacar que no dependen solo de la media -->
    <section id="reconocimientos" aria-label="Reconocimientos"></section>
    <!-- Vista y orden -->
    <div id="vista-bar" class="flex flex-wrap items-center gap-3 -mb-2">
      <div id="vista-seg" class="flex gap-1 text-xs font-display font-bold uppercase tracking-wider bg-black/40 p-1 rounded-lg border border-galaxy-border/60" role="group" aria-label="Vista">
        <button type="button" data-vista="plano" aria-pressed="true" class="toggle-btn px-3 py-1.5 rounded text-gray-400 hover:text-white transition-colors">Todos</button>
        <button type="button" data-vista="estilo" aria-pressed="false" class="toggle-btn px-3 py-1.5 rounded text-gray-400 hover:text-white transition-colors">Por estilo</button>
        <button type="button" data-vista="nivel" aria-pressed="false" class="toggle-btn px-3 py-1.5 rounded text-gray-400 hover:text-white transition-colors">Por nivel</button>
      </div>
      <label id="orden-wrap" class="flex items-center gap-2 text-xs text-gray-400">Ordenar por
        <select id="orden-select" class="field !w-auto !min-h-9"></select></label>
    </div>
    <!-- Herramientas sutiles: leyenda de stats y zoom (tamaño de tarjeta; la cuadrícula acomoda cuántas caben, como el explorador de archivos) -->
    <div class="flex justify-end items-center gap-1 -mb-3 text-gray-500">
      <button id="btn-leyenda" type="button" class="dens-btn" aria-label="Ver leyenda de las stats" title="Leyenda de stats"><i class="fa-solid fa-circle-info"></i></button>
      <span class="w-px h-4 bg-galaxy-line mx-1"></span>
      <button id="dens-menos" type="button" class="dens-btn" aria-label="Alejar: tarjetas más pequeñas, caben más" title="Alejar"><i class="fa-solid fa-minus"></i></button>
      <button id="dens-reset" type="button" class="dens-btn dens-reset" aria-label="Restablecer el tamaño predeterminado de las tarjetas" title="Tamaño predeterminado (Ctrl + 0)"><i class="fa-solid fa-table-cells-large"></i><span>Predeterminado</span></button>
      <button id="dens-mas" type="button" class="dens-btn" aria-label="Acercar: tarjetas más grandes, caben menos" title="Acercar"><i class="fa-solid fa-plus"></i></button>
    </div>
    <div id="players-container" class="grid pt-2">
      <div class="col-span-full text-center py-10 text-gray-400 text-sm flex flex-col items-center"><i class="fa-solid fa-circle-notch fa-spin text-3xl text-galaxy-400 mb-3"></i> Descargando registros de la liga...</div>
    </div>
  </div>
  <!-- Barra flotante de comparación (aparece al marcar jugadores con la balanza) -->
  <div id="cmp-bar" hidden class="fixed bottom-4 left-1/2 -translate-x-1/2 z-[60] w-[calc(100%-2rem)] max-w-md glass-panel rounded-xl border border-galaxy-400/40 shadow-[0_0_24px_rgba(0,229,255,0.25)] px-3 py-2 flex items-center gap-2">
    <i class="fa-solid fa-scale-balanced text-galaxy-400"></i>
    <span id="cmp-bar-txt" class="flex-1 min-w-0 truncate text-xs text-gray-200 font-display uppercase tracking-wide"></span>
    <button id="cmp-clear" type="button" class="text-[11px] text-gray-400 hover:text-white uppercase font-bold px-2 min-h-9">Limpiar</button>
    <button id="cmp-go" type="button" class="btn btn-primary !py-1.5 !px-3 !text-xs" disabled>Comparar</button>
  </div>
</Layout>
<script>
  import '../js/pages/database.js';
</script>

---
// BANDEJA IA (ronda 345): lo que prepara la IA espera aquí el ✅ o ❌ de un moderador/admin. Plan: docs/PLAN-IA-WEB.md
import Layout from '../layouts/Layout.astro';
import Plegable from '../components/Plegable.astro';
---
<Layout title="Bandeja IA" active="bandejaia">
  <div class="max-w-4xl mx-auto px-4 sm:px-8 py-4 sm:py-6 w-full space-y-4">
    <header class="glass-panel px-4 py-3 rounded-2xl flex flex-wrap items-center gap-3">
      <div class="flex-1 min-w-0">
        <span class="text-[12px] font-display font-bold text-galaxy-400 uppercase tracking-widest bg-galaxy-600/20 px-2 py-0.5 rounded border border-galaxy-400/30">Solo staff</span>
        <h1 class="text-xl sm:text-2xl font-display font-extrabold text-white uppercase tracking-wider text-shadow-glow mt-1"><i class="fa-solid fa-inbox text-galaxy-400 mr-2"></i>Bandeja IA</h1>
        <p class="text-gray-300 text-xs mt-0.5">La IA prepara, tú decides. Nada se publica sin tu aprobación.</p>
      </div>
      <div id="bia-cuenta" class="bia-cuenta" aria-live="polite"></div>
    </header>

    <div id="bia-sinsesion" hidden class="glass-panel rounded-2xl p-8 text-center text-gray-400 text-sm">Inicia sesión para continuar.</div>
    <div id="bia-denegado" hidden class="glass-panel rounded-2xl p-8 text-center text-sm space-y-1">
      <p class="text-white font-display font-bold uppercase tracking-wider"><i class="fa-solid fa-lock text-galaxy-400 mr-2"></i>Esta página es solo para el staff</p>
      <p class="text-gray-400 text-xs">Solo un moderador o un admin puede aprobar lo que prepara la IA.</p>
    </div>

    <div id="bia-app" hidden class="space-y-4">
      <div id="bia-error" hidden role="alert" class="rounded-xl border border-rose-400/40 bg-rose-500/10 px-4 py-3 text-sm text-rose-200 flex flex-wrap items-center gap-3">
        <i class="fa-solid fa-triangle-exclamation"></i><span id="bia-error-txt" class="flex-1 min-w-0"></span>
        <button type="button" id="bia-reintentar" class="btn btn-ghost !min-h-8 !px-3 !text-[12px]">Reintentar</button>
      </div>

      <section id="bia-resumen" class="glass-panel rounded-2xl p-4 bia-resumen" aria-live="polite"></section>

      <section class="space-y-3">
        <h2 class="font-display font-bold text-white uppercase tracking-wider text-sm"><i class="fa-solid fa-list-check text-galaxy-400 mr-2"></i>Esperando tu decisión</h2>
        <div id="bia-lista" class="space-y-3" aria-live="polite"></div>
      </section>

      <Plegable titulo="Historial" icono="fa-clock-rotate-left" resumen="Lo último que se aprobó o rechazó" id="bia-hist-caja">
        <div id="bia-historial" class="space-y-2"></div>
      </Plegable>

      <Plegable titulo="¿Cómo funciona?" icono="fa-circle-question" resumen="Qué hace la IA y qué nunca hace sola">
        <div class="text-sm text-gray-300 space-y-2 bia-guia">
          <p><b>1.</b> Cada mañana la IA revisa la liga, escribe noticias como <b>borrador</b> y deja aquí un <b>resumen del día</b>.</p>
          <p><b>2.</b> Tú lees cada propuesta. <b>Aprobar</b> una noticia la publica. <b>Rechazar</b> la deja como borrador: no se borra nada.</p>
          <p><b>3.</b> La IA <b>nunca</b> toca dinero ni gemas, no castiga ni banea a nadie y no borra nada.</p>
          <p class="text-gray-400 text-xs">Solo los moderadores y admins ven esta página. Cada decisión queda anotada con tu nombre y la hora.</p>
        </div>
      </Plegable>
    </div>
  </div>
</Layout>
<script>
  import '../js/pages/bandejaIA.js';
</script>

---
// PLANTILLA ÚNICA. Cabecera, ticker, menú y pie existen SOLO aquí.
import '@fontsource/rajdhani/500.css';
import '@fontsource/rajdhani/600.css';
import '@fontsource/rajdhani/700.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/600.css';
import '@fortawesome/fontawesome-free/css/all.min.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Ticker from '../components/Ticker.astro';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';

const { title, active = '', description = 'Phoenix Evolution Series — la liga competitiva de PES 2021 y SP Football Life 2026.' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Phoenix Evolution Series</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#03010f" />
    {import.meta.env.PUBLIC_PREVIEW && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/png" href={`${base}favicon.png`} />
  </head>
  <body class="flex flex-col min-h-screen">
    <div class="sticky top-0 z-50 flex flex-col pointer-events-none">
      <Header active={active} />
      <Ticker />
    </div>
    <Sidebar active={active} />
    <main class="flex-grow w-full"><slot /></main>
    <Footer />
    <!-- Pulso en vivo (features/liveFeed.js): mensajes con hora exacta + historial de 2 horas. Solo los botones y el historial reciben clics. -->
    <div id="live-wrap" class="fixed left-3 right-3 bottom-3 md:left-auto md:right-4 md:bottom-4 md:w-[22rem] z-[60] flex flex-col items-start md:items-end gap-2 pointer-events-none">
      <section id="live-hist" hidden aria-label="Historial de actividad" class="live-hist pointer-events-auto">
        <header><b><i class="fa-solid fa-clock-rotate-left mr-2 text-galaxy-400"></i>Últimas 2 horas <span id="live-hist-count" class="text-gray-400 font-normal">0</span></b><button id="live-hist-close" type="button" aria-label="Cerrar historial"><i class="fa-solid fa-xmark"></i></button></header>
        <ul id="live-hist-list"></ul>
      </section>
      <div id="live-feed" aria-hidden="true" class="flex flex-col items-start md:items-end gap-1.5 max-w-full"></div>
      <div class="flex items-center gap-2 pointer-events-auto">
        <button id="live-hist-btn" type="button" class="live-toggle" aria-expanded="false" aria-controls="live-hist" aria-label="Ver historial de actividad"><i class="fa-solid fa-clock-rotate-left"></i><span class="live-toggle-txt">Historial</span></button>
        <button id="live-toggle" type="button" aria-pressed="true" class="live-toggle"><span class="live-dot"></span><span class="live-toggle-txt">En vivo</span></button>
      </div>
    </div>
    <script>
      import '../js/boot.js';
    </script>
  </body>
</html>

---
// PLANTILLA ÚNICA. Cabecera, ticker, menú y pie existen SOLO aquí.
import '@fontsource/rajdhani/500.css';
import '@fontsource/rajdhani/600.css';
import '@fontsource/rajdhani/700.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/600.css';
import '@fortawesome/fontawesome-free/css/all.min.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Ticker from '../components/Ticker.astro';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';
import BarraLateral from '../components/BarraLateral.astro';
import { FX } from '../data/experimento.js';

const { title, active = '', description = 'Phoenix Evolution Series — la liga competitiva de PES 2021 y SP Football Life 2026.' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="es" data-fx-reveal={FX.reveal ? '' : undefined} data-fx-esqueletos={FX.esqueletos ? '' : undefined} data-fx-barra={FX.barraLateral ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Phoenix Evolution Series</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#03010f" />
    {import.meta.env.PUBLIC_PREVIEW && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/png" href={`${base}favicon.png`} />
      <script is:inline>document.documentElement.classList.add('js');</script>
    {FX.transiciones && <style is:inline>{`@view-transition { navigation: auto; } ::view-transition-old(root), ::view-transition-new(root) { animation-duration: .22s; } @media (prefers-reduced-motion: reduce) { @view-transition { navigation: none; } }`}</style>}
  </head>
  <body class="flex flex-col min-h-screen">
    <div class="sticky top-0 z-50 flex flex-col pointer-events-none">
      <Header active={active} />
      <Ticker />
    </div>
    <Sidebar active={active} />
    {FX.barraLateral && <BarraLateral active={active} />}
    <main class="flex-grow w-full"><slot /></main>
    <Footer />
    <!-- Pulso en vivo (features/liveFeed.js): mensajes con hora exacta. El historial del día se abre en otra pestaña (/historial-en-vivo/). El botón «En vivo» se mueve manteniéndolo pulsado. -->
    <div id="live-wrap" class="fixed left-3 right-3 bottom-3 md:left-auto md:right-4 md:bottom-4 md:w-[22rem] z-[60] flex flex-col items-start md:items-end gap-2 pointer-events-none">
      <div id="live-feed" aria-hidden="true" class="flex flex-col items-start md:items-end gap-1.5 max-w-full"></div>
      <div id="live-row" class="flex items-center gap-2 pointer-events-auto">
        <a id="live-hist-btn" href={`${import.meta.env.BASE_URL}historial-en-vivo/`} target="_blank" rel="noopener" class="live-toggle" aria-label="Abrir el historial de hoy en otra pestaña"><i class="fa-solid fa-clock-rotate-left"></i><span class="live-toggle-txt">Historial</span></a>
        <button id="live-toggle" type="button" aria-pressed="true" class="live-toggle live-movible" title="Mantén pulsado y arrastra para mover"><span class="live-dot"></span><span class="live-toggle-txt">En vivo</span></button>
      </div>
    </div>
    <script>
      import '../js/boot.js';
    </script>
  </body>
</html>

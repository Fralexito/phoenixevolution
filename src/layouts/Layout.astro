---
// PLANTILLA ÚNICA. Cabecera, ticker, menú y pie existen SOLO aquí.
import { VERSION_BETA } from '../data/versionWeb.js';
// Hora en que se generó esta versión (hora de Lima): sale en la cinta «Fase beta» para saber si ya ves lo último.
const HORA_BUILD = new Date().toLocaleString('es-PE', { timeZone: 'America/Lima', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).replace('.,', '');
import '@fontsource/rajdhani/500.css';
import '@fontsource/rajdhani/600.css';
import '@fontsource/rajdhani/700.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/600.css';
// Font Awesome SIN «brands» (113 KB menos por visita): las marcas van como máscaras SVG en styles/marcas.css.
import '@fortawesome/fontawesome-free/css/fontawesome.min.css';
// Sólido RECORTADO a los iconos que usa la web (117 KB → ~23 KB por visita). Si añades un icono «fa-…» nuevo: node tools/iconos/recortar-iconos.mjs
import '../styles/iconos/fa-solid.css';
import '@fortawesome/fontawesome-free/css/regular.min.css';
import '../styles/marcas.css';
// Precarga de las fuentes que se ven arriba de todo (títulos y texto): evita que la página «salte» al cambiar de fuente (CLS).
import fRaj700 from '@fontsource/rajdhani/files/rajdhani-latin-700-normal.woff2?url';
import fRaj600 from '@fontsource/rajdhani/files/rajdhani-latin-600-normal.woff2?url';
import fInter400 from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import fFaSolid from '../styles/iconos/fa-solid-900.recortado.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Ticker from '../components/Ticker.astro';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';
import BarraLateral from '../components/BarraLateral.astro';
import BarraInferior from '../components/BarraInferior.astro';
import PilarTabs from '../components/PilarTabs.astro';
import { FX } from '../data/experimento.js';
import { pilarDe } from '../data/site.js';
// Páginas que NO reciben el estilo «sin huella de IA»: su identidad depende de brillos/degradados/cartas (portada, cartas de jugadores, tienda, vitrina, logros, duelos y en vivo, perfil).
const SIN_IA_NO = ['central', 'duelos', ''];   // portada y Duelos tienen diseño propio; el resto ya usa el estilo sin huella de IA (ronda 325)

const { title, active = '', description = 'Phoenix Evolution Series — la liga competitiva de PES 2021 y SP Football Life 2026.' } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonica = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="es" data-barra-inf={FX.barraInferior ? '' : undefined} data-base-barra-inf={FX.barraInferior ? '' : undefined} data-fx-reveal={FX.reveal ? '' : undefined} data-fx-esqueletos={FX.esqueletos ? '' : undefined} data-fx-barra={FX.barraLateral ? '' : undefined} data-fx-dopamina={FX.dopamina ? '' : undefined} data-fx-3d={FX.prof3d ? '' : undefined} data-fx-premium={FX.premium ? '' : undefined} data-fx-ordenado={FX.ordenado ? '' : undefined} data-fx-marco={FX.marco ? '' : undefined} data-fx-duelos-pro={FX.duelosPro ? '' : undefined} data-fx-jbarra={FX.jugadoresBarra ? '' : undefined} data-fx-contactos={FX.contactos ? '' : undefined} data-base-contactos={FX.contactos ? '' : undefined} data-fx-vitrina={FX.vitrina ? '' : undefined} data-fx-pro={FX.estiloPro ? '' : undefined} data-fx-pasada={FX.pasada ? '' : undefined} data-sin-ico={FX.sinIconosWeb ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Phoenix Evolution Series</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#03010f" />
    {import.meta.env.PUBLIC_PREVIEW && <meta name="robots" content="noindex, nofollow" />}
    {[fRaj700, fRaj600, fInter400, fFaSolid].map((f) => <link rel="preload" as="font" type="font/woff2" href={f} crossorigin />)}
    <link rel="icon" type="image/png" href={`${base}favicon.png`} />
    <link rel="apple-touch-icon" href={`${base}icono-180.png`} />
    <link rel="manifest" href={`${base}site.webmanifest`} />
    <link rel="canonical" href={canonica} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Phoenix Evolution Series" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:title" content={`${title} | Phoenix Evolution Series`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={new URL(`${base}og.jpg`, Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
      <script is:inline>document.documentElement.classList.add('js');</script>
    {FX.contactos && <script is:inline set:html={"try{var h=document.documentElement,l=localStorage;for(var i=0;i<l.length;i++){if(/^sb-.*-auth-token$/.test(l.key(i))){h.setAttribute('data-sesion','si');break}}if(l.getItem('pes-contactos-compacto')==='1')h.setAttribute('data-cf-compacto','')}catch(e){}"} />}
    {FX.transiciones && <style is:inline>{`@view-transition { navigation: auto; } ::view-transition-old(root), ::view-transition-new(root) { animation-duration: .22s; }`}</style>}
    {/* Ronda 243: «Animaciones» de Ajustes, ANTES de pintar (así nada se mueve un instante si debe estar quieto, y «Siempre activas» manda sobre el sistema).
         Mismo criterio que core/sistema/ajustes.js → movimientoReducido. También salta la transición entre páginas si está «reducido». */}
    <script is:inline set:html={"try{var h=document.documentElement,a=JSON.parse(localStorage.getItem('pes-ajustes-v1')||'{}'),m=a&&a.movimiento,s=matchMedia('(prefers-reduced-motion: reduce)').matches,l=0;try{var d=JSON.parse(localStorage.getItem('pes-rend-ligero')||'null');l=d&&d.v===1&&Date.now()-d.t<1209600000&&Date.now()>d.t-60000&&m!=='normal'?1:0}catch(e){}for(var k in a){var v=a[k];if(typeof v==='boolean')v=v?'si':'no';if(typeof v==='string'&&v.length<40)h.setAttribute('data-aj-'+k.replace(/[A-Z]/g,function(x){return '-'+x.toLowerCase()}),v)}if(a.barraInferior===false)h.removeAttribute('data-barra-inf');if(a.contactos===false)h.removeAttribute('data-fx-contactos');h.setAttribute('data-aj-mov-efectivo',m==='reducido'||(m!=='normal'&&(s||l))?'reducido':'normal');if(l)h.setAttribute('data-rend-ligero','1')}catch(e){}addEventListener('pagereveal',function(e){if(e.viewTransition&&(document.documentElement.getAttribute('data-aj-mov-efectivo')==='reducido'||document.documentElement.getAttribute('data-aj-transiciones')==='no'))e.viewTransition.skipTransition()});addEventListener('pageswap',function(e){if(e.viewTransition&&(document.documentElement.getAttribute('data-aj-mov-efectivo')==='reducido'||document.documentElement.getAttribute('data-aj-transiciones')==='no'))e.viewTransition.skipTransition()});"} />
  </head>
  <body class="flex flex-col min-h-screen">
    {import.meta.env.PUBLIC_PREVIEW && <div class="fase-beta-cinta" role="note" aria-label={`Fase beta ${VERSION_BETA}: versión privada de pruebas, generada el ${HORA_BUILD}`} title={`Generada el ${HORA_BUILD} (hora de Lima)`}><i class="fa-solid fa-flask"></i> <b>Fase beta {VERSION_BETA}</b><span class="fbc-largo"> · {HORA_BUILD}</span></div>}
    <div class="sticky top-0 z-50 flex flex-col pointer-events-none">
      <Header active={active} />
      <Ticker />
    </div>
    <Sidebar active={active} />
    {FX.barraLateral && <BarraLateral active={active} />}
    <main class="flex-grow w-full" data-mundo={FX.pilares ? pilarDe(active)?.id : undefined} data-activa={active} data-sia={SIN_IA_NO.includes(active ?? '') ? undefined : ''}>{FX.pilares && <PilarTabs active={active} />}<slot /></main>
    <Footer />
    {FX.barraInferior && <BarraInferior active={active} />}
    <!-- Pulso en vivo (features/liveFeed.js): mensajes con hora exacta. El historial del día se abre en otra pestaña (/historial-en-vivo/). El botón «En vivo» se mueve manteniéndolo pulsado. -->
    <div id="live-wrap" class="fixed left-3 right-3 bottom-3 md:left-auto md:right-4 md:bottom-4 md:w-[22rem] z-[60] flex flex-col items-start md:items-end gap-2 pointer-events-none">
      <div id="live-feed" aria-hidden="true" class="flex flex-col items-start md:items-end gap-1.5 max-w-full"></div>
      <div id="live-row" class="flex items-center gap-2 pointer-events-auto">
        <a id="live-hist-btn" title="Historial de hoy" href={`${import.meta.env.BASE_URL}historial-en-vivo/`} target="_blank" rel="noopener" class="live-toggle" aria-label="Abrir el historial de hoy en otra pestaña"><i class="fa-solid fa-clock-rotate-left"></i><span class="live-toggle-txt">Historial</span></a>
        <button id="live-toggle" type="button" aria-pressed="true" class="live-toggle live-movible" title="Mantén pulsado y arrastra para mover"><span class="live-dot"></span><span class="live-toggle-txt">En vivo</span></button>
      </div>
    </div>
    <script>
      import '../js/boot.js';
    </script>
  </body>
</html>

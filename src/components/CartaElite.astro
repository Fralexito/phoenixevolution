---
// EXPERIMENTO: carta de jugador "élite" dibujada 100 % con CSS (sin imagen de fondo). Todo escala con el ancho de la carta (unidades cqw).
// Props: datos de UN jugador. Los textos se escapan solos (Astro escapa las expresiones {…}).
interface Props { fondo?: string; media: number; pos: string; nombre: string; foto?: string; escudo?: string; pais?: 'PE' | string; stats: [string, number][] }
const { fondo, media, pos, nombre, foto, escudo, pais = 'PE', stats } = Astro.props;
const izq = stats.slice(0, 6); const der = stats.slice(6, 12);
---
<div class={`carta-elite${fondo ? ' ce-con-imagen' : ''}`} role="img" aria-label={`${nombre}, media ${media}, ${pos}`}>
  {fondo && <img class="ce-imagen" src={fondo} alt="" />}
  <div class="ce-marco"><div class="ce-fondo">
    {!fondo && <><i class="ce-vetas"></i><i class="ce-brillos"></i></>}
    {foto && <img class="ce-foto" src={foto} alt="" loading="lazy" />}
    <div class="ce-placa"></div>
    <div class="ce-media">{media}</div>
    <div class="ce-pos">{pos}</div>
    <div class="ce-nombre">{nombre}</div>
    <div class="ce-identidad">
      {escudo ? <img src={escudo} alt="" /> : <span></span>}
      <b></b>
      {pais === 'PE' && <span class="ce-bandera" aria-hidden="true"></span>}
    </div>
    <div class="ce-stats">
      <ul>{izq.map(([k, v]) => <li><em>{v}</em><span>{k}</span></li>)}</ul>
      <ul>{der.map(([k, v]) => <li><em>{v}</em><span>{k}</span></li>)}</ul>
    </div>
    <i class="ce-corona"><svg viewBox="0 0 24 16" aria-hidden="true"><path d="M2 14 1 4l6 5 5-8 5 8 6-5-1 10z" fill="currentColor"/></svg></i>
  </div></div>
</div>

<style is:global>
  .carta-elite { --oro1:#fff1b0; --oro2:#e9b94a; --oro3:#a8741a; --texto-oro:#d9b074; container-type: inline-size; position: relative; width: 100%; aspect-ratio: 1086 / 1448; filter: drop-shadow(0 0 2.2cqw rgba(233,185,74,.28)); }
  .carta-elite, .carta-elite * { box-sizing: border-box; }
  .carta-elite .ce-marco, .carta-elite .ce-fondo {
    --forma: polygon(50% 1%, 59% 5.6%, 64.5% 4.2%, 90.8% 12.4%, 90.8% 72%, 92.4% 75%, 90.8% 77%, 90.8% 87%, 66% 97%, 50% 99%, 34% 97%, 9.2% 87%, 9.2% 77%, 7.6% 75%, 9.2% 72%, 9.2% 12.4%, 35.5% 4.2%, 41% 5.6%);
    position: absolute; clip-path: var(--forma);
  }
  .carta-elite .ce-marco { inset: 0; background: linear-gradient(135deg, var(--oro1), var(--oro2) 30%, var(--oro3) 55%, var(--oro2) 80%, var(--oro1)); }
  .carta-elite .ce-fondo { inset: .7cqw; overflow: hidden; background: #060606; }
  /* Vetas: facetas oscuras con líneas doradas finas, a distintos ángulos */
  .carta-elite .ce-vetas { position: absolute; inset: 0; background:
    linear-gradient(115deg, transparent 38%, rgba(233,185,74,.35) 38.2%, transparent 38.6%),
    linear-gradient(62deg,  transparent 52%, rgba(233,185,74,.28) 52.2%, transparent 52.6%),
    linear-gradient(160deg, transparent 20%, rgba(233,185,74,.22) 20.2%, transparent 20.5%),
    linear-gradient(28deg,  transparent 70%, rgba(233,185,74,.30) 70.2%, transparent 70.6%),
    linear-gradient(135deg, #15130e 0%, #070707 35%, #101010 55%, #060606 100%); }
  /* Destellos: luz dorada en los bordes y chispas sueltas */
  .carta-elite .ce-brillos { position: absolute; inset: 0; background:
    radial-gradient(ellipse 28% 20% at 12% 22%, rgba(255,200,80,.30), transparent 70%),
    radial-gradient(ellipse 30% 22% at 90% 24%, rgba(255,200,80,.40), transparent 70%),
    radial-gradient(ellipse 30% 20% at 88% 80%, rgba(255,200,80,.28), transparent 70%),
    radial-gradient(circle at 24% 66%, rgba(255,226,150,.9) 0 .35cqw, transparent .9cqw),
    radial-gradient(circle at 80% 40%, rgba(255,226,150,.8) 0 .3cqw, transparent .8cqw),
    radial-gradient(circle at 62% 14%, rgba(255,226,150,.7) 0 .3cqw, transparent .8cqw); mix-blend-mode: screen; }
  .carta-elite .ce-foto { position: absolute; left: 24%; top: 4.2%; width: 68%; height: 51%; object-fit: cover; object-position: center top;
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 22%, #000 88%, transparent 100%), linear-gradient(to bottom, #000 80%, transparent 100%); -webkit-mask-composite: source-in;
    mask-image: linear-gradient(to right, transparent 0, #000 22%, #000 88%, transparent 100%), linear-gradient(to bottom, #000 80%, transparent 100%); mask-composite: intersect; }
  /* Placa inferior curva con borde dorado */
  .carta-elite .ce-placa { position: absolute; left: -2%; right: -2%; top: 50.5%; bottom: 0; background: linear-gradient(#0b0b0b, #050505); border-radius: 50% 50% 0 0 / 7% 7% 0 0; border-top: .35cqw solid var(--oro2); box-shadow: 0 -1.2cqw 3cqw rgba(0,0,0,.7); }
  .carta-elite .ce-media, .carta-elite .ce-pos, .carta-elite .ce-nombre { position: absolute; font-family: 'Oswald', 'Rajdhani', 'Arial Narrow', sans-serif; font-weight: 700; text-transform: uppercase; line-height: 1;
    background: linear-gradient(#fff3bd, #e8b84a 55%, #9b6a16); -webkit-background-clip: text; background-clip: text; color: transparent; filter: drop-shadow(0 .4cqw .6cqw rgba(0,0,0,.6)); }
  .carta-elite .ce-media { left: 15.5%; top: 11.8%; font-size: 17cqw; letter-spacing: -.02em; }
  .carta-elite .ce-pos { left: 16.4%; top: 24.8%; font-size: 7.4cqw; letter-spacing: .02em; padding-bottom: 1.2cqw; border-bottom: .25cqw solid rgba(233,185,74,.55); }
  .carta-elite .ce-nombre { left: 0; right: 0; top: 51.4%; text-align: center; font-size: 8.4cqw; letter-spacing: .04em; }
  .carta-elite .ce-identidad { position: absolute; left: 0; right: 0; top: 60.2%; height: 6.6%; display: flex; align-items: center; justify-content: center; gap: 6cqw; }
  .carta-elite .ce-identidad img { height: 100%; width: auto; object-fit: contain; mix-blend-mode: screen; }
  .carta-elite .ce-identidad b { width: .25cqw; height: 120%; background: rgba(233,185,74,.45); }
  .carta-elite .ce-bandera { height: 55%; aspect-ratio: 3/2; background: linear-gradient(90deg, #d91023 0 25%, #fff 25% 75%, #d91023 75%); border-radius: .3cqw; }
  .carta-elite .ce-stats { position: absolute; left: 9.2%; right: 9.2%; top: 65.6%; bottom: 10.5%; display: grid; grid-template-columns: 1fr 1fr; border-top: .25cqw solid rgba(233,185,74,.45); }
  .carta-elite .ce-stats ul { list-style: none; margin: 0; padding: 1.4cqw 0 0 17%; display: flex; flex-direction: column; justify-content: space-between; }
  .carta-elite .ce-stats ul + ul { border-left: .25cqw solid rgba(233,185,74,.4); padding-left: 12%; }
  .carta-elite .ce-stats li { display: flex; align-items: baseline; gap: 3.4cqw; font-family: 'Oswald', 'Rajdhani', 'Arial Narrow', sans-serif; font-weight: 700; color: var(--texto-oro); font-size: 5.1cqw; line-height: 1; }
  .carta-elite .ce-stats em { font-style: normal; min-width: 2ch; text-align: right; }
  .carta-elite .ce-stats span { letter-spacing: .02em; }
  .carta-elite .ce-corona { position: absolute; left: 50%; bottom: 3.6%; width: 6cqw; transform: translateX(-50%); color: var(--oro2); display: block; }
  @media (prefers-reduced-motion: no-preference) { .carta-elite .ce-brillos { animation: ce-brillo 6s ease-in-out infinite alternate; } }
  @keyframes ce-brillo { from { opacity: .75; } to { opacity: 1; } }
  /* Modo imagen: el marco y el fondo vienen de un PNG/WebP; el código solo coloca encima foto y datos (recortados al interior del marco). */
  .carta-elite .ce-imagen { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .carta-elite.ce-con-imagen .ce-marco { background: none; }
  .carta-elite.ce-con-imagen .ce-fondo { inset: 2.3cqw; background: none; }
  .carta-elite.ce-con-imagen { filter: none; }
</style>

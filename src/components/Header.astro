---
import { NAV } from '../data/site.js';
const base = import.meta.env.BASE_URL;
const { active } = Astro.props;
---
<nav class="glass-panel pointer-events-auto relative z-20 border-b border-galaxy-border/80 shadow-[0_6px_24px_rgba(128,0,255,0.14)]">
  <div class="w-full pl-6 pr-4 md:pl-12 md:pr-8 flex items-center justify-between h-16 relative">
    <a href={base} class="logo-group flex items-center gap-3 z-10" aria-label="Phoenix Evolution Series — Inicio">
      <span class="w-10 h-10 rounded-full overflow-hidden border border-galaxy-400/50 shadow-[0_0_15px_rgba(0,229,255,0.4)] shrink-0">
        <img src={`${base}logo.webp`} alt="Logo Phoenix" width="40" height="40" class="w-full h-full object-cover" />
      </span>
      <span class="font-display font-extrabold text-xl sm:text-2xl tracking-wider select-none text-white flex items-center whitespace-nowrap">
        <span class="text-galaxy-400 text-shadow-glow">P</span><span class="logo-expand text-galaxy-400">HOENIX</span>
        <span class="text-galaxy-600">E</span><span class="logo-expand text-galaxy-600">VOLUTION</span>
        <span class="text-white">S</span><span class="logo-expand text-white">ERIES</span>
      </span>
    </a>

    <div class="hidden lg:flex items-center gap-1 font-display text-[0.95rem] xl:text-[1.05rem] ml-auto">
      {NAV.map((n) => (
        <a href={`${base}${n.path}`} class="nav-link" aria-current={active === n.id ? 'page' : undefined}>{n.label}</a>
      ))}
    </div>

    <!-- Separador: aleja el menú de "Entrar / Registrarse" para que no se confundan. -->
    <span class="hidden lg:block w-px h-7 bg-galaxy-border mx-3 xl:mx-10" aria-hidden="true"></span>

    <div class="flex items-center justify-end shrink-0 gap-3 sm:gap-4 relative z-10">
      <button type="button" data-abrir-buscador aria-label="Buscar en el sitio (tecla /)" title="Buscar (/)" class="text-gray-400 hover:text-galaxy-400 transition-colors w-9 h-9 flex items-center justify-center rounded-full hover:bg-white/5"><i class="fa-solid fa-magnifying-glass text-lg"></i></button>
      <div id="nav-auth" class="flex items-center h-full gap-3"></div>
      <span class="menu-sep w-px h-6 bg-galaxy-border"></span>
      <button id="btn-menu" type="button" aria-label="Abrir menú" aria-controls="sidebar-menu" aria-expanded="false"
        class="text-gray-400 hover:text-white transition-colors flex items-center justify-center shrink-0">
        <i class="fa-solid fa-bars text-2xl"></i>
      </button>
    </div>
  </div>
</nav>

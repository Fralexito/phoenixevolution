---
import { NAV, PILARES, pilarDe, esDe } from '../data/site.js';
import { FX } from '../data/experimento.js';
const base = import.meta.env.BASE_URL;
const { active } = Astro.props;
const pilarActual = pilarDe(active)?.id;
---
<nav class="glass-panel pointer-events-auto relative z-20 border-b border-galaxy-border/80 shadow-[0_6px_24px_rgba(128,0,255,0.14)]">
  <div class="w-full pl-6 pr-4 md:pl-12 md:pr-8 flex items-center justify-between h-16 relative">
    <a href={base} class="logo-group flex items-center gap-3 z-10" aria-label="Phoenix Evolution Series — Inicio">
      <span class="w-10 h-10 rounded-full overflow-hidden border border-galaxy-400/50 shadow-[0_0_15px_rgba(0,229,255,0.4)] shrink-0">
        <img src={`${base}logo.webp`} alt="Logo Phoenix" width="40" height="40" class="w-full h-full object-cover" />
      </span>
      <span class="font-display font-extrabold text-xl sm:text-2xl tracking-wider select-none text-white flex items-center whitespace-nowrap">
        <span class="text-galaxy-400 text-shadow-glow">P</span><span class="logo-expand text-galaxy-400">HOENIX</span>
        <span class="text-galaxy-600">E</span><span class="logo-expand text-galaxy-600">VOLUTION</span>
        <span class="text-white">S</span><span class="logo-expand text-white">ERIES</span>
      </span>
    </a>

    <div class="hidden lg:flex items-center gap-1 font-display text-[0.95rem] xl:text-[1.05rem] ml-auto">
      {FX.pilares && <a href={base} class="nav-link" aria-current={active === 'central' ? 'page' : undefined} title="Central"><i class="fa-solid fa-house text-[.85em]"></i><span class="sr-only">Central</span></a>}
      {FX.pilares && <a href={`${base}#empezar`} class="nav-link solo-invitado" title="Guía para empezar"><i class="fa-solid fa-rocket text-[.8em] mr-1.5 opacity-70"></i>Empieza aquí</a>}
      {FX.pilares ? PILARES.map((p) => (
        p.items.length === 1
          ? <a href={`${base}${p.items[0].path}`} class="nav-link" aria-current={pilarActual === p.id ? 'page' : undefined}><i class={`fa-solid ${p.icon} text-[.8em] mr-1.5 opacity-70`}></i>{p.label}</a>
          : <div class:list={['pilar', p.soloCuenta && 'solo-cuenta']} data-pilar={p.id}>
              <button type="button" class="nav-link pilar-btn" aria-expanded="false" aria-haspopup="true" aria-current={pilarActual === p.id ? 'page' : undefined}><i class={`fa-solid ${p.icon} text-[.8em] mr-1.5 opacity-70`}></i>{p.label}<i class="fa-solid fa-chevron-down text-[.6em] ml-1.5 opacity-60 pilar-flecha"></i></button>
              <div class="pilar-panel" role="menu">
                <p class="pilar-lema"><i class={`fa-solid ${p.icon}`}></i> {p.lema}</p>
                <div class="pilar-grid">
                  {p.items.map((n) => (
                    <a href={`${base}${n.path}`} role="menuitem" class="pilar-item" aria-current={esDe(n, active) ? 'page' : undefined}>
                      <i class={`fa-solid ${n.icon}`}></i><span><b>{n.label}</b><small>{n.desc}</small></span>
                    </a>
                  ))}
                </div>
              </div>
            </div>
      )) : NAV.map((n) => (
        <a href={`${base}${n.path}`} class="nav-link" aria-current={esDe(n, active) ? 'page' : undefined}>{n.label}</a>
      ))}
    </div>

    <!-- Separador: aleja el menú de "Entrar / Registrarse" para que no se confundan. -->
    <span class="hidden lg:block w-px h-7 bg-galaxy-border mx-3 xl:mx-10" aria-hidden="true"></span>

    <div class="flex items-center justify-end shrink-0 gap-3 sm:gap-4 relative z-10">
      <button type="button" data-abrir-buscador aria-label="Buscar en el sitio (tecla /)" title="Buscar (/)" class="buscar-pill"><i class="fa-solid fa-magnifying-glass"></i><span class="buscar-pill-txt">Buscar o ir a…</span><kbd class="buscar-pill-kbd">/</kbd></button>
      <div id="nav-auth" class="flex items-center h-full gap-3"></div>
      <span class="menu-sep w-px h-6 bg-galaxy-border"></span>
      <button id="btn-menu" type="button" aria-label="Abrir menú" aria-controls="sidebar-menu" aria-expanded="false"
        class="text-gray-400 hover:text-white transition-colors flex items-center justify-center shrink-0">
        <i class="fa-solid fa-bars text-2xl"></i>
      </button>
    </div>
  </div>
</nav>

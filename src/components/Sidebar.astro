---
import SocialIcon from './SocialIcon.astro';
import { SECCIONES, seccionDe, rutaDeSeccion, ACCOUNT_NAV, SOCIALS } from '../data/site.js';
const base = import.meta.env.BASE_URL;
const { active } = Astro.props;
const actual = seccionDe(active);
---
<div id="sidebar-overlay" hidden class="fixed inset-0 bg-black/70 backdrop-blur-sm z-[400]"></div>
<aside id="sidebar-menu" aria-label="Red de enlaces" inert
  class="sidebar-panel fixed top-0 right-0 h-full w-64 sm:w-[300px] bg-galaxy-panel border-l border-galaxy-border shadow-[-15px_0_40px_rgba(0,0,0,0.8)] z-[410] translate-x-full flex flex-col">
  <div class="p-5 border-b border-galaxy-border flex justify-between items-center bg-gradient-to-l from-galaxy-900 to-galaxy-deep">
    <h3 class="font-display font-black text-lg text-white uppercase tracking-widest flex items-center">
      <i class="fa-solid fa-satellite text-galaxy-400 mr-3"></i> Red de Enlaces
    </h3>
    <button id="btn-menu-close" type="button" aria-label="Cerrar menú" class="text-gray-500 hover:text-white transition-colors">
      <i class="fa-solid fa-xmark text-xl"></i>
    </button>
  </div>
  <nav class="flex-1 p-4 flex flex-col gap-1.5 font-display text-base uppercase tracking-wider overflow-y-auto">
    <!-- «Explorar» repite la barra superior: en PC se oculta (lg:hidden); en móvil es el menú completo. -->
    <div class="flex flex-col gap-1.5 lg:hidden">
    <div class="px-3 pt-1 pb-1 text-[10px] text-gray-500 tracking-[0.25em]">Explorar</div>
    {SECCIONES.map((x) => x.items.length === 0 ? (
      <a href={`${base}${rutaDeSeccion(x)}`} aria-current={actual?.id === x.id ? 'page' : undefined}
        class={`flex items-center gap-4 p-3 rounded-lg transition-all ${actual?.id === x.id ? 'text-galaxy-400 bg-galaxy-400/10 border border-galaxy-400/30' : 'text-gray-300 hover:text-white hover:bg-white/5'}`}>
        <i class={`fa-solid ${x.icon} w-5 text-center ${actual?.id === x.id ? 'text-galaxy-400' : 'text-gray-500'}`}></i> {x.label}
      </a>
    ) : (
      <details class="grupo-movil" open={actual?.id === x.id}>
        <summary class={`flex items-center gap-4 p-3 rounded-lg cursor-pointer list-none ${actual?.id === x.id ? 'text-galaxy-400 bg-galaxy-400/10 border border-galaxy-400/30' : 'text-gray-300 hover:text-white hover:bg-white/5'}`}>
          <i class={`fa-solid ${x.icon} w-5 text-center ${actual?.id === x.id ? 'text-galaxy-400' : 'text-gray-500'}`}></i><span class="flex-1">{x.label}</span><i class="fa-solid fa-chevron-down text-[.65rem] opacity-60 grupo-flecha"></i>
        </summary>
        <div class="ml-4 pl-3 border-l border-galaxy-border/70 flex flex-col gap-0.5 py-1">
          {x.items.map((i) => (
            <a href={`${base}${i.path}`} aria-current={active === i.id ? 'page' : undefined} class={`flex items-center gap-3 px-3 py-2 rounded-lg text-sm normal-case tracking-normal ${active === i.id ? 'text-galaxy-400 bg-galaxy-400/10' : 'text-gray-400 hover:text-white hover:bg-white/5'}`}>
              <i class={`fa-solid ${i.icon} w-4 text-center text-xs ${active === i.id ? 'text-galaxy-400' : 'text-gray-500'}`}></i>{i.label}
            </a>
          ))}
        </div>
      </details>
    ))}
    </div>
    <!-- «Mi cuenta» solo en PC: en móvil vive en el menú de la foto de perfil (navbar.js). -->
    <div id="sidebar-account" hidden class="max-lg:!hidden flex flex-col flex-1 gap-1.5 mt-3 pt-3 border-t border-galaxy-border lg:mt-0 lg:pt-0 lg:border-t-0">
      <div class="px-3 pb-1 text-[10px] text-gray-500 tracking-[0.25em]">Mi cuenta</div>
      {ACCOUNT_NAV.filter((n) => !n.abajo).map((n) => (
        n.path
          ? <a href={`${base}${n.path}`} data-solo-staff={n.staff ? n.staff : undefined} hidden={n.staff ? true : undefined} aria-current={active === n.id ? 'page' : undefined} class={`flex items-center gap-4 p-3 rounded-lg hover:text-white hover:bg-white/5 ${active === n.id ? 'text-galaxy-400 bg-galaxy-400/10' : 'text-gray-400'}`}><i class={`fa-solid ${n.icon} w-5 text-center ${active === n.id ? 'text-galaxy-400' : 'text-gray-500'}`}></i> {n.label}</a>
          : <button type="button" data-action={n.action} class="flex items-center gap-4 p-3 rounded-lg text-gray-400 hover:text-white hover:bg-white/5 text-left uppercase"><i class={`fa-solid ${n.icon} w-5 text-center text-gray-500`}></i> {n.label}</button>
      ))}
      <!-- Bloque inferior: Configuración y Salir, pegados al fondo del panel -->
      <div class="mt-auto sticky bottom-0 pt-2 border-t border-galaxy-border/70 flex flex-col gap-1.5 bg-galaxy-panel">
        {ACCOUNT_NAV.filter((n) => n.abajo).map((n) => (
          n.path
            ? <a href={`${base}${n.path}`} aria-current={active === n.id ? 'page' : undefined} class="flex items-center gap-4 p-3 rounded-lg text-gray-300 hover:text-white hover:bg-white/5"><i class={`fa-solid ${n.icon} w-5 text-center text-galaxy-400`}></i> {n.label}</a>
            : <button type="button" data-action={n.action} class="flex items-center gap-4 p-3 rounded-lg text-gray-400 hover:text-bad hover:bg-white/5 text-left uppercase"><i class={`fa-solid ${n.icon} w-5 text-center text-gray-500`}></i> {n.label}</button>
        ))}
      </div>
    </div>
  </nav>
  <div class="p-5 border-t border-galaxy-border bg-black/50 text-center lg:hidden">
    <div class="text-[9px] text-gray-500 tracking-widest uppercase mb-3">Redes Sociales</div>
    <div class="flex justify-center gap-4">
      {SOCIALS.map((s) => (<a href={s.href} aria-label={s.label} target="_blank" rel="noopener noreferrer" class={`text-gray-400 ${s.hover} text-lg transition-colors`}><SocialIcon s={s} /></a>))}
    </div>
  </div>
</aside>

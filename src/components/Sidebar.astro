---
import SocialIcon from './SocialIcon.astro';
import { NAV, NAV_EXTRA, ACCOUNT_NAV, GRUPOS_CUENTA, SOCIALS, PILARES } from '../data/site.js';
import { FX } from '../data/experimento.js';
// Panel «Mi cuenta» en bloques con mosaico de 3 columnas: todo cabe sin scroll y cada cosa tiene su lugar.
const grupos = GRUPOS_CUENTA.map((g) => ({ ...g, items: ACCOUNT_NAV.filter((n) => n.grupo === g.id && !n.abajo && n.menu !== false) })).filter((g) => g.items.length);
const base = import.meta.env.BASE_URL;
const { active } = Astro.props;
---
<div id="sidebar-overlay" hidden class="fixed inset-0 bg-black/70 backdrop-blur-sm z-[400]"></div>
<aside id="sidebar-menu" aria-label="Red de enlaces" inert
  class="sidebar-panel fixed top-0 right-0 h-full w-64 sm:w-[300px] bg-galaxy-panel border-l border-galaxy-border shadow-[-15px_0_40px_rgba(0,0,0,0.8)] z-[410] translate-x-full flex flex-col">
  <div class="p-5 border-b border-galaxy-border flex justify-between items-center bg-gradient-to-l from-galaxy-900 to-galaxy-deep">
    <h3 class="font-display font-black text-lg text-white uppercase tracking-widest flex items-center">
      <i class="fa-solid fa-satellite text-galaxy-400 mr-3"></i> Red de Enlaces
    </h3>
    <button id="btn-menu-close" type="button" aria-label="Cerrar menú" class="text-gray-500 hover:text-white transition-colors">
      <i class="fa-solid fa-xmark text-xl"></i>
    </button>
  </div>
  <nav class="flex-1 p-4 flex flex-col gap-1.5 font-display text-base uppercase tracking-wider overflow-y-auto">
    <!-- «Explorar» repite la barra superior: en PC se oculta (lg:hidden); en móvil es el menú completo. -->
    <div class="flex flex-col gap-1.5 lg:hidden">
    {FX.pilares ? (<>
      <a href={base} aria-current={active === 'central' ? 'page' : undefined} class="cuenta-tile !flex-row !justify-start !min-h-0 !py-3 !px-3 !gap-3 !text-[.8rem]"><i class="fa-solid fa-house"></i><span>Central</span></a>
      {PILARES.map((p) => (
        <section class="cuenta-grupo">
          <p class="cuenta-tit"><i class={`fa-solid ${p.icon} mr-1`}></i> {p.label}</p>
          <div class="cuenta-mosaico">{p.items.map((n) => (<a href={`${base}${n.path}`} aria-current={active === n.id ? 'page' : undefined} class="cuenta-tile"><i class={`fa-solid ${n.icon}`}></i><span>{n.label}</span></a>))}</div>
        </section>
      ))}
      <div class="flex gap-3 px-1 pt-2 text-[11px] tracking-widest text-gray-500"><a href={`${base}organizadores/`} class="hover:text-white">Quiénes somos</a><a href={`${base}unirme/`} class="hover:text-galaxy-400">Unirme a la liga</a></div>
    </>) : (<>
    <div class="px-3 pt-1 pb-1 text-[12px] text-gray-500 tracking-[0.25em]">Explorar</div>
    {NAV.map((n) => (
      <a href={`${base}${n.path}`} aria-current={active === n.id ? 'page' : undefined}
        class={`flex items-center gap-4 p-3 rounded-lg transition-all relative overflow-hidden ${active === n.id
          ? 'text-galaxy-400 bg-galaxy-400/10 border border-galaxy-400/30'
          : 'text-gray-400 hover:text-white hover:bg-white/5'}`}>
        {active === n.id && <span class="absolute left-0 top-0 bottom-0 w-1 bg-galaxy-400"></span>}
        <i class={`fa-solid ${n.icon} w-5 text-center ${active === n.id ? 'text-galaxy-400' : 'text-gray-500'}`}></i> {n.label}
      </a>
    ))}
    {NAV_EXTRA.map((n) => (
      <a href={`${base}${n.path}`} aria-current={active === n.id ? 'page' : undefined} class={`flex items-center gap-4 p-3 rounded-lg transition-all ${active === n.id ? 'text-galaxy-400 bg-galaxy-400/10 border border-galaxy-400/30' : 'text-gray-300 hover:text-white hover:bg-white/5 border border-dashed border-galaxy-border/70'}`}><i class={`fa-solid ${n.icon} w-5 text-center text-galaxy-400`}></i> {n.label}</a>
    ))}
    </>)}
    </div>
    <!-- «Mi cuenta» solo en PC: en móvil vive en el menú de la foto de perfil (navbar.js). -->
    <div id="sidebar-account" hidden class="max-lg:!hidden flex flex-col flex-1 gap-1.5 mt-3 pt-3 border-t border-galaxy-border lg:mt-0 lg:pt-0 lg:border-t-0">
      {grupos.map((g) => (
        <section class="cuenta-grupo" data-grupo={g.id} data-solo-staff={g.id === 'staff' ? 'verReportes' : undefined} hidden={g.id === 'staff' ? true : undefined}>
          <p class="cuenta-tit">{g.label}</p>
          <div class="cuenta-mosaico">
            {g.items.map((n) => (
              n.path
                ? <a href={`${base}${n.path}`} data-solo-staff={n.staff ? n.staff : undefined} hidden={n.staff ? true : undefined} aria-current={active === n.id ? 'page' : undefined} class="cuenta-tile"><i class={`fa-solid ${n.icon}`}></i><span>{n.label}</span></a>
                : <button type="button" data-action={n.action} class="cuenta-tile"><i class={`fa-solid ${n.icon}`}></i><span>{n.label}</span></button>
            ))}
          </div>
        </section>
      ))}
      <!-- Bloque inferior: Configuración y Salir, pegados al fondo del panel -->
      <div class="mt-auto sticky bottom-0 pt-2 border-t border-galaxy-border/70 flex flex-col gap-1.5 bg-galaxy-panel">
        {ACCOUNT_NAV.filter((n) => n.abajo).map((n) => (
          n.path
            ? <a href={`${base}${n.path}`} aria-current={active === n.id ? 'page' : undefined} class="flex items-center gap-4 p-3 rounded-lg text-gray-300 hover:text-white hover:bg-white/5"><i class={`fa-solid ${n.icon} w-5 text-center text-galaxy-400`}></i> {n.label}</a>
            : <button type="button" data-action={n.action} class="flex items-center gap-4 p-3 rounded-lg text-gray-400 hover:text-bad hover:bg-white/5 text-left uppercase"><i class={`fa-solid ${n.icon} w-5 text-center text-gray-500`}></i> {n.label}</button>
        ))}
      </div>
    </div>
  </nav>
  <div class="p-5 border-t border-galaxy-border bg-black/50 text-center lg:hidden">
    <div class="text-[12px] text-gray-500 tracking-widest uppercase mb-3">Redes Sociales</div>
    <div class="flex justify-center gap-4">
      {SOCIALS.map((s) => (<a href={s.href} aria-label={s.label} target="_blank" rel="noopener noreferrer" class={`text-gray-400 ${s.hover} text-lg transition-colors`}><SocialIcon s={s} /></a>))}
    </div>
  </div>
</aside>

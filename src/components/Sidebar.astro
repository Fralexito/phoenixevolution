---
import SocialIcon from './SocialIcon.astro';
import { NAV, NAV_EXTRA, ACCOUNT_NAV, SOCIALS } from '../data/site.js';
const base = import.meta.env.BASE_URL;
const { active } = Astro.props;
// Ficha de «Mi cuenta»: cuadrada en móvil; desde lg (PC) vuelve a ser una fila de lista.
const ficha = 'flex flex-col items-center justify-center gap-1.5 rounded-xl border border-galaxy-border/60 bg-white/[0.02] px-2 py-2.5 text-[11px] leading-tight text-center transition-colors lg:flex-row lg:justify-start lg:gap-4 lg:rounded-lg lg:border-transparent lg:bg-transparent lg:p-3 lg:text-base lg:text-left';
---
<div id="sidebar-overlay" hidden class="fixed inset-0 bg-black/70 backdrop-blur-sm z-[400]"></div>
<aside id="sidebar-menu" aria-label="Red de enlaces" inert
  class="sidebar-panel fixed top-0 right-0 h-full w-64 sm:w-[300px] bg-galaxy-panel border-l border-galaxy-border shadow-[-15px_0_40px_rgba(0,0,0,0.8)] z-[410] translate-x-full flex flex-col">
  <div class="px-5 py-4 border-b border-galaxy-border flex justify-between items-center bg-gradient-to-l from-galaxy-900 to-galaxy-deep">
    <h3 class="font-display font-black text-lg text-white uppercase tracking-widest flex items-center">
      <i class="fa-solid fa-satellite text-galaxy-400 mr-3"></i> Red de Enlaces
    </h3>
    <button id="btn-menu-close" type="button" aria-label="Cerrar menú" class="text-gray-500 hover:text-white transition-colors">
      <i class="fa-solid fa-xmark text-xl"></i>
    </button>
  </div>
  <nav class="flex-1 p-3.5 lg:p-4 flex flex-col gap-2 lg:gap-1.5 font-display uppercase tracking-wider overflow-y-auto">
    <!-- «Explorar» repite la barra superior: en PC se oculta (lg:hidden); en móvil son fichas de 2 columnas (más aire y menos scroll que una lista larga). -->
    <div class="lg:hidden space-y-1.5">
      <div class="px-1 text-[10px] text-gray-500 tracking-[0.25em]">Explorar</div>
      <div class="grid grid-cols-2 gap-2">
        {[...NAV, ...NAV_EXTRA].map((n) => (
          <a href={`${base}${n.path}`} aria-current={active === n.id ? 'page' : undefined}
            class={`flex flex-col items-center justify-center gap-1.5 rounded-xl border px-2 py-2.5 text-[11px] leading-tight text-center transition-colors ${active === n.id
              ? 'text-galaxy-400 bg-galaxy-400/10 border-galaxy-400/40'
              : 'text-gray-300 border-galaxy-border/60 bg-white/[0.02] hover:text-white hover:bg-white/5'}`}>
            <i class={`fa-solid ${n.icon} text-base ${active === n.id ? 'text-galaxy-400' : 'text-gray-500'}`}></i><span>{n.label}</span>
          </a>
        ))}
      </div>
    </div>
    <div id="sidebar-account" hidden class="flex flex-col flex-1 gap-1.5 mt-1 pt-3 border-t border-galaxy-border lg:mt-0 lg:pt-0 lg:border-t-0">
      <div class="px-1 lg:px-3 pb-0.5 text-[10px] text-gray-500 tracking-[0.25em]">Mi cuenta</div>
      <!-- Móvil: fichas de 2 columnas. Desde lg (menú de PC): lista vertical de siempre. -->
      <div class="grid grid-cols-2 gap-2 lg:flex lg:flex-col lg:gap-1.5">
        {ACCOUNT_NAV.filter((n) => !n.abajo).map((n) => (
          n.path
            ? <a href={`${base}${n.path}`} aria-current={active === n.id ? 'page' : undefined} class={`${ficha} ${active === n.id ? 'text-galaxy-400 !border-galaxy-400/40 bg-galaxy-400/10' : 'text-gray-300 hover:text-white hover:bg-white/5'}`}><i class={`fa-solid ${n.icon} text-base lg:text-sm lg:w-5 lg:text-center text-gray-500`}></i><span>{n.label}</span></a>
            : <button type="button" data-action={n.action} class={`${ficha} text-gray-300 hover:text-white hover:bg-white/5 uppercase`}><i class={`fa-solid ${n.icon} text-base lg:text-sm lg:w-5 lg:text-center text-gray-500`}></i><span>{n.label}</span></button>
        ))}
      </div>
      <!-- Bloque inferior: Configuración y Salir, pegados al fondo del panel (lado a lado en móvil) -->
      <div class="mt-auto sticky bottom-0 pt-2 border-t border-galaxy-border/70 grid grid-cols-2 gap-2 lg:flex lg:flex-col lg:gap-1.5 bg-galaxy-panel">
        {ACCOUNT_NAV.filter((n) => n.abajo).map((n) => (
          n.path
            ? <a href={`${base}${n.path}`} aria-current={active === n.id ? 'page' : undefined} class={`${ficha} text-gray-200 hover:text-white hover:bg-white/5`}><i class={`fa-solid ${n.icon} text-base lg:text-sm lg:w-5 lg:text-center text-galaxy-400`}></i><span>{n.label}</span></a>
            : <button type="button" data-action={n.action} class={`${ficha} text-gray-400 hover:text-bad hover:bg-white/5 uppercase`}><i class={`fa-solid ${n.icon} text-base lg:text-sm lg:w-5 lg:text-center text-gray-500`}></i><span>{n.label}</span></button>
        ))}
      </div>
    </div>
  </nav>
  <div class="py-3 px-4 border-t border-galaxy-border bg-black/50 text-center lg:hidden">
    <div class="flex justify-center gap-5">
      {SOCIALS.map((s) => (<a href={s.href} aria-label={s.label} target="_blank" rel="noopener noreferrer" class={`text-gray-400 ${s.hover} text-lg transition-colors`}><SocialIcon s={s} /></a>))}
    </div>
  </div>
</aside>

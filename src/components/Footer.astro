---
import SocialIcon from './SocialIcon.astro';
import { SOCIALS } from '../data/site.js';
const base = import.meta.env.BASE_URL;
---
<footer class="border-t border-galaxy-border/60 bg-black/60 backdrop-blur-md mt-auto">
  <div class="w-full px-6 md:px-12 py-6 flex flex-col md:flex-row justify-between items-center gap-4">
    <div class="flex flex-col items-center md:items-start gap-1"><span class="font-display font-bold text-gray-300 tracking-wider">PHOENIX EVOLUTION SERIES</span><a href={`${base}organizadores/`} class="inline-flex items-center gap-2 rounded-full border border-galaxy-400/40 bg-galaxy-400/[.07] px-3 py-1 text-xs font-display font-bold uppercase tracking-wider text-galaxy-400 hover:bg-galaxy-400/15 hover:text-white transition-colors"><i class="fa-solid fa-users"></i>Quiénes somos<span class="hidden sm:inline text-gray-400 normal-case tracking-normal font-sans font-normal">· conoce a los impulsores</span></a></div>
    <div class="flex gap-5 text-lg">
      {SOCIALS.map((s) => (<a href={s.href} aria-label={s.label} target="_blank" rel="noopener noreferrer" class={`text-gray-500 ${s.hover} transition-colors`}><SocialIcon s={s} /></a>))}
    </div>
    <span class="text-xs text-gray-500 tracking-wide">GALAXY LEAGUE © 2026</span>
  </div>
</footer>

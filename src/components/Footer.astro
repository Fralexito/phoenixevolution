---
import SocialIcon from './SocialIcon.astro';
import { SOCIALS } from '../data/site.js';
---
<footer class="border-t border-galaxy-border/60 bg-black/60 backdrop-blur-md mt-auto">
  <div class="w-full px-6 md:px-12 py-6 flex flex-col md:flex-row justify-between items-center gap-4">
    <span class="font-display font-bold text-gray-300 tracking-wider">PHOENIX EVOLUTION SERIES</span>
    <div class="flex gap-5 text-lg">
      {SOCIALS.map((s) => (<a href={s.href} aria-label={s.label} rel="noopener" class={`text-gray-500 ${s.hover} transition-colors`}><SocialIcon s={s} /></a>))}
    </div>
    <span class="text-xs text-gray-500 tracking-wide">GALAXY LEAGUE © 2026</span>
  </div>
</footer>

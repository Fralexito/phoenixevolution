---
import SocialIcon from './SocialIcon.astro';
import { SOCIALS, NAV, NAV_EXTRA, APOYO } from '../data/site.js';
const discord = SOCIALS.find((s) => s.label === 'Discord')?.href;
const rapidos = [...NAV.filter((n) => ['liga', 'database', 'duelos'].includes(n.id)), ...NAV_EXTRA.filter((n) => ['ranking', 'eventos', 'unirme'].includes(n.id))];
const apoyo = /^https:\/\//.test(APOYO.href) ? APOYO : null;
const base = import.meta.env.BASE_URL;
---
<footer class="border-t border-galaxy-border/60 bg-black/60 backdrop-blur-md mt-auto">
  <nav aria-label="Exploración rápida" class="w-full px-6 md:px-12 pt-5 flex flex-wrap justify-center md:justify-start items-center gap-x-5 gap-y-2 text-[11px] font-display font-bold uppercase tracking-widest">
    <span class="text-gray-600">Explora</span>
    {rapidos.map((n) => (<a href={`${base}${n.path}`} class="text-gray-400 hover:text-galaxy-400 transition-colors"><i class={`fa-solid ${n.icon} mr-1.5 text-[10px]`}></i>{n.label}</a>))}
    {discord && <a href={discord} target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-[#5865F2] transition-colors"><i class="fa-brands fa-discord mr-1.5 text-[10px]"></i>Discord</a>}
    {apoyo && <a href={apoyo.href} target="_blank" rel="noopener noreferrer" class="text-amber-400/90 hover:text-amber-300 transition-colors"><i class="fa-solid fa-mug-hot mr-1.5 text-[10px]"></i>{apoyo.texto}</a>}
  </nav>
  <div class="w-full px-6 md:px-12 py-6 flex flex-col md:flex-row justify-between items-center gap-4">
    <div class="flex flex-col items-center md:items-start gap-1"><span class="font-display font-bold text-gray-300 tracking-wider">PHOENIX EVOLUTION SERIES</span><a href={`${base}organizadores/`} class="inline-flex items-center gap-2 rounded-full border border-galaxy-400/40 bg-galaxy-400/[.07] px-3 py-1 text-xs font-display font-bold uppercase tracking-wider text-galaxy-400 hover:bg-galaxy-400/15 hover:text-white transition-colors"><i class="fa-solid fa-users"></i>Quiénes somos<span class="hidden sm:inline text-gray-400 normal-case tracking-normal font-sans font-normal">· conoce al equipo</span></a></div>
    <div class="flex gap-5 text-lg">
      {SOCIALS.map((s) => (<a href={s.href} aria-label={s.label} target="_blank" rel="noopener noreferrer" class={`text-gray-500 ${s.hover} transition-colors`}><SocialIcon s={s} /></a>))}
    </div>
    <span class="text-xs text-gray-500 tracking-wide">GALAXY LEAGUE © 2026</span>
  </div>
</footer>

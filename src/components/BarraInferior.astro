---
// Barra fija de abajo SOLO en celular (patrón de las apps de apuestas: navegación al alcance del pulgar). FX.barraInferior = false la quita.
const { active } = Astro.props;
const base = import.meta.env.BASE_URL;
const ITEMS = [
  { id: ['central'], t: 'Inicio', path: '', ph: 'house' },
  { id: ['liga'], t: 'Liga', path: 'liga/', ph: 'crown' },
  { id: ['duelos'], t: 'Duelos', path: 'duelos/', ph: 'game-controller' },
  { id: ['manager', 'miclub'], t: 'Mi club', path: 'manager/', ph: 'soccer-ball' },
  { id: ['muro', 'perfil', 'social'], t: 'Yo', path: 'perfil/', ph: 'user' },
];
---
<nav class="barra-inf" aria-label="Navegación rápida">
  {ITEMS.map((n) => (
    <a href={`${base}${n.path}`} class="bi-item" aria-current={n.id.includes(active) ? 'page' : undefined}>
      <i class={`ph-bold ph-${n.ph}`} aria-hidden="true"></i><span>{n.t}</span>
    </a>
  ))}
</nav>

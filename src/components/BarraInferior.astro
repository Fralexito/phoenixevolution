---
// Barra fija de abajo SOLO en celular (patrón de las apps de apuestas: navegación al alcance del pulgar). FX.barraInferior = false la quita.
import { BARRA_INFERIOR as ITEMS } from '../data/site.js';   // la misma lista la usa la Red de enlaces para no repetir estos accesos
const { active } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<nav class="barra-inf" aria-label="Navegación rápida">
  {ITEMS.map((n) => (
    <a href={`${base}${n.path}`} class:list={['bi-item', n.joya && 'bi-joya']} aria-current={n.id.includes(active) ? 'page' : undefined}>
      <i class={n.px ? `pxi pxi-${n.px}` : `ph-bold ph-${n.ph}`} aria-hidden="true"></i><span>{n.t}</span>
    </a>
  ))}
</nav>

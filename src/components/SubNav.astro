---
// Pestañas de la sección: para saltar entre páginas hermanas (p. ej. Liga · Palmarés · Mercado · Jugadores) sin volver al menú.
import { seccionDe } from '../data/site.js';
const base = import.meta.env.BASE_URL;
const { active } = Astro.props;
const sec = seccionDe(active);
---
{sec && sec.items.length > 1 && (
  <nav class="subnav" aria-label={`Páginas de ${sec.label}`}>
    <div class="subnav-in">
      <span class="subnav-et"><i class={`fa-solid ${sec.icon}`}></i>{sec.label}</span>
      {sec.items.map((i) => (
        <a href={`${base}${i.path}`} aria-current={active === i.id ? 'page' : undefined}><i class={`fa-solid ${i.icon}`}></i><span>{i.label}</span></a>
      ))}
    </div>
  </nav>
)}

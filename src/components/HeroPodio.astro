---
// Componente: Podio top 3 de la liga (se muestra en pantallas ≥1024px bajo el hero)
// Los datos vienen del JS que carga la tabla real de la liga

interface Props {
  ligaId?: string;
}

const { ligaId = 'galaxy' } = Astro.props;
---

<section class="hero-podio hidden lg:block relative z-10 -mt-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-3 gap-4 text-center">
      <!-- 2º lugar (izquierda): plata -->
      <div class="podio-card podio-2 group glass-panel rounded-lg overflow-hidden transform hover:scale-105 transition-transform duration-300">
        <div class="relative h-32 bg-gradient-to-br from-gray-400 to-gray-600 flex items-end justify-center pb-2">
          <span class="text-3xl font-display font-black text-white drop-shadow-lg">2</span>
        </div>
        <div class="p-4 space-y-2">
          <div class="h-6 bg-galaxy-900/40 rounded animate-pulse"></div>
          <div class="h-4 bg-galaxy-900/30 rounded w-2/3 mx-auto animate-pulse"></div>
          <div class="flex justify-around text-xs text-gray-400 pt-2 border-t border-galaxy-border/30">
            <span>— PJ</span>
            <span>— PTS</span>
          </div>
        </div>
      </div>

      <!-- 1º lugar (centro): oro, más grande -->
      <div class="podio-card podio-1 group glass-panel rounded-lg overflow-hidden transform hover:scale-105 transition-transform duration-300 -mt-4">
        <div class="relative h-40 bg-gradient-to-br from-yellow-300 via-yellow-400 to-yellow-600 flex items-end justify-center pb-3">
          <i class="fa-solid fa-crown text-yellow-200 text-2xl drop-shadow-lg"></i>
        </div>
        <div class="p-5 space-y-2">
          <div class="h-7 bg-galaxy-900/40 rounded animate-pulse"></div>
          <div class="h-4 bg-galaxy-900/30 rounded w-3/4 mx-auto animate-pulse"></div>
          <div class="flex justify-around text-sm text-gray-300 pt-3 border-t border-galaxy-border/30 font-semibold">
            <span>— PJ</span>
            <span class="text-galaxy-400">— PTS</span>
          </div>
        </div>
      </div>

      <!-- 3º lugar (derecha): bronce -->
      <div class="podio-card podio-3 group glass-panel rounded-lg overflow-hidden transform hover:scale-105 transition-transform duration-300">
        <div class="relative h-32 bg-gradient-to-br from-amber-600 to-amber-800 flex items-end justify-center pb-2">
          <span class="text-3xl font-display font-black text-amber-200 drop-shadow-lg">3</span>
        </div>
        <div class="p-4 space-y-2">
          <div class="h-6 bg-galaxy-900/40 rounded animate-pulse"></div>
          <div class="h-4 bg-galaxy-900/30 rounded w-2/3 mx-auto animate-pulse"></div>
          <div class="flex justify-around text-xs text-gray-400 pt-2 border-t border-galaxy-border/30">
            <span>— PJ</span>
            <span>— PTS</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-podio {
  padding: 2rem 0;
  background: radial-gradient(circle at 50% 0%, rgba(0, 229, 255, 0.05) 0%, transparent 70%);
}

  .podio-card {
    border: 1px solid var(--color-galaxy-border);
    backdrop-filter: blur(10px);
  }

  .podio-1 .podio-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center top, rgba(255, 215, 0, 0.1) 0%, transparent 70%);
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .podio-card {
      transition: none !important;
    }
  }
</style>

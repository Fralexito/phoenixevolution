---
// Pestañas del pilar (FX.pilares): bajo la cabecera, enlaza las secciones hermanas de la página actual.
// Ej.: en Liga se ve «Liga · Competiciones · Historial · Palmarés · Ranking». No aparece en Central ni en páginas de cuenta.
import { pilarDe, esDe } from '../data/site.js';
const base = import.meta.env.BASE_URL;
const { active } = Astro.props;
const p0 = pilarDe(active);
// Con grupos compactos (Competiciones), las pestañas son solo las páginas del GRUPO actual: el menú de arriba elige el grupo.
const grupo = p0?.bloques?.some((b) => b.compacto) ? p0.bloques.find((b) => b.items.some((n) => esDe(n, active))) : null;
const p = grupo ? { ...p0, label: `${p0.label} · ${grupo.titulo}`, bloques: [grupo], items: grupo.items } : p0;
---
{/* Mi club (destacado) tiene su propia navegación dentro de su ecosistema (manager.astro): aquí no se repite. */}
{p && !p0.destacado && p.items.length > 1 && (
  <nav class="pilar-tabs" aria-label={`Secciones de ${p.label}`}>
    <span class="pilar-tabs-tit"><i class={`fa-solid ${p.icon}`}></i> {p.label}</span>
    <div class="pilar-tabs-lista">
      {(p.bloques ?? [{ items: p.items }]).map((b, k) => (<Fragment>
        {k > 0 && <span class="pilar-sep" aria-hidden="true"></span>}
        {b.items.map((n) => (
          <a href={`${base}${n.path}`} data-solo-staff={n.staff} data-no-staff={n.noStaff} hidden={n.staff ? true : undefined} aria-current={esDe(n, active) ? 'page' : undefined}><i class={`fa-solid ${n.icon}`}></i>{n.label}</a>
        ))}
      </Fragment>))}
    </div>
  </nav>
)}

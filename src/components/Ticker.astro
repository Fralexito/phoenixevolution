---
import { TICKER } from '../data/site.js';
---
<div id="ticker" class="ticker-wrap pointer-events-auto bg-galaxy-900/95 backdrop-blur-md border-b border-galaxy-600/50 overflow-hidden relative h-11 flex items-stretch">
  <!-- Etiqueta: más angosta en celular para dejar espacio a las noticias -->
  <div class="shrink-0 bg-galaxy-600 text-white font-display font-bold px-2.5 sm:px-4 flex items-center z-10 shadow-[5px_0_15px_rgba(0,0,0,0.5)] uppercase tracking-wide sm:tracking-wider text-[11px] sm:text-sm whitespace-nowrap">
    <i class="fa-solid fa-bolt mr-1.5 sm:mr-2 animate-pulse text-galaxy-400"></i> ÚLTIMA HORA
  </div>
  <!-- Zona de lectura. El track lleva el contenido repetido (2 copias mínimo) para que el bucle no tenga huecos;
       features/ticker.js ajusta copias y velocidad (en píxeles por segundo) según el ancho de la pantalla. -->
  <div id="ticker-view" class="flex-1 min-w-0 overflow-hidden relative flex items-center">
    <div id="ticker-track" class="ticker-track font-sans text-xs sm:text-sm text-galaxy-50">
      <span class="ticker-group">{TICKER.map((t) => (<><span class="mx-6 sm:mx-10 text-galaxy-400">◆</span><span>{t}</span></>))}</span>
      <span class="ticker-group" aria-hidden="true">{TICKER.map((t) => (<><span class="mx-6 sm:mx-10 text-galaxy-400">◆</span><span>{t}</span></>))}</span>
    </div>
  </div>
</div>

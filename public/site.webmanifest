{
  "name": "Phoenix Evolution Series",
  "short_name": "Phoenix",
  "description": "La liga competitiva de PES 2021 y SP Football Life.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#050515",
  "theme_color": "#03010f",
  "lang": "es",
  "icons": [
    {
      "src": "icono-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icono-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "./stickers-recibir/",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "titulo",
      "text": "texto",
      "files": [
        {
          "name": "stickers",
          "accept": [
            "image/webp",
            "image/png",
            "image/gif",
            "video/webm",
            ".webp",
            ".png",
            ".gif",
            ".webm",
            ".wastickers",
            ".zip",
            "application/zip",
            "application/octet-stream"
          ]
        }
      ]
    }
  }
}
